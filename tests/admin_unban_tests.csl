test_admin_unban_modal_controls :: proc() {
    Test.run_admin_command("prepare_admin_list_test");
    Test.wait_frames(90);

    Test.click_button("hud/admin_button");
    Test.click_button("admin/unban");
    Test.wait_frames(10);
    Test.assert_var_bool("unban button opens the banned-user selector", "g_admin_unban_test_player.show_admin_unban", true);
    Test.assert_var_int("selector lists both active banned users", "g_admin_unban_test_player.admin_unban_visible_ban_count", 2);

    Test.click_button("admin_unban_close");
    Test.wait_frames(10);
    Test.assert_var_bool("close button dismisses the selector", "g_admin_unban_test_player.show_admin_unban", false);
}

test_admin_unban_selected_user :: proc() {
    Test.run_admin_command("prepare_admin_single_list_test");
    Test.wait_frames(90);

    Test.click_button("hud/admin_button");
    Test.click_button("admin/unban");
    Test.wait_frames(10);
    Test.click_button("admin_unban_user/ui-test-banned-user-b");
    Test.wait_frames(30);

    Test.assert_var_int("selected user is unbanned once", "g_admin_unban_test_player.admin_unban_action_count", 1);
    Test.assert_var_str("the requested row was selected", "g_admin_unban_test_player.admin_unban_last_user_id", "ui-test-banned-user-b");
    Test.assert_var_int("selected ban expiry is cleared", "g_admin_unban_test_player.admin_unban_last_expiry_after", 0);
    Test.assert_var_int("unbanned user leaves the active list", "g_admin_unban_test_player.admin_unban_visible_ban_count", 0);
    Test.assert_var_int("one global announcement was emitted", "g_admin_unban_test_player.admin_unban_announcement_count", 1);

    Test.run_admin_command("admin_list_test_replay_last");
    Test.wait_frames(30);
    Test.assert_var_int("replaying an expired unban does not mutate again", "g_admin_unban_test_player.admin_unban_action_count", 1);
    Test.assert_var_int("replaying an expired unban does not announce again", "g_admin_unban_test_player.admin_unban_announcement_count", 1);

}
