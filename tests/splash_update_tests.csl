test_splash_update_entry_and_shop :: proc() {
    Test.wait_seconds(1);
    Test.assert_entity_count("Nine Jump Shards", "Jump_Shard", 9);
    Test.assert_entity_count("Ten rescue animals", "Forest_Animal", 10);
    Test.assert_entity_count("Ten bears", "Forest_Bear", 10);
    Test.assert_component_float("Retired paid speed", "", "Player.agent.movement_speed", 300);
    Test.assert_balance("Pileo reset balance", "Coins", 1500000);
    Test.teleport({7, -3});
    Test.interact_with("Splash_Entry");
    Test.assert_component_bool("Entry unlocked", "", "Player.splash_unlocked", true);
    Test.assert_component_int("Entered Splash", "", "Player.adventure_world", 1);
    Test.assert_balance("Entry charged once", "Coins", 500000);
    Test.click_button("home");
    Test.wait_frames(5);
    Test.click_button("shop_button");
    Test.wait_frames(5);
    Test.assert_button_not_clickable("Medkit removed", "shop/medkit");
    Test.assert_button_not_clickable("Paid speed removed", "event:speed:open");
}

test_nuke_all_exact_reward :: proc() {
    Test.wait_seconds(1);
    Test.spawn_dummy_players(2);
    Test.wait_seconds(8);
    Test.assert_entity_count("Three players connected", "Player", 3);
    Test.assert_component_bool("Other player has no admin", "Editor_1000", "Player.is_admin_user", false);
    Test.assert_component_bool("Second player has no admin", "Editor_1001", "Player.is_admin_user", false);
    Test.assert_balance("Initial balance", "Coins", 1500000);
    Test.click_button("admin_button");
    Test.wait_frames(5);
    Test.click_button("nuke_all");
    Test.assert_balance("Exactly twenty per other player", "Coins", 1500040);
    Test.assert_component_bool("First player killed", "Editor_1000", "Player.is_dead", true);
    Test.assert_component_bool("Second player killed", "Editor_1001", "Player.is_dead", true);
    Test.assert_component_bool("Admin survives", "", "Player.is_dead", false);
}
