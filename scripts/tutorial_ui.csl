draw_tutorial :: proc(player: Player) {
    UIK.begin(UIK.modal(UIK.rect_window(), 15));

    shell := UIK.panel_modal(.BLACK);
    shell.gap = 0;
    UIK.panel_begin(shell);

    title_desc := UIK.title_area_desc("How to Play");
    title_desc.icon = get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/weapon_icons/weapon_icons_250x250/assaultrifle.png");
    exit_handle := UIK.title_area(title_desc);

    content := UIK.layout_column();
    content.width = UIK.flex(1);
    content.height = UIK.flex(1);
    content.padding = v4{12, 16, 12, 16};
    content.gap = 8;
    UIK.list_begin("tutorial_scroll", content);

    UIK.text("Movement", UIK.text_title());
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    UIK.text("Joystick (mobile) or WASD / arrow keys (PC)", UIK.text_body());

    UIK.spacer(UIK.pixels(1), UIK.pixels(10));
    UIK.text("Shooting", UIK.text_title());
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    UIK.text("Aim and tap the fire button to shoot", UIK.text_body());
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    UIK.text("Ammo count shown in the hotbar", UIK.text_body());

    UIK.spacer(UIK.pixels(1), UIK.pixels(10));
    UIK.text("Guns", UIK.text_title());
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    UIK.text("You start with an Assault Rifle", UIK.text_body());
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    UIK.text("Open Shop to unlock Akimbo or Blunderbuss", UIK.text_body());

    UIK.spacer(UIK.pixels(1), UIK.pixels(10));
    UIK.text("Ammo", UIK.text_title());
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    UIK.text("Buy 10 bullets for 10 coins in the Shop", UIK.text_body());

    UIK.spacer(UIK.pixels(1), UIK.pixels(10));
    UIK.text("Coins", UIK.text_title());
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    UIK.text("Defeat players to earn 10 coins each", UIK.text_body());
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    UIK.text("Spend coins on ammo, abilities, and guns", UIK.text_body());

    UIK.spacer(UIK.pixels(1), UIK.pixels(12));
    close_row := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(close_row);
    close_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_RED);
    close_desc.panel.width = UIK.flex(1);
    close_desc.panel.height = UIK.pixels(64);
    close_btn := UIK.button("tutorial/close", "Close", close_desc);
    UIK.panel_end();

    UIK.list_end();
    UIK.panel_end();
    UIK.end();

    if UIK.clicked(exit_handle) || UIK.clicked(close_btn) {
        player.show_tutorial = false;
    }
}
