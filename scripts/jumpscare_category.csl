draw_jumpscare_category :: proc(admin: Player) {
    // Compatibility entry point: jumpscares belong to the Troll Panel.
    if !admin.is_local_or_server() || !can_access_troll_panel(admin) { return; }
    admin.show_jumpscares = false;
    admin.show_troll_panel = true;
    draw_troll_panel(admin);
}
