respawn_player :: proc(player: Player) {
    player.survive_mode_killed_by_creature = false;
    player.survive_mode_death_reason = "";
    rng := rng_root_seed();
    idx := rng_range_int(ref rng, 0, 3);
    player.entity.set_local_position(player.adventure_world == 1 ? v2{100, -10} : (player.adventure_world == 2 ? v2{200, -13} : get_spawn_point(idx)));
    player.entity.mark_teleported();
    player.agent.velocity = {0, 0};
    player.agent.input_this_frame = {0, 0};
    player.weapon_target.health = player.weapon_target.max_health;
    player.is_dead = false;
    player.parry_ready = false;
    player.parry_owned = false;
    if player.adventure_world == 0 && !is_murder_mystery_active() {
        if !player_has_weapon(player, .ASSAULT_RIFLE) { grant_weapon_with_ammo(player, .ASSAULT_RIFLE, STARTING_BULLETS); }
        if !player_has_weapon(player, .SWORD) { give_weapon(.SWORD, player.default_inventory); }
    }
    player.damage_contributors.clear();
    player.last_damage_weapon = .NONE;
    player.out_of_bounds_respawn_active = false;
}

Death_Effect :: class : Effect_Base {
    death_reason: string;
    attacker_id: u64;
    lock_respawn_until_survive_mode_ends: bool;

    effect_start :: method() {
        player_specific.freeze_player = true;
        player_specific.disable_movement_inputs = true;
        player.(Player).death_started_at = get_time();
        publish_player_death(player.(Player), attacker_id);
        for killer: component_iterator(Player) {
            if killer.entity.id == attacker_id && killer != player { killer.mimicer_killed_ids.append(player.get_user_id()); record_mimicer_form(killer, player.(Player)); }
        }
        if death_reason == "" {
            death_reason = format_string("death/%/%", {player.get_user_id(), get_frame_number()});
        }
        player.add_name_invisibility_reason(death_reason);
        lock_respawn_until_survive_mode_ends = player.(Player).survive_mode_killed_by_creature || player.(Player).murder_permadead;
        player.(Player).survive_mode_death_reason = death_reason;
        player.animator.state_machine.set_trigger("death");
        player.(Player).is_dead = true;
    }

    effect_update :: method(dt: float) {
        time_left := 3.0 - get_elapsed_time();
        if lock_respawn_until_survive_mode_ends {
            if time_left <= 0 {
                return;
            }
        }

        if time_left <= 0 {
            remove_effect(false);
            return;
        }
    }

    effect_end :: method(interrupt: bool) {
        if death_reason != "" {
            player.remove_name_invisibility_reason(death_reason);
        }

        if interrupt {
            player.(Player).survive_mode_killed_by_creature = false;
            player.(Player).survive_mode_death_reason = "";
            return;
        }

        if lock_respawn_until_survive_mode_ends {
            return;
        }

        respawn_player(player.(Player));
        player.animator.state_machine.set_trigger("RESET");
    }
}
