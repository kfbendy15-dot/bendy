// Admin-only title commands. Titles are shown above the player's health bar.

set_my_title :: proc(player: Player, title: string = "") {
    if player == null || !can_access_admin_panel(player) {
        return;
    }

    title = player_title_for(player, title);
    player.user_tag = title;
    Save.set_string(player, PLAYER_TITLE_SAVE_KEY, title);
    unlock_title_badges(player, title);
    player.play_reward_feedback(title.count > 0 ? format_string("Title: %", {title}) : "Title cleared");
}

set_player_title :: proc(player: Player, target: Player, title: string = "") {
    if player == null || target == null || !can_access_admin_panel(player) {
        return;
    }

    title = player_title_for(target, title);
    target.user_tag = title;
    Save.set_string(target, PLAYER_TITLE_SAVE_KEY, title);
    unlock_title_badges(target, title);
    target.play_reward_feedback(title.count > 0 ? format_string("Title: %", {title}) : "Title cleared");
    player.play_reward_feedback(format_string("Updated %", {target.get_username()}));
}
