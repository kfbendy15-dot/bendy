Nether_Fireball :: class : Component {
    owner_user_id: string;
    velocity: v2;
    elapsed: float;
    ao_start :: method() {
        sprite := entity.add_component(Sprite_Renderer);
        texture := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/projectiles/cannonball.png");
        sprite.set_texture(texture); sprite.color = {1, 0.35, 0.05, 1}; sprite.layer = 0;
        entity.set_local_scale({1.3, 1.3});
    }
    ao_update :: method(dt: float) {
        p := find_online_player_by_user_id(owner_user_id);
        elapsed += dt;
        if !#alive(p) || p.adventure_world != 3 || p.nether_safe || p.is_dead || elapsed > 6 { entity.destroy(); return; }
        old := entity.world_position;
        entity.set_world_position(old + velocity * dt);
        segment := entity.world_position - old;
        fraction := clamp(dot(p.entity.world_position - old, segment) / max(length_squared(segment), 0.001), 0.0, 1.0);
        if length(old + segment * fraction - p.entity.world_position) < 0.75 {
            weapon_target_apply_damage(p.weapon_target, 25, entity.id); adventure_sound(entity); entity.destroy();
        }
    }
}
