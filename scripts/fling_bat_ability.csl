Fling_Bat_Ability :: class : Ability_Base {
    on_init :: method() {
        name = "Fling Bat"; icon = get_asset(Texture_Asset, "mrlovebraids/bat.png");
    }
    can_use :: method() -> bool { return player.(Player).equipped_weapon_type == .FLING_BAT; }
    on_update :: method(params: ref Ability_Update_Params) {
        if !params.clicked || !params.can_use { return; }
        p := player.(Player); current_cooldown = 1.1;
        dir := p.last_aim_direction;
        if length(p.input_this_frame) > 0.1 { dir = p.input_this_frame; }
        if length(dir) < 0.1 { dir = v2{p.entity.local_scale.x >= 0 ? 1.0 : -1.0, 0}; }
        dir = normalize(dir);
        p.animator.state_machine.set_trigger("melee_AL");
        nearby: [..]Player;
        Scene.get_all_components_in_range(p.entity.world_position, 2.7, ref nearby);
        for target: nearby {
            if target == p || target.is_dead || !#alive(target.weapon_target) || target.adventure_world != p.adventure_world || is_player_invisible_for_targeting(target) { continue; }
            offset := target.entity.world_position - p.entity.world_position;
            if length(offset) > 0.1 && dot(normalize(offset), dir) < -0.15 { continue; }
            weapon_target_apply_damage(target.weapon_target, 10, p.entity.id, .FLING_BAT);
            if target.weapon_target.health <= 0 { continue; }
            motion := new(Fling_Motion_Effect); motion.direction = length(offset) > 0.1 ? normalize(offset) : dir;
            motion.speed = 60; target.entity.set_active_effect(motion);
        }
        spawn_bat_swing(p);
        mrlove_item_sound(p.entity, "reusable_weapons/sounds/reusable-weapons/katana_slash.wav");
        Tutorial.report_ability_used(this);
    }
}
mrlove_item_sound :: proc(e: Entity, path: string) {
    desc := SFX.default_sfx_desc(); desc.entity_to_follow = e.id; desc.volume = 0.7; desc.speed_perturb = 0.08;
    SFX.play(get_asset(SFX_Asset, path), desc);
}
spawn_bat_swing :: proc(p: Player) {
    e := Scene.create_entity(); e.set_parent(p.entity, false); e.set_local_position({0.65, 0.65});
    texture := get_asset(Texture_Asset, "mrlovebraids/bat.png");
    s := e.add_component(Sprite_Renderer); s.set_texture(texture); s.layer = 1;
    scale := 1.5 / max(texture.get_world_size().y, 0.01); e.set_local_scale({scale, scale});
    e.add_component(Bat_Swing_Visual); e.queue_for_destruction(0.25);
}
