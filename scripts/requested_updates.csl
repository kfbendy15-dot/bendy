g_event_no_fighting: bool;
allowed_player_title :: proc(title: string) -> string {
    if title == "Hunter" { return "Hunter"; }
    if title == "Paperclip" || title == "PAPERCLIP" || title == "paperclip" { return "Paperclip"; }
    if title == "Admin" { return "Admin"; }
    return "";
}
is_combat_ability :: proc(ability: Ability_Base) -> bool {
    return ability.#type == Continuous_Fire_Ability || ability.#type == Single_Shot_Ability || ability.#type == Spread_Shot_Ability || ability.#type == Lobbed_Shot_Ability || ability.#type == Beam_Ability || ability.#type == Special_Ability || ability.#type == Fling_Bat_Ability || ability.#type == Hair_Trap_Ability || ability.#type == Lasernick_Grappler_Ability || ability.#type == Forest_Sword_Ability || ability.#type == Forest_Crossbow_Ability || ability.#type == Parry_Ability || ability.#type == Abstraction_Ability || ability.#type == Distortion_Ability || ability.#type == Birthday_Cake_Trap_Ability;
}
player_title_for :: proc(p: Player, title: string) -> string {
    title = allowed_player_title(title);
    if (title == "Admin" || title == "Paperclip") && !is_protected_admin(p) { return ""; }
    return title;
}
admin_auto_aim :: proc(p: Player, fallback: v2) -> v2 { return fallback; }
