nether_test_enter :: proc(p: Player) { adventure_travel(p, 3); } @chat_command @owner_or_editor
nether_test_survive :: proc(p: Player) { if p.adventure_world == 3 { p.nether_elapsed = 34.9; } } @chat_command @owner_or_editor
nether_test_hunter :: proc(p: Player) { p.rescue_mask = 1023; adventure_travel(p, 2); } @chat_command @owner_or_editor
