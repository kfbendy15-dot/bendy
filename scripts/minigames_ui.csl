draw_minigames :: proc(player: Player) {
    if player == null || !can_access_admin_panel(player) { if player != null { player.show_minigames = false; } return; }
    UIK.begin(UIK.modal(UIK.rect_window_large(), 25)); shell := UIK.panel_modal(.BLACK); UIK.panel_begin(shell);
    title_desc := UIK.title_area_desc("Minigames"); exit_handle := UIK.title_area(title_desc);
    content := UIK.layout_column(); content.width = UIK.flex(1); content.height = UIK.flex(1); content.padding = v4{12,16,12,16}; content.gap = 8; UIK.list_begin("minigames_scroll", content);
    UIK.text("Choose a minigame", UIK.text_title());
    mm_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_RED); mm_desc.panel.width = UIK.flex(1); mm_desc.panel.height = UIK.pixels(86);
    mm_handle := UIK.button("minigames/murder_mystery", "Start Murder Mystery", mm_desc);
    UIK.text("One murderer, one Detective, and Innocents. The murderer gets one knife shot; the Detective gets one bullet and fingerprints.", UIK.text_body());
    UIK.spacer(UIK.pixels(1), UIK.pixels(10)); UIK.text("Murder Mystery roles", UIK.text_title());
    for target: component_iterator(Player) { row := UIK.layout_row(UIK.flex(1), UIK.fit(), 4); UIK.panel_begin(row); UIK.text(format_string("%: %", {target.get_username(), murder_role_name(target.murder_role)}), UIK.text_body()); for role: 0..3 { d := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREY); d.panel.width = UIK.pixels(92); d.panel.height = UIK.pixels(42); b := UIK.button(format_string("minigames/role/%/%", {target.get_user_id(), role}), role == 0 ? "Murderer" : role == 1 ? "Detective" : role == 2 ? "Innocent" : "Suspect", d); if UIK.clicked(b) { set_murder_role(target, role == 0 ? .KILLER : role == 1 ? .DETECTIVE : role == 2 ? .INNOCENT : .SUSPECT); } } UIK.panel_end(); }
    close_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_RED); close_desc.panel.width = UIK.flex(1); close_desc.panel.height = UIK.pixels(60); close_handle := UIK.button("minigames/close", "Close", close_desc); UIK.list_end(); UIK.panel_end(); UIK.end();
    if UIK.clicked(mm_handle) { start_murder_mystery(player); player.show_minigames = false; } if UIK.clicked(exit_handle) || UIK.clicked(close_handle) { player.show_minigames = false; }
}

