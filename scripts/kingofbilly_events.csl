g_event_kingofbilly: bool;
g_event_peace_race: bool;
g_event_double_damage: bool;
g_race_places: s64;
g_race_starts_at: float;

start_requested_event :: proc(p: Player, kind: s64) {
    if !can_access_admin_panel(p) { return; }
    stop_active_event();
    g_event_ends_at = get_time() + 600;
    if kind == 1 {
        g_event_kingofbilly = true;
        e := Scene.create_entity(); e.set_name("Kingofbilly at Spawn");
        e.add_component(Event_Spawn_Landmark, on_before_start=proc(l: Event_Spawn_Landmark) { l.kind = 2; });
    }
    if kind == 2 {
        g_event_peace_race = true; g_event_no_fighting = true; g_race_places = 0;
        g_race_starts_at = get_time() + 5;
        g_event_ends_at = get_time() + 180;
        for racer: component_iterator(Player) {
            join_peace_race(racer);
            racer.active_ability = null;
        }
        for i: 0..4 {
            e := Scene.create_entity(); e.set_world_position(race_waypoint(i));
            e.add_component(Race_Checkpoint, on_before_start=proc(c: Race_Checkpoint) { c.index = i; });
        }
    }
    if kind == 3 { g_event_double_coins = true; }
    if kind == 4 { g_event_double_damage = true; }
    p.show_event_panel = false; adventure_sound(p.entity);
}
race_waypoint :: proc(index: s64) -> v2 {
    offsets: [5]v2 = {{8, 0}, {8, 8}, {-8, 8}, {-8, 0}, {0, 0}};
    return v2{300, 0} + offsets[clamp(index, 0, 4)];
}
update_requested_events :: proc() {
    if g_event_peace_race {
        for p: component_iterator(Player) { if !p.race_joined { join_peace_race(p); } }
    }
    if g_event_ends_at > 0 && get_time() >= g_event_ends_at { stop_active_event(); }
    if !g_event_peace_race || get_time() < g_race_starts_at { return; }
    for p: component_iterator(Player) {
        if p.is_dead || p.race_finished { continue; }
        if length(p.entity.world_position - race_waypoint(p.race_checkpoint)) < 1.8 {
            p.race_checkpoint += 1; adventure_sound(p.entity);
            if p.race_checkpoint == 5 {
                p.race_finished = true; g_race_places += 1;
                prize := g_race_places == 1 ? 1000 : g_race_places == 2 ? 500 : g_race_places == 3 ? 250 : 0;
                if prize > 0 { award_coins(p, prize); }
                p.play_reward_feedback(`Finished #{g_race_places}`);
            }
        }
    }
}
gun_uses_recoil :: proc(wt: Weapon_Type) -> bool {
    if wt == .NONE { return false; }
    c := get_weapon_config(wt);
    return c.ammo_per_shot > 0 && c.fire_mode != .SPECIAL && c.fire_mode != .LOBBED;
}
update_requested_player :: proc(p: Player, dt: float) {
    wild := p.equipped_weapon_type == .WILDCAT && !p.is_dead;
    if wild && !p.wildcat_speed_active { p.wildcat_base_speed = p.agent.movement_speed; p.agent.movement_speed *= 2; p.wildcat_speed_active = true; }
    if !wild && p.wildcat_speed_active { p.agent.movement_speed = p.wildcat_base_speed; p.wildcat_speed_active = false; }
    p.gun_recoil = max(0.0, p.gun_recoil - dt * 0.2);
    if p.input_this_frame.y < -0.2 { p.gun_recoil = max(0.0, p.gun_recoil - dt * 4); }
    near_wall := false;
    if p.is_mimicer && !p.is_dead {
        for wall: component_iterator(Box_Collider) {
            if wall.is_trigger || wall.entity == p.entity { continue; }
            low, high := wall.get_min_and_max_world(); pos := p.entity.world_position;
            closest := v2{clamp(pos.x, low.x, high.x), clamp(pos.y, low.y, high.y)};
            if length(pos - closest) < 1.25 { near_wall = true; }
        }
        for mesh: component_iterator(Navmesh) {
            for i: 0..7 {
                angle := i.(float) * PI / 4;
                hit, ok := mesh.try_raycast(p.entity.world_position, v2{cos(angle), sin(angle)} * 1.3);
                if ok && length(hit - p.entity.world_position) < 1.25 { near_wall = true; }
            }
        }
    }
    if near_wall && !p.mimicer_wall_hidden { p.add_invisibility_reason("mimicer_wall"); p.mimicer_wall_hidden = true; }
    if !near_wall && p.mimicer_wall_hidden { p.remove_invisibility_reason("mimicer_wall"); p.mimicer_wall_hidden = false; }
    if g_event_peace_race && (get_time() < g_race_starts_at || p.race_finished) { p.override_movement_input_for_next_step({0, 0}); }
}
draw_requested_melee :: proc(p: Player) -> [..]Event_Shop_Card {
    cards: [..]Event_Shop_Card;
    offers: [3]Event_Shop_Offer = {{.BACKSTAB_KNIFE, 200, "Knife", 0}, {.FLASHBANG, 80, "Flashbang", 0}, {.BEAR_TRAP, 150, "Bear Trap", 0}};
    for o: offers {
        h := draw_shop_card(`shop/melee/{o.weapon.(int)}`, o.label, shop_price(p, o.price), get_asset(Texture_Asset, get_weapon_config(o.weapon).weapon_icon_path), {0.6, 0.7, 0.8, 1}, player_has_weapon(p, o.weapon));
        cards.append({o, h});
    }
    return cards;
}

join_peace_race :: proc(p: Player) {
    p.race_previous_position = p.entity.world_position; p.race_previous_world = p.adventure_world;
    p.race_joined = true; p.race_checkpoint = 0; p.race_finished = false; p.adventure_world = 0;
    p.entity.set_world_position({300, 0}); p.entity.mark_teleported(); p.agent.velocity = {0, 0};
    p.out_of_bounds_respawn_active = false; p.active_ability = null;
}
