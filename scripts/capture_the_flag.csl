CAPTURE_THE_FLAG_DURATION :: 300.0;
CAPTURE_THE_FLAG_FLAG_RADIUS :: 1.6;
CAPTURE_THE_FLAG_BASE_RADIUS :: 2.4;
CAPTURE_THE_FLAG_TEAM_COUNT :: 7;

Capture_The_Flag_Flag :: class : Interactable {
    team: s64;
    home_position: v2;
    carried_by: Player;
    sprite: Sprite_Renderer;
    initialized_team: s64;

    ao_start :: method() {
        this.set_listener(this);
        this.required_hold_time = 0.35;
        sprite = entity.add_component(Sprite_Renderer);
        sprite.set_texture(core_globals.white_sprite);
        sprite.layer = 2;
        entity.set_local_scale({1.1, 1.8});
        entity.set_local_enabled(false);
        initialized_team = -1;
    }

    ao_update :: method(dt: float) {
        if initialized_team == team return;
        initialized_team = team;
        this.set_text(format_string("Capture {0} flag", {capture_the_flag_team_name(team)}));
        sprite.color = capture_the_flag_team_color(team);
    }

    can_use :: method(player: Player) -> bool {
        if player == null || player.is_dead return false;
        if player.capture_the_flag_team < 0 || player.capture_the_flag_team == team return false;
        if carried_by != null return false;
        return is_capture_the_flag_active();
    }

    on_interact :: method(player: Player) {
        if !can_use(player) return;
        carried_by = player;
        player.capture_the_flag_carrying = true;
        player.play_reward_feedback(format_string("{0} flag captured", {capture_the_flag_team_name(team)}));
    }
}

capture_the_flag_team_color :: proc(team: s64) -> v4 {
    switch team {
        case 0: return {0.95, 0.08, 0.08, 1};
        case 1: return {1.00, 0.42, 0.05, 1};
        case 2: return {1.00, 0.85, 0.05, 1};
        case 3: return {0.12, 0.85, 0.20, 1};
        case 4: return {0.08, 0.30, 1.00, 1};
        case 5: return {0.60, 0.18, 0.90, 1};
        default: return {1.00, 0.25, 0.70, 1};
    }
}

capture_the_flag_team_name :: proc(team: s64) -> string {
    switch team {
        case 0: return "Red";
        case 1: return "Orange";
        case 2: return "Yellow";
        case 3: return "Green";
        case 4: return "Blue";
        case 5: return "Purple";
        default: return "Pink";
    }
}

capture_the_flag_base_position :: proc(team: s64) -> v2 {
    angle := (team.(float) / CAPTURE_THE_FLAG_TEAM_COUNT.(float)) * PI * 2.0;
    return v2{cos(angle) * 22.0, sin(angle) * 16.0};
}

capture_the_flag_distance :: proc(a: v2, b: v2) -> float {
    dx := a.x - b.x;
    dy := a.y - b.y;
    return sqrt(dx * dx + dy * dy);
}

Capture_The_Flag_Manager :: class : Component {
    time_left: float;
    scores: [7]s64;

    ao_start :: method() {
        time_left = CAPTURE_THE_FLAG_DURATION;
        for i: 0..CAPTURE_THE_FLAG_TEAM_COUNT - 1 {
            scores[i] = 0;
            base := capture_the_flag_base_position(i);
            e := Scene.create_entity();
            e.set_local_position(base);
            flag := e.add_component(Capture_The_Flag_Flag);
            flag.team = i;
            flag.home_position = base;
            e.set_local_enabled(true);
        }

        index: s64 = 0;
        for player: component_iterator(Player) {
            if player.capture_the_flag_team < 0 {
                player.capture_the_flag_team = index % CAPTURE_THE_FLAG_TEAM_COUNT;
            }
            player.capture_the_flag_carrying = false;
            spawn := capture_the_flag_base_position(player.capture_the_flag_team);
            player.entity.set_local_position(spawn);
            player.entity.mark_teleported();
            player.play_reward_feedback(capture_the_flag_team_name(player.capture_the_flag_team));
            index += 1;
        }
        Chat.server_send_message("Capture the flag started: 5 minutes, seven teams.");
    }

    finish :: method(message: string) {
        winner: s64 = 0;
        for i: 1..CAPTURE_THE_FLAG_TEAM_COUNT - 1 {
            if scores[i] > scores[winner] { winner = i; }
        }
        Chat.server_send_message(format_string("Capture the flag ended. {0} wins with {1} captures.", {capture_the_flag_team_name(winner), scores[winner]}));
        for flag: component_iterator(Capture_The_Flag_Flag) {
            flag.entity.set_local_enabled(false);
        }
        entity.destroy();
    }

    ao_update :: method(dt: float) {
        time_left -= dt;
        if time_left <= 0 {
            finish("Time");
            return;
        }

        for player: component_iterator(Player) {
            if player.capture_the_flag_team < 0 || player.is_dead { continue; }
            pos := player.entity.world_position;
            if player.capture_the_flag_carrying {
                own_base := capture_the_flag_base_position(player.capture_the_flag_team);
                if capture_the_flag_distance(pos, own_base) <= CAPTURE_THE_FLAG_BASE_RADIUS {
                    scores[player.capture_the_flag_team] += 1;
                    player.capture_the_flag_carrying = false;
                    player.play_reward_feedback(format_string("Capture! {0}", {scores[player.capture_the_flag_team]}));
                    for flag: component_iterator(Capture_The_Flag_Flag) {
                        if flag.team == player.capture_the_flag_team {
                            flag.carried_by = null;
                            flag.entity.set_local_position(flag.home_position);
                        }
                    }
                }
                continue;
            }

            // Enemy flags are claimed through their Interactable prompt.
        }

        for flag: component_iterator(Capture_The_Flag_Flag) {
            if flag.carried_by != null && #alive(flag.carried_by.entity) && !flag.carried_by.is_dead {
                flag.entity.set_local_position(flag.carried_by.entity.world_position);
            } else if flag.carried_by != null {
                flag.carried_by.capture_the_flag_carrying = false;
                flag.carried_by = null;
                flag.entity.set_local_position(flag.home_position);
            }
        }
    }

    ao_end :: method() {
        flags: [..]Capture_The_Flag_Flag;
        for flag: component_iterator(Capture_The_Flag_Flag) { flags.append(flag); }
        for flag: flags {
            if #alive(flag.entity) {
                flag.entity.set_local_enabled(false);
                flag.entity.destroy();
            }
        }
        for player: component_iterator(Player) {
            player.capture_the_flag_team = -1;
            player.capture_the_flag_carrying = false;
        }
    }
}

is_capture_the_flag_active :: proc() -> bool {
    for manager: component_iterator(Capture_The_Flag_Manager) {
        return #alive(manager.entity);
    }
    return false;
}

start :: proc(player: Player, minigame: string = "") {
    if player == null || !can_access_admin_panel(player) {
        if player != null {
            player.play_reward_feedback("Epik Panel admin access required");
        }
        return;
    }
    if minigame != "Minigame:Capture the flag" && minigame != "Capture the flag" {
        Chat.server_send_message("Use /start Minigame:Capture the flag", player);
        return;
    }
    if is_capture_the_flag_active() {
        player.play_reward_feedback("Capture the flag already running");
        return;
    }
    e := Scene.create_entity();
    e.set_name("Capture_The_Flag");
    e.add_component(Capture_The_Flag_Manager);
} @chat_command @any

start_capture_the_flag_from_chat :: proc(player: Player, message: string) {
    if message == "/start Minigame:Capture the flag" {
        start(player, "Minigame:Capture the flag");
    }
}
