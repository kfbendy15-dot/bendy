Coin_Reward_Popup :: class : Component {
    owner_user_id: string;
    amount: s64;
    age: float;
    ao_update :: method(dt: float) {
        age += dt;
        if age >= 1.1 { entity.destroy(); return; }
        entity.add_local_position({0, dt * 1.3});
    }
    ao_draw :: method(dt: float) {
        viewer, found := Game.get_local_player();
        if !found || viewer == null || viewer.get_user_id() != owner_user_id { return; }
        UI.push_z(entity.world_position.y); defer UI.pop_z();
        ts := UI.default_text_settings(); ts.size = 0.32; ts.color = {1, 0.85, 0.2, 1 - age / 1.1};
        UI.text(Rect{entity.world_position, entity.world_position}.grow(0.5), ts, `+{amount}`);
    }
}
