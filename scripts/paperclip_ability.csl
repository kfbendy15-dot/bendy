Paperclip_Ability :: class : Ability_Base {
    on_init :: method() {
        name = "Paperclip";
        icon = get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_1/shield_iron.png");
    }

    can_use :: method() -> bool {
        return player.(Player).has_paperclip && !player.(Player).paperclip_active;
    }

    on_update :: method(params: ref Ability_Update_Params) {
        if params.clicked && params.can_use {
            player.(Player).paperclip_active = true;
            current_cooldown = 5.0;
        }
    }
}
