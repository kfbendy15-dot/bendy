PAPERCLIP_UNLOCKED_KEY :: "paperclip_unlocked";

grant_code_weapon :: proc(player: Player, wt: Weapon_Type) {
    grant_weapon_with_ammo(player, wt, 999);
}

redeem_player_code :: proc(player: Player, raw_code: string) {
    if player == null {
        return;
    }

    code := to_lower(raw_code);

    if code == "paperclipsarecool" {
        if Save.get_int(player, CODE_PAPERCLIPS_ARE_COOL_KEY, 0) != 0 {
            player.code_status = "Code already used";
            return;
        }
        Save.set_int(player, CODE_PAPERCLIPS_ARE_COOL_KEY, 1);
        award_coins(player, 50000);
        grant_code_weapon(player, .EXPLOSIVE_SHOTGUN);
        player.code_status = "+50k Coins and Explosive Shotgun";
        return;
    }

    if code == "#dinosquad" || code == "dinosquad" {
        if Save.get_int(player, CODE_DINO_SQUAD_KEY, 0) != 0 {
            player.code_status = "Code already used";
            return;
        }
        Save.set_int(player, CODE_DINO_SQUAD_KEY, 1);
        award_coins(player, 20000);
        player.has_dash = true;
        player.has_medkit = true;
        player.has_invisible = true;
        player.powerup_invisible_active = true;
        player.entity.add_passive_effect(new(Invisible_Effect));
        grant_code_weapon(player, .MEGA_BLADE);
        player.code_status = "+20k Coins, Dash, Medkit, Invisibility, Gun Cutter";
        return;
    }

    if code == "pileo'sevents" || code == "pileosevents" || code == "pileo’sevents" {
        if Save.get_int(player, CODE_PILEO_EVENTS_KEY, 0) != 0 {
            player.code_status = "Code already used";
            return;
        }
        Save.set_int(player, CODE_PILEO_EVENTS_KEY, 1);
        award_coins(player, 10000);
        grant_code_weapon(player, .DISTORTION);
        grant_code_weapon(player, .FLAMETHROWER);
        grant_code_weapon(player, .KILLER_FISH);
        grant_code_weapon(player, .BATTLE_AXE);
        grant_code_weapon(player, .SUN_SHOOTER_TSUNAMI);
        grant_code_weapon(player, .ENERGY_RIFLE);
        if !player.sun_armor_active {
            player.sun_armor_active = true;
            Save.set_int(player, SUN_ARMOR_KEY, 1);
            if player.armor_bonus_health < SUN_ARMOR_BONUS_HP {
                apply_armor_bonus(player, SUN_ARMOR_BONUS_HP - player.armor_bonus_health);
            }
            refresh_armor_visual(player);
        }
        player.code_status = "+10k Coins and event pack";
        return;
    }

    player.code_status = "Invalid code";
}

on_codes_ui_event :: proc(event: UIDoc_Event, userdata: Object) {
    player := userdata.(Player);
    if !#alive(player) {
        return;
    }

    if event.handler == "event:codes:close" {
        player.show_codes_panel = false;
        return;
    }

    if event.handler == "event:codes:redeem" {
        document := get_asset(UIDoc_Asset, "UI/codes.uidoc");
        if document != null {
            player.code_input = UI.uidoc_text_value(document, "code-entry", player.code_input);
        }
        redeem_player_code(player, player.code_input);
    }
}

draw_codes_panel :: proc(player: Player) {
    if !player.is_local_or_server() {
        return;
    }
    if player == null || !player.show_codes_panel {
        return;
    }

    document := get_asset(UIDoc_Asset, "UI/codes.uidoc");
    if document == null {
        return;
    }

    UI.uidoc_clear_bindings();
    UI.uidoc_bind_text("codeInput", player.code_input);
    UI.uidoc_bind_text("status", player.code_status);
    UI.uidoc(document, false, player, on_codes_ui_event);
    player.code_input = UI.uidoc_text_value(document, "code-entry", player.code_input);
}
