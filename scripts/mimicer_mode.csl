MIMICER_ATTACK_RANGE   :: 2.3;
MIMICER_DASH_SPEED     :: 24.0;
MIMICER_DASH_DURATION   :: 0.34;
MIMICER_SHAPESHIFT_TIME :: 60.0;
MIMICER_FREEZE_TIME     :: 5.0;

play_mimicer_local_sfx :: proc(player: Player, asset_path: string, volume: float) {
    if player == null || !player.is_local() {
        return;
    }

    sfx := get_asset(SFX_Asset, asset_path);
    desc := SFX.default_sfx_desc();
    desc.entity_to_follow = player.entity.id;
    desc.volume = volume;
    desc.speed_perturb = 0.08;
    SFX.play(sfx, desc);
}

grant_mimicer_mode :: proc(player: Player) {
    if player == null {
        return;
    }

    player.is_mimicer = true;
    player.show_mimicer_selector = false;
    Save.set_int(player, "ui_test_is_mimicer", 1);
    player.play_reward_feedback("Become Mimicer");
    play_mimicer_local_sfx(player, "reusable_weapons/sounds/reusable-weapons/equip_gun.wav", 0.6);
}

save_mimicer_original_look :: proc(player: Player) {
    if player == null || player.mimicer_saved_look_valid {
        return;
    }

    player.mimicer_saved_look_valid = true;
    player.mimicer_saved_name_override = player.get_name_override();
    player.mimicer_saved_do_name_color_override = player.do_name_color_override;
    player.mimicer_saved_name_color_override = player.name_color_override;
    player.mimicer_saved_anim_tint = player.animator.get_tint();
    player.mimicer_saved_skins = player.animator.get_skins();
}

restore_mimicer_form :: proc(player: Player) {
    if player == null || !player.mimicer_saved_look_valid {
        player.mimicer_form_target_user_id = "";
        player.mimicer_form_expires_at = 0;
        return;
    }

    player.animator.disable_all_skins();
    for skin: player.mimicer_saved_skins {
        if skin != "" {
            player.animator.enable_skin(skin);
        }
    }
    player.animator.refresh_skins();
    player.animator.set_tint(player.mimicer_saved_anim_tint);
    player.set_name_override(player.mimicer_saved_name_override);
    player.do_name_color_override = player.mimicer_saved_do_name_color_override;
    player.name_color_override = player.mimicer_saved_name_color_override;

    player.mimicer_saved_look_valid = false;
    player.mimicer_form_target_user_id = "";
    player.mimicer_form_expires_at = 0;
}

apply_mimicer_form :: proc(player: Player, target: Player) {
    if player == null || target == null {
        return;
    }

    save_mimicer_original_look(player);

    player.animator.disable_all_skins();
    target_skins := target.animator.get_skins();
    for skin: target_skins {
        if skin != "" {
            player.animator.enable_skin(skin);
        }
    }
    player.animator.refresh_skins();
    player.animator.set_tint(target.animator.get_tint());

    target_name := target.get_name_override();
    if target_name == "" {
        target_name = target.get_username();
    }
    player.set_name_override(target_name);
    player.do_name_color_override = target.do_name_color_override;
    player.name_color_override = target.name_color_override;
    player.mimicer_form_target_user_id = target.get_user_id();
    player.mimicer_form_expires_at = get_time() + MIMICER_SHAPESHIFT_TIME;
    player.show_mimicer_selector = false;
    player.play_reward_feedback(format_string("Mimic: %", {target.get_username()}));
    play_mimicer_local_sfx(player, "reusable_weapons/sounds/reusable-weapons/equip_gun.wav", 0.55);
}

Mimicer_Freeze_Effect :: class : Effect_Base {
    freeze_reason: string;

    effect_start :: method() {
        player_specific.freeze_player = true;
        player_specific.disable_movement_inputs = true;
        player.add_freeze_reason(freeze_reason);
        player.add_disable_movement_input_reason(freeze_reason);
        set_duration(MIMICER_FREEZE_TIME);
    }

    effect_end :: method(interrupt: bool) {
        player.remove_freeze_reason(freeze_reason);
        player.remove_disable_movement_input_reason(freeze_reason);
    }
}

Mimicer_Attack_Ability :: class : Ability_Base {
    on_init :: method() {
        name = "Attack";
        icon = get_asset(Texture_Asset, "$AO/new/Player Stat Window/attack_stat_icon.png");
        is_aimed_ability = true;
    }

    can_use :: method() -> bool {
        return player.(Player).is_mimicer;
    }

    on_update :: method(params: ref Ability_Update_Params) {
        if params.just_pressed || params.clicked {
            Save.set_int(player.(Player), "ui_test_mimicer_attack_pressed", 1);
        }
        activation := Ability_Utilities.full_update_aimed_ability(player, ref params);
        if !activation.activate {
            return;
        }

        current_cooldown = 0.45;
        p := player.(Player);
        Save.set_int(p, "ui_test_mimicer_attack_used", 1);
        dir := activation.direction;
        if length(dir) < 0.1 {
            dir = v2{1, 0};
        }
        if dir.x != 0 {
            p.set_facing_right(dir.x > 0);
        }

        strike_center := v2{
            p.entity.world_position.x + dir.x * 2.0,
            p.entity.world_position.y + dir.y * 2.0,
        };

        for other: component_iterator(Player) {
            if other.entity.id == p.entity.id || other.is_dead {
                continue;
            }

            dx := other.entity.world_position.x - strike_center.x;
            dy := other.entity.world_position.y - strike_center.y;
            if sqrt(dx * dx + dy * dy) <= MIMICER_ATTACK_RANGE {
                if other.weapon_target != null {
                    weapon_target_apply_damage(other.weapon_target, other.weapon_target.health + 1000.0, p.entity.id);
                }
            }
        }

        play_mimicer_local_sfx(p, "reusable_weapons/sounds/reusable-weapons/katana_slash.wav", 0.5);
    }
}

Mimicer_Dash_Effect :: class : Effect_Base {
    direction: v2;
    original_friction: float;
    already_frozen_user_ids: [..]string;

    effect_start :: method() {
        player_specific.disable_movement_inputs = true;
        original_friction = player.agent.friction;
        player.agent.friction = 0;
        set_duration(MIMICER_DASH_DURATION);
    }

    effect_update :: method(dt: float) {
        player.agent.velocity = direction * MIMICER_DASH_SPEED;

        for other: component_iterator(Player) {
            if other.entity.id == player.entity.id || other.is_dead {
                continue;
            }
            if is_player_invisible_for_targeting(other) {
                continue;
            }

            already_hit := false;
            for user_id: already_frozen_user_ids {
                if user_id == other.get_user_id() {
                    already_hit = true;
                    break;
                }
            }
            if already_hit {
                continue;
            }

            dx := other.entity.world_position.x - player.entity.world_position.x;
            dy := other.entity.world_position.y - player.entity.world_position.y;
            if sqrt(dx * dx + dy * dy) > 2.0 {
                continue;
            }

            already_frozen_user_ids.append(other.get_user_id());
            freeze := new(Mimicer_Freeze_Effect);
            freeze.freeze_reason = format_string("mimicer_dash/%/%", {player.get_user_id(), get_frame_number()});
            other.entity.add_passive_effect(freeze);
        }
    }

    effect_end :: method(interrupt: bool) {
        player.agent.friction = original_friction;
    }
}

Mimicer_Dash_Ability :: class : Ability_Base {
    on_init :: method() {
        name = "Dash";
        icon = get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_1/timer_icon.png");
        is_aimed_ability = true;
    }

    can_use :: method() -> bool {
        return player.(Player).is_mimicer;
    }

    on_update :: method(params: ref Ability_Update_Params) {
        if params.just_pressed || params.clicked {
            Save.set_int(player.(Player), "ui_test_mimicer_dash_pressed", 1);
        }
        activation := Ability_Utilities.full_update_aimed_ability(player, ref params);
        if !activation.activate {
            return;
        }

        current_cooldown = 4.0;
        p := player.(Player);
        Save.set_int(p, "ui_test_mimicer_dash_used", 1);
        dir := activation.direction;
        if length(dir) < 0.1 {
            dir = v2{1, 0};
            if p.entity.world_position.x > 0 {
                dir = v2{-1, 0};
            }
        }
        if dir.x != 0 {
            p.set_facing_right(dir.x > 0);
        }

        effect := new(Mimicer_Dash_Effect);
        effect.direction = normalize(dir);
        p.entity.set_active_effect(effect);
        play_mimicer_local_sfx(p, "reusable_weapons/sounds/reusable-weapons/equip_gun.wav", 0.6);
    }
}

Mimicer_Shapeshift_Ability :: class : Ability_Base {
    on_init :: method() {
        name = "Shapeshift";
        icon = get_asset(Texture_Asset, "$AO/ui/kit/Game UI/Item Backs/inventory_squares_3/mask.png");
    }

    can_use :: method() -> bool {
        return player.(Player).is_mimicer;
    }

    on_update :: method(params: ref Ability_Update_Params) {
        if !params.clicked || !params.can_use {
            return;
        }

        current_cooldown = 0.35;
        p := player.(Player);
        Save.set_int(p, "ui_test_mimicer_shapeshift_pressed", 1);
        p.show_mimicer_selector = true;
        Save.set_int(p, "ui_test_mimicer_shapeshift_opened", 1);
    }
}

draw_mimicer_selector :: proc(player: Player) {
    if player == null || !player.is_mimicer {
        player.show_mimicer_selector = false;
        return;
    }

    UIK.begin(UIK.modal(UIK.rect_window_small(), 15));

    shell := UIK.panel_modal(.BLACK);
    shell.gap = 0;
    UIK.panel_begin(shell);

    title_desc := UIK.title_area_desc("Mimicer");
    title_desc.icon = get_asset(Texture_Asset, "$AO/ui/kit/Game UI/Item Backs/inventory_squares_3/mask.png");
    exit_handle := UIK.title_area(title_desc);

    body := UIK.layout_column();
    body.width = UIK.flex(1);
    body.height = UIK.flex(1);
    body.padding = v4{12, 16, 12, 16};
    body.gap = 8;
    UIK.panel_begin(body);

    UIK.text("Choose a player to mimic", UIK.text_title());

    list_desc := UIK.layout_column();
    list_desc.width = UIK.flex(1);
    list_desc.height = UIK.flex(1);
    list_desc.gap = 6;
    UIK.list_begin("mimicer/player_list", list_desc);

    target_user_ids: [..]string;
    target_handles: [..]Interact_Result;
    for target: component_iterator(Player) {
        username := target.get_username();
        target_user_ids.append(target.get_user_id());

        row_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREY);
        if target.get_user_id() == player.mimicer_form_target_user_id {
            row_desc = UIK.widget_desc_button_auto_default(.BUTTON_BASIC_YELLOW);
        }
        row_desc.panel.width = UIK.flex(1);
        row_desc.panel.height = UIK.pixels(46);
        target_handles.append(UIK.button(format_string("mimicer/target/%", {target.get_user_id()}), username, row_desc));
    }

    if target_user_ids.count == 0 {
        UIK.text("No players online", UIK.text_body());
    }

    UIK.list_end();

    close_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_RED);
    close_desc.panel.width = UIK.flex(1);
    close_desc.panel.height = UIK.pixels(52);
    close_btn := UIK.button("mimicer/close", "Close", close_desc);

    UIK.panel_end();
    UIK.panel_end();
    UIK.end();

    if exit_handle.clicked || close_btn.clicked {
        player.show_mimicer_selector = false;
    }

    for i: 0..target_handles.count - 1 {
        if UIK.clicked(target_handles[i]) {
            target := find_online_player_by_user_id(target_user_ids[i]);
            if target != null {
                apply_mimicer_form(player, target);
            }
        }
    }
}
