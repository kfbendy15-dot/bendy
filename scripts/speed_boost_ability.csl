Speed_Boost_Effect :: class : Effect_Base {
    original_speed: float;

    effect_start :: method() {
        original_speed = player.agent.movement_speed;
        player.agent.movement_speed = original_speed * 1.75;
        set_duration(7.0);
    }

    effect_end :: method(interrupt: bool) {
        player.agent.movement_speed = original_speed;
    }
}

Speed_Boost_Ability :: class : Ability_Base {
    on_init :: method() {
        name = "Speed Boost";
        icon = get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_1/timer_icon.png");
    }

    can_use :: method() -> bool {
        p := player.(Player);
        if !p.has_speed_boost return false;
        // Prevent stacking while already boosted
        if p.entity.has_effect(Speed_Boost_Effect) return false;
        return true;
    }

    on_update :: method(params: ref Ability_Update_Params) {
        if params.clicked && params.can_use {
            // Consume the purchase - must re-buy after it expires
            player.(Player).has_speed_boost = false;
            current_cooldown = 1.0;
            player.entity.add_passive_effect(new(Speed_Boost_Effect));
        }
    }
}
