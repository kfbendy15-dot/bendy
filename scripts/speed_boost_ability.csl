SPEED_BOOST_MULT :: 1.75;

Speed_Boost_Effect :: class : Effect_Base {
    effect_start :: method() {
        player.agent.movement_speed *= SPEED_BOOST_MULT;
        set_duration(7.0);
    }

    effect_end :: method(interrupt: bool) {
        if player.agent.movement_speed > 0.01 {
            player.agent.movement_speed /= SPEED_BOOST_MULT;
        }
    }
}

Speed_Boost_Ability :: class : Ability_Base {
    on_init :: method() {
        name = "Speed Boost";
        icon = get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_1/timer_icon.png");
    }

    can_use :: method() -> bool {
        // Stackable and unlimited use - only requires owning the boost
        p := player.(Player);
        if !p.has_speed_boost return false;
        return true;
    }

    on_update :: method(params: ref Ability_Update_Params) {
        if params.clicked && params.can_use {
            current_cooldown = 0.2;
            player.entity.add_passive_effect(new(Speed_Boost_Effect));
        }
    }
}
