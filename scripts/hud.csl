draw_settings :: proc(player: Player) {
    UIK.begin(UIK.modal(UIK.rect_window_small(), 20));

    shell := UIK.panel_modal(.BLUE);
    UIK.panel_begin(shell);
    exit_result := UIK.title_area(UIK.title_area_desc("Settings"));
    if exit_result.clicked { player.show_settings = false; }

    content := UIK.layout_column();
    content.width = UIK.flex(1);
    content.height = UIK.flex(1);
    content.padding = v4{14, 18, 14, 18};
    content.gap = 8;
    UIK.panel_begin(content);

    UIK.text(UIK.text_title(), "Gameplay");
    if player.has_vip {
        crown_result := UIK.toggle("settings/vip_crown", "Show VIP crown", (&player.show_vip_crown).(*bool), UIK.widget_desc_button_auto_default(.BUTTON_BASIC_YELLOW));
        if crown_result.clicked {
            Save.set_int(player, VIP_CROWN_VISIBLE_SAVE_KEY, player.show_vip_crown ? 1 : 0);
            if !player.show_vip_crown && #alive(player.vip_crown_entity) {
                player.vip_crown_entity.set_local_enabled(false);
            }
        }
    } else {
        UIK.text(UIK.text_body(), "VIP crown settings unlock with VIP.");
    }

    if can_access_admin_panel(player) {
        UIK.divider();
        UIK.text(UIK.text_title(), "Admin Settings");
        admin_tag_result := UIK.toggle("settings/admin_tag", "Show admin tag", (&player.show_admin_tag).(*bool), UIK.widget_desc_button_auto_default(.BUTTON_BASIC_YELLOW));
        if admin_tag_result.clicked {
            Save.set_int(player, ADMIN_TAG_VISIBLE_SAVE_KEY, player.show_admin_tag ? 1 : 0);
        }
    }

    UIK.divider();
    UIK.text(UIK.text_title(), "Interface");
    UIK.toggle("settings/reward_popups", "Show reward popups", (&player.show_reward_popups).(*bool), UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREY));
    Save.set_int(player, "show_reward_popups", player.show_reward_popups ? 1 : 0);
    UIK.toggle("settings/tutorial_button", "Show tutorial button", (&player.show_tutorial_button).(*bool), UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREY));
    Save.set_int(player, "show_tutorial_button", player.show_tutorial_button ? 1 : 0);
    UIK.text(UIK.text_body(), "Your settings are saved automatically.");

    UIK.panel_end();
    UIK.panel_end();
    UIK.end();
}

draw_event_panel :: proc(player: Player) {
    UIK.begin(UIK.modal(UIK.rect_window_small(), 30));
    shell := UIK.panel_modal(.BLUE);
    UIK.panel_begin(shell);
    title := UIK.title_area(UIK.title_area_desc("Event Shop"));
    if title.clicked { player.show_event_panel = false; }
    UIK.text(UIK.text_title(), "Only Ice is available.");
    UIK.text(UIK.text_body(), g_event_ice ? "Ice event active" : "Ice event inactive");
    toggle := UIK.button("events/ice", g_event_ice ? "Stop Ice" : "Start Ice", UIK.widget_desc_button_auto_default(.BUTTON_BASIC_YELLOW));
    UIK.panel_end();
    UIK.end();
    if UIK.clicked(toggle) { g_event_ice = !g_event_ice; }
}

draw_hud :: proc(player: Player) {
    UIK.begin(UIK.window(UIK.rect_topbar()));

    bar := UIK.layout_row();
    bar.width = UIK.flex(1);
    bar.height = UIK.flex(1);
    bar.padding = v4{8, 16, 8, 16};
    bar.gap = 12;
    bar.cross_align = .CENTER;
    UIK.panel_begin(bar);

    // Coin balance
    coin_tex := get_asset(Texture_Asset, "Gold_Coin_Icon_d3f0f3.png");
    balance := Economy.get_balance(player, "Coins");
    UIK.currency(coin_tex, balance, UIK.text_title());

    if is_murder_mystery_active() {
        chance_style := UIK.text_body();
        chance_style.color = {1, 0.85, 0.35, 1};
        UIK.text(format_string("Detective chance: % | Murderer chance: %", {format_float(player.detective_chance_percent, decimals=1), format_float(player.murderer_chance_percent, decimals=1)}), chance_style);
    }

    if is_murder_mystery_active() && player.murder_role != .NONE {
        role_style := UIK.text_title();
        role_style.color = player.murder_role == .KILLER ? {1, 0.2, 0.2, 1} : player.murder_role == .DETECTIVE ? {0.3, 0.7, 1, 1} : {0.5, 1, 0.5, 1};
        UIK.text(format_string("Role: %", {murder_role_name(player.murder_role)}), role_style);
    }

    if player.show_reward_popups && player.reward_feedback_duration > 0 {
        elapsed := get_time() - player.reward_feedback_start;
        if elapsed < player.reward_feedback_duration {
            pct := clamp(elapsed / player.reward_feedback_duration, 0, 1);
            ts := UIK.text_body();
            ts.color = {0.35, 1.0, 0.5, 1.0 - pct};
            UIK.text(player.reward_feedback_text, ts);
        }
    }

    UIK.spacer(UIK.flex(1), UIK.pixels(1));

    has_admin_button := can_access_admin_panel(player);
    shop_btn: Interact_Result;
    event_shop_btn: Interact_Result;
    admin_btn: Interact_Result;
    admin_shop_btn: Interact_Result;
    vs_btn: Interact_Result;
    shop_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREEN);
    shop_desc.panel.width = UIK.pixels(92);
    shop_desc.panel.height = UIK.pixels(52);
    shop_btn = UIK.button("hud/shop_button", "SHOP", shop_desc);

    vs_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_RED);
    vs_desc.panel.width = UIK.pixels(104);
    vs_desc.panel.height = UIK.pixels(52);
    vs_btn = UIK.button("hud/vs_button", "VS", vs_desc);

    if has_admin_button {
        event_shop_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_BLUE);
        event_shop_desc.panel.width = UIK.pixels(116);
        event_shop_desc.panel.height = UIK.pixels(52);
        event_shop_btn = UIK.button("hud/event_shop_button", "EVENT SHOP", event_shop_desc);

        admin_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREY);
        admin_desc.panel.width = UIK.pixels(120);
        admin_desc.panel.height = UIK.pixels(52);
        admin_btn = UIK.button("hud/admin_button", "ADMIN PANEL", admin_desc);

        admin_shop_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREEN);
        admin_shop_desc.panel.width = UIK.pixels(120);
        admin_shop_desc.panel.height = UIK.pixels(52);
        admin_shop_btn = UIK.button("hud/admin_shop_button", "ADMIN SHOP", admin_shop_desc);
    }

    UIK.panel_end();
    UIK.end();

    if UIK.clicked(shop_btn) {
        player.shop_tab_index = 0;
        player.show_shop = true;
    }
    if has_admin_button && UIK.clicked(event_shop_btn) {
        player.shop_tab_index = 1;
        player.show_shop = true;
    }
    if UIK.clicked(vs_btn) {
        start_vs_battle(player);
    }
    if has_admin_button && UIK.clicked(admin_btn) {
        player.show_admin_panel = true;
        Save.set_int(player, "ui_test_show_admin", 1);
    }
    if has_admin_button && UIK.clicked(admin_shop_btn) {
        player.show_admin_shop = true;
        Save.set_int(player, "ui_test_show_admin_shop", 1);
    }

    if player.show_settings {
        draw_settings(player);
    }
    if player.show_element_guide {
        draw_element_guide(player);
    }
}





