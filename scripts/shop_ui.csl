    test_tripmine_spawn_btn := UIK.button("admin/tripmine_spawn", "Spawn Tripmine", test_tripmine_spawn_desc);
    test_tripmine_trigger_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREY);
    test_tripmine_trigger_desc.panel.width = UIK.flex(1);
    test_tripmine_trigger_desc.panel.height = UIK.pixels(52);
    test_tripmine_trigger_btn := UIK.button("admin/tripmine_trigger", "Trigger Tripmine", test_tripmine_trigger_desc);
    test_invisible_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREY);
    test_invisible_desc.panel.width = UIK.flex(1);
    test_invisible_desc.panel.height = UIK.pixels(52);
    test_invisible_btn := UIK.button("admin/powerup_invisible", "Powerup Invisible", test_invisible_desc);
    UIK.panel_end();

    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    close_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_RED);
    close_desc.panel.width = UIK.flex(1);
    close_desc.panel.height = UIK.pixels(52);
    close_btn := UIK.button("admin/close", "Close", close_desc);

    UIK.list_end();
    UIK.panel_end();
    UIK.end();

    if UIK.clicked(exit_handle) || UIK.clicked(close_btn) {
        player.show_admin_panel = false;
    }

    if target_usernames.count > 0 {
        for i: 0..target_usernames.count - 1 {
            if UIK.clicked(target_handles[i]) {
                player.admin_target_username = target_usernames[i];
            }
        }
    }

    if UIK.clicked(amt10_btn) {
        player.admin_grant_amount = 10;
    }
    if UIK.clicked(amt25_btn) {
        player.admin_grant_amount = 25;
    }
    if UIK.clicked(amt50_btn) {
        player.admin_grant_amount = 50;
    }
    if UIK.clicked(amt100_btn) {
        player.admin_grant_amount = 100;
    }
    if UIK.clicked(amt250_btn) {
        player.admin_grant_amount = 250;
    }

    if UIK.clicked(grant_coins_btn) {
        if grant_coins_to_username(admin_target.get_username(), player.admin_grant_amount) {
            player.play_reward_feedback(format_string("+% to %", {player.admin_grant_amount, admin_target.get_username()}));
        } else {
            player.play_reward_feedback("Target not found");
        }
    }

    if UIK.clicked(ban_btn) {
        if admin_target == null {
            player.play_reward_feedback("Choose a player");
        } else if player.admin_grant_amount <= 0 {
            player.play_reward_feedback("Choose a ban duration");
        } else {
            moderation_ban(player, admin_target, player.admin_grant_amount, "Admin panel action");
            player.play_reward_feedback(format_string("Banned %", {admin_target.get_username()}));
        }
    }

    if UIK.clicked(unban_btn) {
        player.show_admin_panel = false;
        player.show_admin_unban = true;
        refresh_admin_banned_users(player);
    }

    if UIK.clicked(minigames_btn) {
        player.show_admin_panel = false;
        player.show_minigames = true;
    }

    if UIK.clicked(summon_btn) {
        spawn_paperclips_boss();
        player.play_reward_feedback("Paperclips approaches!");
    }

    for tier: 1..8 { if UIK.clicked(armor_handles[tier - 1]) { player.admin_armor_tier = tier; set_armor_tier_for_admin(admin_target, tier); } }

    if UIK.clicked(meteor_btn) {
        spawn_meteor_boss();
        player.play_reward_feedback("Meteor incoming!");
    }

    if UIK.clicked(fun_btn) {
        toggle_fun_mode();
    }

    if UIK.clicked(mimicer_btn) {
        grant_mimicer_mode(player);
        player.show_admin_panel = false;
    }

    if UIK.clicked(inv_btn) {
        set_player_invincible(admin_target, true);
        admin_target.play_reward_feedback("Invincible");
    }

    if UIK.clicked(stealth_btn) {
        set_player_invisible(admin_target, !admin_target.admin_invisible_active);
        if admin_target.admin_invisible_active {
            admin_target.play_reward_feedback("Invisible on");
        } else {
            admin_target.play_reward_feedback("Invisible off");
        }
    }

    if UIK.clicked(noclip_btn) {
        set_player_noclip(admin_target, !admin_target.is_admin_noclip);
        if admin_target.is_admin_noclip {
            admin_target.play_reward_feedback("Noclip on");
        } else {
            admin_target.play_reward_feedback("Noclip off");
        }
    }

    if UIK.clicked(grass_btn) {
        set_admin_map_destination(admin_target, "grass", {-24, -14}, "Grass Map");
    }
    if UIK.clicked(sand_btn) {
        set_admin_map_destination(admin_target, "sand", {0, -14}, "Sand Map");
    }
    if UIK.clicked(lava_btn) {
        set_admin_map_destination(admin_target, "lava", {24, -14}, "Lava Map");
    }
    if UIK.clicked(ice_btn) {
        set_admin_map_destination(admin_target, "ice", {0, 14}, "Ice Map");
    }
    if UIK.clicked(island_btn) {
        set_admin_map_destination(admin_target, "island", {24, 14}, "Island Map");
    }
    if UIK.clicked(backrooms_btn) {
        send_player_to_backrooms(admin_target);
    }
    if UIK.clicked(normal_map_btn) {
        return_player_from_backrooms(admin_target);
    }

    if UIK.clicked(ar_btn) {
        grant_weapon_with_ammo(admin_target, .ASSAULT_RIFLE, get_weapon_config(.ASSAULT_RIFLE).ammo_first_pickup);
    }
    if UIK.clicked(smg_btn) {
        grant_weapon_with_ammo(admin_target, .SUBMACHINE_GUN, get_weapon_config(.SUBMACHINE_GUN).ammo_first_pickup);
    }
    if UIK.clicked(gatling_btn) {
        grant_weapon_with_ammo(admin_target, .GATLING_GUN, get_weapon_config(.GATLING_GUN).ammo_first_pickup);
    }
    if UIK.clicked(shotgun_btn) {
        grant_weapon_with_ammo(admin_target, .EXPLOSIVE_SHOTGUN, get_weapon_config(.EXPLOSIVE_SHOTGUN).ammo_first_pickup);
    }
    if UIK.clicked(ray_btn) {
        grant_weapon_with_ammo(admin_target, .RAY_GUN, get_weapon_config(.RAY_GUN).ammo_first_pickup);
    }
    if UIK.clicked(hydro_btn) {
        grant_weapon_with_ammo(admin_target, .HYDRO_CANNON, get_weapon_config(.HYDRO_CANNON).ammo_first_pickup);
    }
    if UIK.clicked(beam_btn) {
        grant_weapon_with_ammo(admin_target, .BEAM_MACHINE, get_weapon_config(.BEAM_MACHINE).ammo_first_pickup);
    }
    if UIK.clicked(water_btn) {
        grant_weapon_with_ammo(admin_target, .WATER_GUN, get_weapon_config(.WATER_GUN).ammo_first_pickup);
    }
    if UIK.clicked(missile_btn) {
        grant_weapon_with_ammo(admin_target, .MISSILE_BARRAGE, get_weapon_config(.MISSILE_BARRAGE).ammo_first_pickup);
    }
    if UIK.clicked(blunder_btn) {
        grant_weapon_with_ammo(admin_target, .BLUNDERBUSS, get_weapon_config(.BLUNDERBUSS).ammo_first_pickup);
    }
    if UIK.clicked(plasma_btn) {
        grant_weapon_with_ammo(admin_target, .PLASMA_BURST, get_weapon_config(.PLASMA_BURST).ammo_first_pickup);
    }
    if UIK.clicked(boom_btn) {
        grant_weapon_with_ammo(admin_target, .BOOMWHEEL, get_weapon_config(.BOOMWHEEL).ammo_first_pickup);
    }

    if UIK.clicked(test_tripmine_spawn_btn) {
        admin_spawn_tripmine_test_only(admin_target);
    }
    if UIK.clicked(test_tripmine_trigger_btn) {
        admin_spawn_tripmine_test_trigger(admin_target);
    }
    if UIK.clicked(test_invisible_btn) {
        admin_apply_invisible_test(admin_target);
    }

}

draw_event_panel :: proc(player: Player) {
    if player == null || !can_access_admin_panel(player) return;

    UIK.begin(UIK.modal(UIK.rect_window(), 15));
    shell := UIK.panel_modal(.BLACK);
    shell.gap = 0;
    UIK.panel_begin(shell);
    title_desc := UIK.title_area_desc("Event Panel");
    title_desc.icon = get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_1/timer_icon.png");
    exit_handle := UIK.title_area(title_desc);
    body := UIK.layout_column();
    body.width = UIK.flex(1);
    body.height = UIK.flex(1);
    body.padding = v4{12, 16, 12, 16};
    body.gap = 8;
    UIK.list_begin("admin/events_body", body);
    UIK.text("Start a server-wide event.", UIK.text_title());
    UIK.text("Choose an event, then select a player to assign that element.", UIK.text_body());

    target_usernames: [..]string;
    target_handles: [..]Interact_Result;
    target_scroll := UIK.layout_column();
    target_scroll.width = UIK.flex(1);
    target_scroll.height = UIK.pixels(150);
    target_scroll.gap = 4;
    UIK.list_begin("events/targets", target_scroll);
    for target_player: component_iterator(Player) {
        username := target_player.get_username();
        target_usernames.append(username);
        target_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREY);
        if username == player.admin_target_username {
            target_desc = UIK.widget_desc_button_auto_default(.BUTTON_BASIC_YELLOW);
        }
        target_desc.panel.width = UIK.flex(1);
        target_desc.panel.height = UIK.pixels(40);
        target_handles.append(UIK.button(format_string("events/target/%", {username}), username, target_desc));
    }
    UIK.list_end();

    target := find_online_player_by_username(player.admin_target_username);
    if target == null { target = player; }
    element_buttons: [..]Interact_Result;
    if target != null && g_event_elemental {
        UIK.text(format_string("Target element: %", {element_name_for_value(target.player_element)}), UIK.text_body());
        for i: 0..6 {
            element_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREY);
            element_desc.panel.width = UIK.flex(1); element_desc.panel.height = UIK.pixels(44);
            element_buttons.append(UIK.button(format_string("events/assign/%", {i + 1}), element_name_for_value(i + 1), element_desc));
        }
    }

    fire_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREEN);
    fire_desc.panel.width = UIK.flex(1); fire_desc.panel.height = UIK.pixels(52);
    fire_btn := UIK.button("events/start_fire", "Start Fire Event", fire_desc);
    water_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREEN);
    water_desc.panel.width = UIK.flex(1); water_desc.panel.height = UIK.pixels(52);
    water_btn := UIK.button("events/start_water", "Start Water Event", water_desc);
    leaf_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREEN);
    leaf_desc.panel.width = UIK.flex(1); leaf_desc.panel.height = UIK.pixels(52);
    leaf_btn := UIK.button("events/start_leaf", "Start Leaf Event", leaf_desc);

    ice_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREEN);
    ice_desc.panel.width = UIK.flex(1);
    ice_desc.panel.height = UIK.pixels(60);
    ice_btn := UIK.button("events/start_ice", "Start Ice Event", ice_desc);
    void_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREEN);
    void_desc.panel.width = UIK.flex(1); void_desc.panel.height = UIK.pixels(52);
    void_btn := UIK.button("events/start_void", "Start Void Event", void_desc);
    lightning_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREEN);
    lightning_desc.panel.width = UIK.flex(1); lightning_desc.panel.height = UIK.pixels(52);
    lightning_btn := UIK.button("events/start_lightning", "Start Lightning Event", lightning_desc);
    sun_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREEN);
    sun_desc.panel.width = UIK.flex(1); sun_desc.panel.height = UIK.pixels(52);
    sun_btn := UIK.button("events/start_sun", "Start Sun Event", sun_desc);
    stop_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_RED);
    stop_desc.panel.width = UIK.flex(1); stop_desc.panel.height = UIK.pixels(52);
    stop_btn := UIK.button("events/stop", "Stop Event", stop_desc);
    close_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_RED);
    close_desc.panel.width = UIK.flex(1);
    close_desc.panel.height = UIK.pixels(52);
    close_btn := UIK.button("events/close", "Close", close_desc);
    UIK.list_end();
    UIK.panel_end();
    UIK.end();

    if UIK.clicked(exit_handle) || UIK.clicked(close_btn) {
        player.show_event_panel = false;
    }
    if UIK.clicked(stop_btn) {
        stop_active_event();
        player.show_event_panel = false;
        player.play_reward_feedback("Event stopped");
    }
    fire_clicked := UIK.clicked(fire_btn);
    water_clicked := UIK.clicked(water_btn);
    leaf_clicked := UIK.clicked(leaf_btn);
    ice_clicked := UIK.clicked(ice_btn);
    void_clicked := UIK.clicked(void_btn);
    lightning_clicked := UIK.clicked(lightning_btn);
    sun_clicked := UIK.clicked(sun_btn);
    any_event_clicked := fire_clicked || water_clicked || leaf_clicked || ice_clicked || void_clicked || lightning_clicked || sun_clicked;
    if any_event_clicked {
        g_event_elemental = true;
        g_event_ice = ice_clicked;
        g_event_sun = sun_clicked;
        if fire_clicked { g_active_element_event = 1; }
        else if water_clicked { g_active_element_event = 2; }
        else if leaf_clicked { g_active_element_event = 3; }
        else if ice_clicked { g_active_element_event = 4; }
        else if void_clicked { g_active_element_event = 5; }
        else if sun_clicked { g_active_element_event = 7; }
        else { g_active_element_event = 6; }
        g_event_ends_at = get_time() + 600.0;
        cur_elem := Save.get_game_int(EVENT_ELEMENTAL_KEY, 0);
        if cur_elem == 0 { Save.increment_game_int(EVENT_ELEMENTAL_KEY, 1); }
        cur_ice := Save.get_game_int(EVENT_ICE_KEY, 0);
        if g_event_ice && cur_ice == 0 { Save.increment_game_int(EVENT_ICE_KEY, 1); }
        if !g_event_ice && cur_ice != 0 { Save.increment_game_int(EVENT_ICE_KEY, -cur_ice); }
        cur_sun := Save.get_game_int(EVENT_SUN_KEY, 0);
        if g_event_sun && cur_sun == 0 { Save.increment_game_int(EVENT_SUN_KEY, 1); }
        if !g_event_sun && cur_sun != 0 { Save.increment_game_int(EVENT_SUN_KEY, -cur_sun); }
        player.show_event_panel = false;
        player.show_admin_panel = false;
        player.show_admin_shop = false;
        player.show_shop = false;
        if player != null {
            player.play_reward_feedback(format_string("% Event started", {elemental_shop_name(g_active_element_event)}));
        }
        Chat.server_send_message(format_string("% Event started", {elemental_shop_name(g_active_element_event)}));
    }
    for i: 0..target_usernames.count - 1 {
        if i < target_handles.count && UIK.clicked(target_handles[i]) {
            player.admin_target_username = target_usernames[i];
        }
    }
    if target != null && g_event_elemental && element_buttons.count >= 7 {
        for i: 0..6 {
            if i < element_buttons.count && UIK.clicked(element_buttons[i]) {
                if target != null && #alive(target) && #alive(target.entity) {
                    target.player_element = i + 1;
                    if target.get_username().count > 0 {
                        player.play_reward_feedback(format_string("% became %", {target.get_username(), element_name_for_value(i + 1)}));
                    }
                }
            }
        }
    }
}




