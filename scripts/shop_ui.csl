    ammo500_desc.panel.width = UIK.flex(1);
    ammo500_desc.panel.height = UIK.pixels(52);
    ammo500_btn := UIK.button("bonus_bullets/large", "+500 Bullets", ammo500_desc);
    UIK.panel_end();

    if UIK.clicked(ammo100_btn) {
