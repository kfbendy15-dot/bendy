draw_shop_card :: proc(id: string, label: string, price: s64, icon: Texture_Asset, tint: v4, owned: bool) -> Interact_Result {
    card_desc := UIK.card_desc(UIK.flex(1), UIK.pixels(128), tint, .LANDSCAPE, 0.42, 0.0, 0.0);
    UIK.card_begin(id, card_desc);

    UIK.card_zone(.MEDIA);
    UIK.image_fitted(icon, UIK.image_desc(.CONTAIN));
    UIK.card_zone_end();

    UIK.card_zone(.BODY);
    label_style := UIK.text_body();
    UIK.text(label_style, "%", {label});
    UIK.spacer(UIK.pixels(1), UIK.pixels(6));
    coin := get_asset(Texture_Asset, "$AO/ui/kit/Icons/coin/coin_icon.png");
    price_style := UIK.text_body();
    UIK.currency(coin, price, price_style);
    if id == "admin_shop/giant_gun" {
        UIK.spacer(UIK.pixels(1), UIK.pixels(4));
        by_style := UIK.text_body();
        UIK.text(by_style, "By 59zttiotnra");
    }
    if owned {
        UIK.spacer(UIK.pixels(1), UIK.pixels(4));
        owned_style := UIK.text_body();
        UIK.text(owned_style, "Owned");
    }
    UIK.card_zone_end();

    return UIK.card_end();
}

elemental_shop_event :: proc() -> s64 {
    if !g_event_elemental return 0;
    return g_active_element_event;
}

elemental_shop_name :: proc(event: s64) -> string {
    if event == 0 return "Closed";
    if event == 1 return "Fire";
    if event == 2 return "Water";
    if event == 3 return "Leaf";
    if event == 4 return "Ice";
    if event == 5 return "Void";
    if event == 7 return "Sun";
    return "Lightning";
}

element_icon_for_name :: proc(name: string) -> string {
    if name == "Fire Ray" || name == "Solar Siphoner" || name == "Meteorite" { return "Fire"; }
    if name == "Water Gun" || name == "Water Balloon RPG" || name == "Hydro Cannon" || name == "Bubble Gun" { return "Water"; }
    if name == "Poison Grenade" || name == "Shuriken" || name == "CTF Minion Gun" { return "Leaf"; }
    if name == "Ice Launcher" || name == "Glaciator" { return "Ice"; }
    return "";
}

play_pickup_feedback :: proc(player: Player, text: string) {
    player.reward_feedback_text = text;
    player.reward_feedback_start = get_time();
    player.reward_feedback_duration = 1.0;
}

giant_gun_admin_cost :: proc(player: Player) -> s64 {
    if can_access_admin_panel(player) {
        return 1;
    }
    return 1000000;
}

buy_weapon_offer :: proc(player: Player, wt: Weapon_Type, cost: s64, feedback_text: string) {
    if player_has_weapon(player, wt) {
        return;
    }

    weapon_def := get_weapon_item_def(wt);
    if weapon_def != null && Items.calculate_room_in_inventory_for_item(weapon_def, player.default_inventory) <= 0 {
        player.play_reward_feedback("No room");
        return;
    }

    if !spend_coins(player, cost) {
        return;
    }

    grant_weapon_with_ammo(player, wt, get_weapon_config(wt).ammo_first_pickup);
    if wt != .ICE_LAUNCHER && wt != .GLACIATOR {
        player.gun_mutation_element = weapon_element(wt);
        if player.gun_mutation_element == 0 { player.gun_mutation_element = 2; }
    }
    // Every purchased gun receives its elemental mutation; Ice is reserved for the Ice event.
    if wt != .ICE_LAUNCHER && wt != .GLACIATOR {
        element := weapon_element(wt);
        if element == 1 { player.play_reward_feedback(format_string("% Fire mutation", {feedback_text})); }
        if element == 2 { player.play_reward_feedback(format_string("% Water mutation", {feedback_text})); }
        if element == 3 { player.play_reward_feedback(format_string("% Leaf mutation", {feedback_text})); }
    }
    equip_weapon_item_if_present(player, wt);
    if !player.show_admin_shop {
        player.show_shop = false;
    }
    play_pickup_feedback(player, feedback_text);

    if player.is_local() {
        sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/equip_gun.wav");
        desc := SFX.default_sfx_desc();
        desc.volume = 0.6;
        SFX.play(sfx, desc);
    }
}

buy_ammo_offer :: proc(player: Player, ammo_index: s64, amount: s64, cost: s64, feedback_text: string) {
    if amount <= 0 {
        return;
    }

    ammo_info := get_ammo_info(ammo_index);
    ammo_def := g_ammo_item_defs[ammo_index];
    if ammo_def == null || ammo_info.stack_size <= 0 {
        return;
    }

    remaining := amount;
    bought := false;
    while remaining > 0 {
        chunk := remaining;
        if chunk > ammo_info.stack_size {
            chunk = ammo_info.stack_size;
        }

        ammo := Items.create_item_instance(ammo_def, chunk);
        will_destroy: bool;
        if Items.can_move_item_to_inventory(ammo, player.default_inventory, ref will_destroy) {
            if !bought {
                if !spend_coins(player, cost) {
                    Items.destroy_item_instance(ammo);
                    return;
                }
                bought = true;
            }

            Items.move_item_to_inventory(ammo, player.default_inventory);
        } else {
            Items.destroy_item_instance(ammo);
            break;
        }

        remaining -= chunk;
    }

    if bought {
        play_pickup_feedback(player, feedback_text);

        if player.is_local() {
            sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/equip_gun.wav");
            desc := SFX.default_sfx_desc();
            desc.volume = 0.5;
            SFX.play(sfx, desc);
        }
    }
}

buy_bullets :: proc(player: Player) {
    buy_ammo_offer(player, 0, BULLETS_PER_BUY, BULLET_COST, format_string("+% Bullets", {BULLETS_PER_BUY}));
}

buy_verity_offer :: proc(player: Player) {
    if grant_verity_item(player) {
        play_pickup_feedback(player, "+Verity");
        if player.is_local() {
            sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/equip_gun.wav");
            desc := SFX.default_sfx_desc();
            desc.volume = 0.5;
            SFX.play(sfx, desc);
        }
    } else {
        player.play_reward_feedback("No room");
    }
}

grant_admin_ammo_offer :: proc(player: Player, ammo_index: s64, amount: s64, feedback_text: string) {
    if player == null || amount <= 0 {
        return;
    }

    grant_ammo_to_player(player, ammo_index, amount);
    play_pickup_feedback(player, feedback_text);

    if player.is_local() {
        sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/equip_gun.wav");
        desc := SFX.default_sfx_desc();
        desc.volume = 0.5;
        SFX.play(sfx, desc);
    }
}

buy_armor_offer :: proc(player: Player) {
    if spend_coins(player, 750) {
        buy_armor_progression(player);
    }
}

draw_coin_pass_card :: proc(player: Player, product_id: string, amount: s64) -> Interact_Result {
    product := Purchasing.get_product(product_id);
    available := product.id.count > 0;
    tint := v4{0.78, 0.62, 0.18, 1};
    if !available {
        tint = v4{0.38, 0.38, 0.38, 1};
    } else if product.consumable {
        tint = v4{0.28, 0.72, 0.38, 1};
    }

    card_desc := UIK.card_desc(UIK.flex(1), UIK.pixels(108), tint, .LANDSCAPE, 0.32, 0.04, 0.10);
    UIK.card_begin(product_id, card_desc);

    UIK.card_zone(.MEDIA);
    coin := get_asset(Texture_Asset, "$AO/ui/kit/Icons/coin/coin_icon.png");
    UIK.image_fitted(coin, UIK.image_desc(.CONTAIN));
    UIK.card_zone_end();

    UIK.card_zone(.BODY);
    UIK.text(UIK.text_body(), "% Coins", {amount});
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    UIK.text(UIK.text_body(), "Buy again for more coins.");
    if !available {
        UIK.spacer(UIK.pixels(1), UIK.pixels(2));
        UIK.text(UIK.text_body(), "Unavailable");
    } else if product.consumable {
        UIK.spacer(UIK.pixels(1), UIK.pixels(2));
        UIK.text(UIK.text_body(), "Repeatable");
    }
    UIK.card_zone_end();

    return UIK.card_end();
}

draw_vip_pass_card :: proc(product_id: string) -> Interact_Result {
    product := Purchasing.get_product(product_id);
    available := product.id.count > 0;
    tint := v4{0.78, 0.62, 0.18, 1};
    if !available {
        tint = v4{0.38, 0.38, 0.38, 1};
    }

    card_desc := UIK.card_desc(UIK.flex(1), UIK.pixels(132), tint, .LANDSCAPE, 0.32, 0.04, 0.10);
    UIK.card_begin(product_id, card_desc);
    UIK.card_zone(.MEDIA);
    crown := get_asset(Texture_Asset, "$AO/ui/kit/Icons/trophies_rewards/crown_gold.png");
    UIK.image_fitted(crown, UIK.image_desc(.CONTAIN));
    UIK.card_zone_end();
    UIK.card_zone(.BODY);
    UIK.text(UIK.text_body(), "VIP");
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    UIK.text(UIK.text_body(), "Crown + half-price shops + double kill coins");
    if !available {
        UIK.spacer(UIK.pixels(1), UIK.pixels(2));
        UIK.text(UIK.text_body(), "Unavailable");
    }
    UIK.card_zone_end();
    return UIK.card_end();
}

draw_monetization_tab :: proc(player: Player) {
    content := UIK.layout_column();
    content.width = UIK.flex(1);
    content.height = UIK.flex(1);
    content.padding = v4{12, 16, 12, 16};
    content.gap = 8;
    UIK.list_begin("monetization_scroll", content);

    UIK.text(UIK.text_title(), "Passes");
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    UIK.text(UIK.text_body(), "Buy or gift a pass. Repeat purchases grant more coins.");
    UIK.spacer(UIK.pixels(1), UIK.pixels(6));
    UIK.text(UIK.text_body(), "VIP: crown hat, half-price shops, double kill coins");
    UIK.spacer(UIK.pixels(1), UIK.pixels(10));

    vip_product := Purchasing.get_product(VIP_PRODUCT_ID);
    vip_available := vip_product.id.count > 0;
    vip_buy_desc := UIK.widget_desc_button_auto_default(.BUTTON_SHINY_YELLOW);
    vip_buy_desc.panel.width = UIK.flex(1);
    vip_buy_desc.panel.height = UIK.pixels(58);
    vip_buy_handle := UIK.button("passes/vip_buy", "Buy VIP with Sparks", vip_buy_desc);
    vip_handle := draw_vip_pass_card(VIP_PRODUCT_ID);
    UIK.spacer(UIK.pixels(1), UIK.pixels(8));

    pass25_product := Purchasing.get_product(COIN_PASS_25_PRODUCT_ID);
    pass25_available := pass25_product.id.count > 0;
    pass25_handle := draw_coin_pass_card(player, COIN_PASS_25_PRODUCT_ID, 25);
    UIK.spacer(UIK.pixels(1), UIK.pixels(8));
    pass50_product := Purchasing.get_product(COIN_PASS_50_PRODUCT_ID);
    pass50_available := pass50_product.id.count > 0;
    pass50_handle := draw_coin_pass_card(player, COIN_PASS_50_PRODUCT_ID, 50);
    UIK.spacer(UIK.pixels(1), UIK.pixels(8));
    pass100_product := Purchasing.get_product(COIN_PASS_100_PRODUCT_ID);
    pass100_available := pass100_product.id.count > 0;
    pass100_handle := draw_coin_pass_card(player, COIN_PASS_100_PRODUCT_ID, 100);
    UIK.spacer(UIK.pixels(1), UIK.pixels(8));
    pass250_product := Purchasing.get_product(COIN_PASS_250_PRODUCT_ID);
    pass250_available := pass250_product.id.count > 0;
    pass250_handle := draw_coin_pass_card(player, COIN_PASS_250_PRODUCT_ID, 250);
    UIK.spacer(UIK.pixels(1), UIK.pixels(8));
    pass500_product := Purchasing.get_product(COIN_PASS_500_PRODUCT_ID);
    pass500_available := pass500_product.id.count > 0;
    pass500_handle := draw_coin_pass_card(player, COIN_PASS_500_PRODUCT_ID, 500);
    UIK.spacer(UIK.pixels(1), UIK.pixels(8));
    pass1000_product := Purchasing.get_product(COIN_PASS_1000_PRODUCT_ID);
    pass1000_available := pass1000_product.id.count > 0;
    pass1000_handle := draw_coin_pass_card(player, COIN_PASS_1000_PRODUCT_ID, 1000);

    UIK.list_end();

    if vip_available && UIK.clicked(vip_buy_handle) {
        Purchasing.prompt_purchase(player, VIP_PRODUCT_ID);
    }
    if vip_available && UIK.clicked(vip_handle) {
        Purchasing.prompt_purchase(player, VIP_PRODUCT_ID);
    }

    if pass25_available && UIK.clicked(pass25_handle) {
        Purchasing.prompt_purchase(player, COIN_PASS_25_PRODUCT_ID);
    }
    if pass50_available && UIK.clicked(pass50_handle) {
        Purchasing.prompt_purchase(player, COIN_PASS_50_PRODUCT_ID);
    }
    if pass100_available && UIK.clicked(pass100_handle) {
        Purchasing.prompt_purchase(player, COIN_PASS_100_PRODUCT_ID);
    }
    if pass250_available && UIK.clicked(pass250_handle) {
        Purchasing.prompt_purchase(player, COIN_PASS_250_PRODUCT_ID);
    }
    if pass500_available && UIK.clicked(pass500_handle) {
        Purchasing.prompt_purchase(player, COIN_PASS_500_PRODUCT_ID);
    }
    if pass1000_available && UIK.clicked(pass1000_handle) {
        Purchasing.prompt_purchase(player, COIN_PASS_1000_PRODUCT_ID);
    }

}

draw_shop :: proc(player: Player) {
    if is_murder_mystery_active() && player.murder_role == .INNOCENT {
        player.show_shop = false;
        return;
    }
    UIK.begin(UIK.modal(UIK.rect_window_large(), 15));

    shell := UIK.panel_modal(.BLACK);
    shell.gap = 0;
    UIK.panel_begin(shell);

    shop_title := "Shop";
    if is_murder_mystery_active() && player.murder_role == .DETECTIVE { shop_title = "Detective Shop"; }
    if is_murder_mystery_active() && player.murder_role == .KILLER { shop_title = "Killer Shop"; }
    title_desc := UIK.title_area_desc(shop_title);
    title_desc.icon = get_asset(Texture_Asset, "$AO/ui/kit/Icons/shopping_cart/shopping_cart_icon.png");
    exit_handle := UIK.title_area(title_desc);

    shop_close_btn: Interact_Result;
    armor_handle: Interact_Result;
    sun_armor_handle: Interact_Result;
    sun_tsunami_handle: Interact_Result;
    sun_sand_handle: Interact_Result;
    fire_shop_handle: Interact_Result;
    water_shop_handle: Interact_Result;
    leaf_shop_handle: Interact_Result;
    ice_shop_handle: Interact_Result;
    warper_shop_handle: Interact_Result;
    lightning_shop_handle: Interact_Result;
    shop_gun_cutter_handle: Interact_Result;
    shop_ar_handle: Interact_Result;
    shop_smg_handle: Interact_Result;
    shop_ray_handle: Interact_Result;
    shop_shotgun_handle: Interact_Result;
    shop_beam_handle: Interact_Result;
    shop_laser_handle: Interact_Result;
    shop_hydro_handle: Interact_Result;
    shop_blunder_handle: Interact_Result;
    stun_handle: Interact_Result;
    mine_handle: Interact_Result;
    bullets_handle: Interact_Result;
    heavy_handle: Interact_Result;
    explosive_handle: Interact_Result;
    energy_handle: Interact_Result;
    cryo_handle: Interact_Result;
    water_handle: Interact_Result;
    sawblade_handle: Interact_Result;
    lmg_handle: Interact_Result;
    dash_handle: Interact_Result;
    invis_handle: Interact_Result;
    speed_boost_handle: Interact_Result;
    zoom_out_handle: Interact_Result;
    normal_handle: Interact_Result;
    finger_handle: Interact_Result;
    paper_handle: Interact_Result;
    starter_handle: Interact_Result;
    murderer_chance_handle: Interact_Result;
    detective_chance_handle: Interact_Result;
    mystery_bundle_handle: Interact_Result;
    tabs := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(tabs);
    normal_tab := UIK.button("shop/tab_normal", "Shop", UIK.widget_desc_button_auto_default(player.shop_tab_index == 0 ? .BUTTON_BASIC_GREEN : .BUTTON_BASIC_GREY));
    UIK.panel_end();
    content := UIK.layout_column();
    content.width = UIK.flex(1);
    content.height = UIK.flex(1);
    content.padding = v4{12, 16, 12, 16};
    content.gap = 8;
    UIK.list_begin("shop_scroll", content);

    UIK.text("Featured Shop", UIK.text_title());
    event := elemental_shop_event();
    if g_event_sun {
        UIK.text("Sun event: Sun Shop open", UIK.text_body());
    } else {
        UIK.text(format_string(g_event_elemental ? ((event == 5 || event == 6) ? "% Shop open" : "Element event: % Shop open") : "Element event: Closed", {elemental_shop_name(event)}), UIK.text_body());
    }
    elemental_row := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(elemental_row);
    if event == 1 { fire_shop_handle = draw_shop_card("shop/fire_shop", "Fireball", 50, get_asset(Texture_Asset, get_weapon_config(.FIREBALL).weapon_icon_path), {0.95, 0.3, 0.15, 1}, player_has_weapon(player, .FIREBALL)); }
    if event == 2 { water_shop_handle = draw_shop_card("shop/water_shop", "Water Gun", 30, get_asset(Texture_Asset, get_weapon_config(.WATER_GUN).weapon_icon_path), {0.2, 0.55, 0.95, 1}, player_has_weapon(player, .WATER_GUN)); }
    if event == 3 { leaf_shop_handle = draw_shop_card("shop/leaf_shop", "Tree Trap", 60, get_asset(Texture_Asset, get_weapon_config(.KILLER_FISH).weapon_icon_path), {0.2, 0.8, 0.25, 1}, player_has_weapon(player, .KILLER_FISH)); }
    if event == 4 { ice_shop_handle = draw_shop_card("shop/ice_shop", "Ice Launcher", 85, get_asset(Texture_Asset, get_weapon_config(.ICE_LAUNCHER).weapon_icon_path), {0.55, 0.85, 1.0, 1}, player_has_weapon(player, .ICE_LAUNCHER)); }
    if event == 5 { warper_shop_handle = draw_shop_card("shop/void_special_warper", "Black Hole Gun", 1000, get_asset(Texture_Asset, get_weapon_config(.WARPER).weapon_icon_path), {0.7, 0.25, 1.0, 1}, player_has_weapon(player, .WARPER)); }
    if event == 6 { lightning_shop_handle = draw_shop_card("shop/lightning_gun", "Ray Gun", 90, get_asset(Texture_Asset, get_weapon_config(.RAY_GUN).weapon_icon_path), {0.25, 0.75, 1.0, 1}, player_has_weapon(player, .RAY_GUN)); }
    if event == 7 {
        sun_armor_handle = draw_shop_card("shop/sun_armor", "Sun Armor", 1000, get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_1/shield_iron.png"), {1.0, 0.58, 0.08, 1.0}, player.sun_armor_active || player.armor_tier >= 8);
        sun_tsunami_handle = draw_shop_card("shop/sun_shooter_tsunami", "Sun Shooter", 120, get_asset(Texture_Asset, get_weapon_config(.SUN_SHOOTER_TSUNAMI).weapon_icon_path), {0.15, 0.65, 1.0, 1.0}, player_has_weapon(player, .SUN_SHOOTER_TSUNAMI));
        sun_sand_handle = draw_shop_card("shop/sun_shooter_sand", "Sun Shooter", 120, get_asset(Texture_Asset, get_weapon_config(.SUN_SHOOTER_SAND).weapon_icon_path), {1.0, 0.35, 0.08, 1.0}, player_has_weapon(player, .SUN_SHOOTER_SAND));
    }
    UIK.panel_end();
    starter_icon := get_asset(Texture_Asset, get_weapon_config(.HYDRO_CANNON).weapon_icon_path);
    starter_handle = draw_shop_card("shop/starter_pack", "Starter Pack (199 Sparks)", SPARKS_STARTER_COST, starter_icon, {0.25, 0.75, 1.0, 1}, Save.get_int(player, STARTER_PACK_CLAIMED_KEY, 0) != 0);
    chance_row := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(chance_row);
    murderer_chance_handle = draw_shop_card("shop/murderer_chance", "Murderer Chance Increased", 299, starter_icon, {0.85, 0.25, 0.25, 1}, false);
    detective_chance_handle = draw_shop_card("shop/detective_chance", "Detective Chance Increased", 99, starter_icon, {0.25, 0.55, 0.95, 1}, false);
    UIK.panel_end();
    bundle_row := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(bundle_row);
    mystery_bundle_handle = draw_shop_card("shop/murder_mystery_bundle", "Murder Mystery Bundle (all 9 items)", 399, starter_icon, {0.75, 0.35, 0.9, 1}, Save.get_int(player, MURDER_MYSTERY_PACK_KEY, 0) != 0);
    UIK.panel_end();
    if player.has_vip {
        UIK.text(UIK.text_body(), "VIP: 50% off shop prices");
    }
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    support_row := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(support_row);
    armor_icon := get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_1/shield_iron.png");
    armor_handle = draw_shop_card("shop/armor", "Armor", shop_price(player, 750), armor_icon, {0.35, 0.55, 0.85, 1}, false);
    UIK.panel_end();

    UIK.spacer(UIK.pixels(1), UIK.pixels(10));
    UIK.text("Guns", UIK.text_title());
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    shop_gun_row_1 := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(shop_gun_row_1);
    shop_gun_cutter_icon := get_asset(Texture_Asset, get_weapon_config(.MEGA_BLADE).weapon_icon_path);
    shop_smg_icon := get_asset(Texture_Asset, get_weapon_config(.SUBMACHINE_GUN).weapon_icon_path);
    shop_gun_cutter_handle = draw_shop_card("shop/gun_cutter", "Gun Cutter", shop_price(player, SWORD_COST), shop_gun_cutter_icon, {0.9, 0.75, 0.25, 1}, player_has_weapon(player, .MEGA_BLADE));
    shop_smg_handle = draw_shop_card("shop/submachine_gun", "Submachine Gun", shop_price(player, 70), shop_smg_icon, {0.5, 0.65, 0.85, 1}, player_has_weapon(player, .SUBMACHINE_GUN));
    UIK.panel_end();

    UIK.spacer(UIK.pixels(1), UIK.pixels(8));
    shop_gun_row_2 := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(shop_gun_row_2);
    shop_ray_icon := get_asset(Texture_Asset, get_weapon_config(.RAY_GUN).weapon_icon_path);
    shop_shotgun_icon := get_asset(Texture_Asset, get_weapon_config(.EXPLOSIVE_SHOTGUN).weapon_icon_path);
    shop_ray_handle = draw_shop_card("shop/ray_gun", "Ray Gun", shop_price(player, 90), shop_ray_icon, {0.35, 0.75, 1.0, 1}, player_has_weapon(player, .RAY_GUN));
    shop_shotgun_handle = draw_shop_card("shop/explosive_shotgun", "Explosive Shotgun", shop_price(player, 85), shop_shotgun_icon, {0.85, 0.6, 0.35, 1}, player_has_weapon(player, .EXPLOSIVE_SHOTGUN));
    UIK.panel_end();

    UIK.spacer(UIK.pixels(1), UIK.pixels(8));
    shop_gun_row_3 := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(shop_gun_row_3);
    shop_beam_icon := get_asset(Texture_Asset, get_weapon_config(.BEAM_MACHINE).weapon_icon_path);
    shop_blunder_icon := get_asset(Texture_Asset, get_weapon_config(.BLUNDERBUSS).weapon_icon_path);
    shop_beam_handle = draw_shop_card("shop/beam_machine", "Beam Machine", 100, shop_beam_icon, {0.55, 0.7, 0.85, 1}, player_has_weapon(player, .BEAM_MACHINE));
    shop_blunder_handle = draw_shop_card("shop/blunderbuss", "Blunderbuss", 75, shop_blunder_icon, {0.8, 0.55, 0.35, 1}, player_has_weapon(player, .BLUNDERBUSS));
    UIK.panel_end();

    UIK.spacer(UIK.pixels(1), UIK.pixels(10));
    UIK.text("Melee & Traps", UIK.text_title());
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    utility_row := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(utility_row);
    stun_icon := get_asset(Texture_Asset, get_weapon_config(.STUN_GRENADE).weapon_icon_path);
    mine_icon := get_asset(Texture_Asset, get_weapon_config(.LANDMINE).weapon_icon_path);
    stun_handle = draw_shop_card("shop/stun_grenade", "Stun Grenade", STUN_GRENADE_COST, stun_icon, {0.4, 0.75, 0.95, 1}, player_has_weapon(player, .STUN_GRENADE));
    mine_handle = draw_shop_card("shop/landmine", "Landmine", LANDMINE_COST, mine_icon, {0.55, 0.75, 0.45, 1}, player_has_weapon(player, .LANDMINE));
    UIK.panel_end();

    UIK.text("Ammo", UIK.text_title());
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    shop_ammo_row_1 := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(shop_ammo_row_1);
    shop_bullet_icon := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/ammo_icons/bullet.png");
    shop_heavy_icon := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/ammo_icons/cannonball.png");
    shop_explosive_icon := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/ammo_icons/shotgunshell.png");
    bullets_handle = draw_shop_card("shop/buy_bullets", "Buy 10 Bullets", BULLET_COST, shop_bullet_icon, {0.3, 0.7, 0.3, 1}, false);
    heavy_handle = draw_shop_card("shop/buy_heavy", "Buy 10 Heavy/Blunderbuss Ammo", 20, shop_heavy_icon, {0.7, 0.6, 0.35, 1}, false);
    explosive_handle = draw_shop_card("shop/buy_explosive", "Buy 10 Shells", 20, shop_explosive_icon, {0.85, 0.6, 0.35, 1}, false);
    UIK.panel_end();

    UIK.spacer(UIK.pixels(1), UIK.pixels(8));
    shop_ammo_row_2 := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(shop_ammo_row_2);
    shop_energy_icon := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/ammo_icons/energycells.png");
    shop_cryo_icon := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/ammo_icons/cryocell.png");
    shop_water_icon := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/ammo_icons/waterballoon.png");
    energy_handle = draw_shop_card("shop/buy_energy", "Buy 30 Energy Cells", 25, shop_energy_icon, {0.4, 0.75, 0.95, 1}, false);
    cryo_handle = draw_shop_card("shop/buy_cryo", "Buy 30 Cryo Cells", 25, shop_cryo_icon, {0.65, 0.85, 1.0, 1}, false);
    water_handle = draw_shop_card("shop/buy_water", "Buy 10 Water Balloons", 20, shop_water_icon, {0.3, 0.55, 0.9, 1}, false);
    UIK.panel_end();

    UIK.spacer(UIK.pixels(1), UIK.pixels(8));
    shop_ammo_row_3 := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(shop_ammo_row_3);
    shop_sawblade_icon := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/ammo_icons/buzzsaw.png");
    shop_lmg_icon := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/ammo_icons/bullet_alt.png");
    sawblade_handle = draw_shop_card("shop/buy_sawblade", "Buy 10 Sawblades", 30, shop_sawblade_icon, {0.85, 0.7, 0.25, 1}, false);
    lmg_handle = draw_shop_card("shop/buy_lmg", "Buy 30 LMG Rounds", 40, shop_lmg_icon, {0.8, 0.8, 0.5, 1}, false);
    UIK.panel_end();

    UIK.spacer(UIK.pixels(1), UIK.pixels(10));
    UIK.text("Power-ups", UIK.text_title());
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    powerup_row := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(powerup_row);
    dash_icon := get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_1/timer_icon.png");
    inv_icon := get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_1/lock_closed.png");
    dash_handle = draw_shop_card("shop/buy_dash", "Dash", DASH_COST, dash_icon, {0.3, 0.5, 0.9, 1}, player.has_dash);
    invis_handle = draw_shop_card("shop/buy_invisible", "Invisible", INVISIBLE_COST, inv_icon, {0.6, 0.2, 0.8, 1}, player.has_invisible);
    UIK.panel_end();
    powerup_row_2 := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(powerup_row_2);
    speed_boost_handle = draw_shop_card("shop/buy_speed_boost", "Speed Boost", SPEED_BOOST_COST, dash_icon, {0.9, 0.65, 0.2, 1}, false);
    zoom_icon := get_asset(Texture_Asset, "$AO/ui/kit/Icons/_misc/binoculars_icon.png");
    zoom_out_handle = draw_shop_card("shop/buy_zoom_out", "Zoom Out (13s, 7s cd)", ZOOM_OUT_COST, zoom_icon, {0.25, 0.65, 0.85, 1}, player.has_zoom_out);
    UIK.panel_end();

    UIK.spacer(UIK.pixels(1), UIK.pixels(10));
    UIK.text("Gun Skins", UIK.text_title());
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    skin_row := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(skin_row);
    normal_icon := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/weapon_icons/weapon_icons_250x250/assaultrifle.png");
    finger_icon := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/weapon_icons/weapon_icons_250x250/akimbo_pistols.png");
    paper_icon := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/weapon_icons/weapon_icons_250x250/blunderbuss.png");
    normal_handle = draw_shop_card("shop/normal_gun", "Normal Gun", SKIN_COST, normal_icon, {0.5, 0.5, 0.6, 1}, true);
    finger_handle = draw_shop_card("shop/finger_gun", "Finger Gun", SKIN_COST, finger_icon, {0.9, 0.7, 0.2, 1}, player.purchased_finger_gun);
    paper_handle = draw_shop_card("shop/paper_gun", "Paper Gun", SKIN_COST, paper_icon, {0.8, 0.5, 0.2, 1}, player.purchased_paper_gun);
    UIK.panel_end();

    UIK.spacer(UIK.pixels(1), UIK.pixels(12));
    close_row := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(close_row);
    close_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_RED);
    close_desc.panel.width = UIK.flex(1);
    close_desc.panel.height = UIK.pixels(64);
    shop_close_btn = UIK.button("shop/close", "Close", close_desc);
    UIK.panel_end();

    UIK.list_end();
    UIK.panel_end();
    UIK.end();

    if UIK.clicked(exit_handle) || UIK.clicked(shop_close_btn) {
        player.show_shop = false;
    }
    if UIK.clicked(normal_tab) { player.shop_tab_index = 0; }
    if UIK.clicked(fire_shop_handle) && event == 1 { buy_weapon_offer(player, .FIREBALL, 50, "+Fireball"); }
    if UIK.clicked(water_shop_handle) && event == 2 { buy_weapon_offer(player, .WATER_GUN, 30, "+Water Gun"); }
    if UIK.clicked(leaf_shop_handle) && event == 3 { buy_weapon_offer(player, .KILLER_FISH, 60, "+Tree Trap"); }
    if UIK.clicked(ice_shop_handle) && event == 4 { buy_weapon_offer(player, .ICE_LAUNCHER, 85, "+Ice Launcher"); }
    if UIK.clicked(warper_shop_handle) && event == 5 { buy_weapon_offer(player, .WARPER, 1000, "+Black Hole Gun"); }
    if UIK.clicked(lightning_shop_handle) && event == 6 { buy_weapon_offer(player, .RAY_GUN, 90, "+Ray Gun"); }
    if UIK.clicked(sun_armor_handle) && event == 7 { buy_sun_armor(player); }
    if UIK.clicked(sun_tsunami_handle) && event == 7 { buy_weapon_offer(player, .SUN_SHOOTER_TSUNAMI, 120, "+Sun Shooter"); }
    if UIK.clicked(sun_sand_handle) && event == 7 { buy_weapon_offer(player, .SUN_SHOOTER_SAND, 120, "+Sun Shooter"); }
    if UIK.clicked(starter_handle) {
        buy_starter_pack(player);
    }
    if UIK.clicked(murderer_chance_handle) && Economy.can_withdraw_currency(player, "Sparks", 299) {
        Economy.withdraw_currency(player, "Sparks", 299);
        player.play_reward_feedback("Murderer chance increased");
    }
    if UIK.clicked(detective_chance_handle) && Economy.can_withdraw_currency(player, "Sparks", 99) {
        Economy.withdraw_currency(player, "Sparks", 99);
        player.play_reward_feedback("Detective chance increased");
    }
    if UIK.clicked(mystery_bundle_handle) {
        buy_murder_mystery_bundle(player);
    }

    if UIK.clicked(shop_gun_cutter_handle) && !player_has_weapon(player, .MEGA_BLADE) {
        buy_weapon_offer(player, .MEGA_BLADE, GUN_CUTTER_COST, "+Gun Cutter");
    }
    if UIK.clicked(shop_smg_handle) {
        buy_weapon_offer(player, .SUBMACHINE_GUN, 70, "+SMG");
    }
    if UIK.clicked(shop_ray_handle) {
        buy_weapon_offer(player, .RAY_GUN, 90, "+Ray Gun");
    }
    if UIK.clicked(shop_shotgun_handle) {
        buy_weapon_offer(player, .EXPLOSIVE_SHOTGUN, 85, "+Explosive Shotgun");
    }
    if UIK.clicked(shop_beam_handle) {
        buy_weapon_offer(player, .BEAM_MACHINE, 100, "+Beam Machine");
    }
    if UIK.clicked(shop_blunder_handle) {
        buy_weapon_offer(player, .BLUNDERBUSS, 75, "+Blunderbuss");
    }
    if UIK.clicked(stun_handle) {
        buy_weapon_offer(player, .STUN_GRENADE, STUN_GRENADE_COST, "+Stun Grenade");
    }
    if UIK.clicked(mine_handle) {
        buy_weapon_offer(player, .LANDMINE, LANDMINE_COST, "+Landmine");
    }

    if UIK.clicked(armor_handle) {
        buy_armor_offer(player);
    }
    if UIK.clicked(bullets_handle) {
        buy_bullets(player);
    }
    if UIK.clicked(heavy_handle) {
        buy_ammo_offer(player, 1, 10, 20, "+10 Heavy/Blunderbuss Ammo");
    }
    if UIK.clicked(explosive_handle) {
        buy_ammo_offer(player, 2, 10, 20, "+10 Shells");
    }
    if UIK.clicked(energy_handle) {
        buy_ammo_offer(player, 5, 30, 25, "+30 Energy Cells");
    }
    if UIK.clicked(cryo_handle) {
        buy_ammo_offer(player, 3, 30, 25, "+30 Cryo Cells");
    }
    if UIK.clicked(water_handle) {
        buy_ammo_offer(player, 9, 10, 20, "+10 Water Balloons");
    }
    if UIK.clicked(sawblade_handle) {
        buy_ammo_offer(player, 7, 10, 30, "+10 Sawblades");
    }
    if UIK.clicked(lmg_handle) {
        buy_ammo_offer(player, 8, 30, 40, "+30 LMG Rounds");
    }

    if UIK.clicked(dash_handle) && !player.has_dash {
        if spend_coins(player, DASH_COST) {
            player.has_dash = true;
            play_pickup_feedback(player, "+Dash");
            if player.is_local() {
                sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/equip_gun.wav");
                d := SFX.default_sfx_desc();
                d.volume = 0.6;
                SFX.play(sfx, d);
            }
        }
    }

    if UIK.clicked(invis_handle) && !player.has_invisible {
        if spend_coins(player, INVISIBLE_COST) {
            player.has_invisible = true;
            player.powerup_invisible_active = true;
            effect := new(Invisible_Effect);
            player.entity.add_passive_effect(effect);
            player.show_shop = false;
            play_pickup_feedback(player, "+Invisible");
            if player.is_local() {
                sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/equip_gun.wav");
                d := SFX.default_sfx_desc();
                d.volume = 0.6;
                SFX.play(sfx, d);
            }
        }
    }

    if UIK.clicked(speed_boost_handle) && spend_coins(player, SPEED_BOOST_COST) {
        player.has_speed_boost = true;
        // Each purchase also applies a stack immediately
        player.entity.add_passive_effect(new(Speed_Boost_Effect));
        play_pickup_feedback(player, "+Speed Boost");
        if player.is_local() {
            sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/equip_gun.wav");
            d := SFX.default_sfx_desc();
            d.volume = 0.6;
            SFX.play(sfx, d);
        }
    }

    if UIK.clicked(zoom_out_handle) && !player.has_zoom_out {
        if spend_coins(player, ZOOM_OUT_COST) {
            player.has_zoom_out = true;
            play_pickup_feedback(player, "+Zoom Out");
            if player.is_local() {
                sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/equip_gun.wav");
                d := SFX.default_sfx_desc();
                d.volume = 0.6;
                SFX.play(sfx, d);
            }
        }
    }

    if UIK.clicked(finger_handle) && !player.purchased_finger_gun {
        if spend_coins(player, SKIN_COST) {
            player.purchased_finger_gun = true;
            give_weapon(.AKIMBO_PISTOLS, player.default_inventory);
            play_pickup_feedback(player, "+Akimbo");
            heavy := Items.create_item_instance(g_ammo_item_defs[1], 30);
            will_destroy: bool;
            if Items.can_move_item_to_inventory(heavy, player.default_inventory, ref will_destroy) {
                Items.move_item_to_inventory(heavy, player.default_inventory);
            } else {
                Items.destroy_item_instance(heavy);
            }
        }
    }

    if UIK.clicked(paper_handle) && !player.purchased_paper_gun {
        if spend_coins(player, SKIN_COST) {
            player.purchased_paper_gun = true;
            give_weapon(.BLUNDERBUSS, player.default_inventory);
            play_pickup_feedback(player, "+Blunderbuss");
            heavy := Items.create_item_instance(g_ammo_item_defs[1], 30);
            will_destroy: bool;
            if Items.can_move_item_to_inventory(heavy, player.default_inventory, ref will_destroy) {
                Items.move_item_to_inventory(heavy, player.default_inventory);
            } else {
                Items.destroy_item_instance(heavy);
            }
        }
    }

}

draw_admin_shop :: proc(player: Player) {
    if !can_access_admin_panel(player) {
        player.show_admin_shop = false;
        return;
    }

    UIK.begin(UIK.modal(UIK.rect_window(), 15));

    shell := UIK.panel_modal(.BLACK);
    shell.gap = 0;
    UIK.panel_begin(shell);

    title_desc := UIK.title_area_desc("Admin Shop");
    title_desc.icon = get_asset(Texture_Asset, "$AO/ui/kit/Icons/shopping_cart/shopping_cart_icon.png");
    exit_handle := UIK.title_area(title_desc);

    content := UIK.layout_column();
    content.width = UIK.flex(1);
    content.height = UIK.flex(1);
    content.padding = v4{12, 16, 12, 16};
    content.gap = 8;
    UIK.list_begin("admin_shop_scroll", content);

    UIK.text("Weapons", UIK.text_title());
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    weapon_row_1 := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(weapon_row_1);
    hydro_icon := get_asset(Texture_Asset, get_weapon_config(.HYDRO_CANNON).weapon_icon_path);
    boom_icon := get_asset(Texture_Asset, get_weapon_config(.BOOMWHEEL).weapon_icon_path);
    void_icon := get_asset(Texture_Asset, get_weapon_config(.VOID_SPLITTER).weapon_icon_path);
    hydro_btn := draw_shop_card("admin_shop/hydro_cannon", "Hydro Cannon", ADMIN_SHOP_GUN_COST, hydro_icon, {0.35, 0.75, 0.9, 1}, player_has_weapon(player, .HYDRO_CANNON));
    boom_btn := draw_shop_card("admin_shop/boomwheel", "Boomwheel", ADMIN_SHOP_GUN_COST, boom_icon, {0.9, 0.6, 0.25, 1}, player_has_weapon(player, .BOOMWHEEL));
    void_btn := draw_shop_card("admin_shop/void_splitter", "Void Splitter", ADMIN_SHOP_GUN_COST, void_icon, {0.65, 0.55, 0.95, 1}, player_has_weapon(player, .VOID_SPLITTER));
    UIK.panel_end();

    UIK.spacer(UIK.pixels(1), UIK.pixels(8));
    weapon_row_2 := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(weapon_row_2);
    storm_icon := get_asset(Texture_Asset, get_weapon_config(.STORMS_EYE).weapon_icon_path);
    sniper_icon := get_asset(Texture_Asset, get_weapon_config(.SNIPER).weapon_icon_path);
    rpg_icon := get_asset(Texture_Asset, get_weapon_config(.WATER_BALLOON_RPG).weapon_icon_path);
    storm_btn := draw_shop_card("admin_shop/storms_eye", "Storm's Eye", ADMIN_SHOP_GUN_COST, storm_icon, {0.5, 0.8, 0.9, 1}, player_has_weapon(player, .STORMS_EYE));
    sniper_btn := draw_shop_card("admin_shop/sniper", "Sniper", ADMIN_SHOP_GUN_COST, sniper_icon, {0.15, 0.2, 0.35, 1}, player_has_weapon(player, .SNIPER));
    rpg_btn := draw_shop_card("admin_shop/rpg", "RPG", ADMIN_SHOP_GUN_COST, rpg_icon, {0.85, 0.55, 0.25, 1}, player_has_weapon(player, .WATER_BALLOON_RPG));
    UIK.panel_end();

    UIK.spacer(UIK.pixels(1), UIK.pixels(8));
    weapon_row_3 := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(weapon_row_3);
    minigun_icon := get_asset(Texture_Asset, get_weapon_config(.GATLING_GUN).weapon_icon_path);
    minigun_btn := draw_shop_card("admin_shop/minigun", "Minigun", ADMIN_SHOP_GUN_COST, minigun_icon, {0.6, 0.6, 0.7, 1}, player_has_weapon(player, .GATLING_GUN));
    UIK.panel_end();

    UIK.spacer(UIK.pixels(1), UIK.pixels(8));
    UIK.text("Ammo", UIK.text_title());
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    ammo_row_1 := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(ammo_row_1);
    water_ammo_icon := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/ammo_icons/waterballoon.png");
    heavy_ammo_icon := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/ammo_icons/cannonball.png");
    lmg_ammo_icon := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/ammo_icons/bullet_alt.png");
    water_ammo_btn := draw_shop_card("admin_shop/water_ammo", "Water Balloons", 0, water_ammo_icon, {0.35, 0.55, 0.9, 1}, false);
    heavy_ammo_btn := draw_shop_card("admin_shop/heavy_ammo", "Heavy/Blunderbuss Ammo", 0, heavy_ammo_icon, {0.7, 0.6, 0.35, 1}, false);
    lmg_ammo_btn := draw_shop_card("admin_shop/lmg_ammo", "LMG Rounds", 0, lmg_ammo_icon, {0.8, 0.8, 0.5, 1}, false);
    UIK.panel_end();

    UIK.spacer(UIK.pixels(1), UIK.pixels(8));
    ammo_row_2 := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(ammo_row_2);
    tornado_ammo_icon := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/ammo_icons/tornadoshot.png");
    bullet_ammo_icon := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/ammo_icons/bullet.png");
    tornado_ammo_btn := draw_shop_card("admin_shop/tornado_ammo", "Tornado Ammo", 0, tornado_ammo_icon, {0.85, 0.65, 0.3, 1}, false);
    bullet_ammo_btn := draw_shop_card("admin_shop/bullet_ammo", "Normal Bullets", 0, bullet_ammo_icon, {0.3, 0.7, 0.3, 1}, false);
    UIK.panel_end();

    UIK.spacer(UIK.pixels(1), UIK.pixels(8));
    close_row := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(close_row);
    close_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_RED);
    close_desc.panel.width = UIK.flex(1);
    close_desc.panel.height = UIK.pixels(52);
    close_btn := UIK.button("admin_shop/close", "Close", close_desc);
    UIK.panel_end();

    UIK.list_end();
    UIK.panel_end();
    UIK.end();

    if UIK.clicked(exit_handle) || UIK.clicked(close_btn) {
        player.show_admin_shop = false;
    }

    if UIK.clicked(void_btn) {
        buy_weapon_offer(player, .VOID_SPLITTER, ADMIN_SHOP_GUN_COST, "+Void Splitter");
    }
    if UIK.clicked(storm_btn) {
        buy_weapon_offer(player, .STORMS_EYE, ADMIN_SHOP_GUN_COST, "+Storm's Eye");
    }
    if UIK.clicked(boom_btn) {
        buy_weapon_offer(player, .BOOMWHEEL, ADMIN_SHOP_GUN_COST, "+Boomwheel");
    }
    if UIK.clicked(hydro_btn) {
        buy_weapon_offer(player, .HYDRO_CANNON, ADMIN_SHOP_GUN_COST, "+Hydro Cannon");
    }
    if UIK.clicked(heavy_ammo_btn) {
        grant_admin_ammo_offer(player, 1, 10, "+10 Heavy/Blunderbuss Ammo");
    }
    if UIK.clicked(tornado_ammo_btn) {
        grant_admin_ammo_offer(player, 4, 10, "+10 Tornado Shots");
    }
    if UIK.clicked(water_ammo_btn) {
        grant_admin_ammo_offer(player, 9, 10, "+10 Water Balloons");
    }
    if UIK.clicked(lmg_ammo_btn) {
        grant_admin_ammo_offer(player, 8, 30, "+30 LMG Rounds");
    }
    if UIK.clicked(bullet_ammo_btn) {
        grant_admin_ammo_offer(player, 0, 30, "+30 Normal Bullets");
    }
    if UIK.clicked(sniper_btn) {
        buy_weapon_offer(player, .SNIPER, ADMIN_SHOP_GUN_COST, "+Sniper");
    }
    if UIK.clicked(rpg_btn) {
        buy_weapon_offer(player, .WATER_BALLOON_RPG, ADMIN_SHOP_GUN_COST, "+RPG");
    }
    if UIK.clicked(minigun_btn) {
        buy_weapon_offer(player, .GATLING_GUN, ADMIN_SHOP_GUN_COST, "+Minigun");
    }
}

admin_spawn_tripmine_test_only :: proc(player: Player) {
    if player == null {
        return;
    }

    mine_pos := v2{player.entity.world_position.x + 3.0, player.entity.world_position.y};
    spawn_subspace_tripmine(mine_pos, player.entity.id, 90.0);
}

admin_spawn_tripmine_test_trigger :: proc(player: Player) {
    if player == null {
        return;
    }

    mine_pos := v2{player.entity.world_position.x + 3.0, player.entity.world_position.y};
    spawn_subspace_tripmine(mine_pos, player.entity.id, 90.0);

    for other: component_iterator(Player) {
        if other.entity.id == player.entity.id || other.is_dead {
            continue;
        }

        other.entity.set_local_position({mine_pos.x + 0.6, mine_pos.y});
        other.entity.mark_teleported();
        break;
    }
}

admin_apply_invisible_test :: proc(player: Player) {
    if player == null {
        return;
    }

    player.has_invisible = true;
    player.powerup_invisible_active = true;
    effect := new(Invisible_Effect);
    player.entity.add_passive_effect(effect);
}

draw_admin_panel :: proc(player: Player) {
    if !can_access_admin_panel(player) return;

    UIK.begin(UIK.modal(UIK.rect_window(), 15));

    shell := UIK.panel_modal(.BLACK);
    shell.gap = 0;
    UIK.panel_begin(shell);

    title_desc := UIK.title_area_desc("Admin");
    title_desc.icon = get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_1/timer_icon.png");
    exit_handle := UIK.title_area(title_desc);

    body := UIK.layout_column();
    body.width = UIK.flex(1);
    body.height = UIK.flex(1);
    body.padding = v4{12, 16, 12, 16};
    body.gap = 8;
    UIK.list_begin("admin/body_scroll", body);

    if player.admin_target_username == "" {
        player.admin_target_username = player.get_username();
    }

    UIK.text("Manage players", UIK.text_title());
    UIK.text(format_string("Target: %", {player.admin_target_username}), UIK.text_body());
    UIK.text(format_string("Coins: %", {player.admin_grant_amount}), UIK.text_body());
    UIK.text(format_string("Ban duration: % seconds", {player.admin_grant_amount}), UIK.text_body());

    UIK.spacer(UIK.pixels(1), UIK.pixels(6));
    minigames_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREEN);
    minigames_desc.panel.width = UIK.flex(1);
    minigames_desc.panel.height = UIK.pixels(58);
    minigames_btn := UIK.button("admin/start_minigames", "Start MiniGames", minigames_desc);
    UIK.text("Choose Capture the Flag, assign players to teams, and start.", UIK.text_body());

    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    unban_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_YELLOW);
    unban_desc.panel.width = UIK.flex(1);
    unban_desc.panel.height = UIK.pixels(52);
    unban_btn := UIK.button("admin/unban", "Unban User", unban_desc);

    UIK.spacer(UIK.pixels(1), UIK.pixels(2));
    target_scroll := UIK.layout_column();
    target_scroll.width = UIK.flex(1);
    target_scroll.height = UIK.pixels(170);
    target_scroll.gap = 4;
    UIK.list_begin("admin/targets", target_scroll);

    target_usernames: [..]string;
    target_handles: [..]Interact_Result;
    for target: component_iterator(Player) {
        username := target.get_username();
        target_usernames.append(username);

        row_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREY);
        if username == player.admin_target_username {
            row_desc = UIK.widget_desc_button_auto_default(.BUTTON_BASIC_YELLOW);
        }
        row_desc.panel.width = UIK.flex(1);
        row_desc.panel.height = UIK.pixels(44);
        target_handles.append(UIK.button(format_string("admin/target/%", {username}), username, row_desc));
    }

    if target_usernames.count == 0 {
        UIK.text("No players online", UIK.text_body());
    }

    UIK.list_end();

    UIK.spacer(UIK.pixels(1), UIK.pixels(8));
    UIK.text("Special Maps", UIK.text_title());
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    special_map_row := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
    UIK.panel_begin(special_map_row);
    backrooms_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_PURPLE);
    backrooms_desc.panel.width = UIK.flex(1);
    backrooms_desc.panel.height = UIK.pixels(52);
    backrooms_btn := UIK.button("admin/map_backrooms", "Send to Backrooms", backrooms_desc);
    normal_map_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREEN);
    normal_map_desc.panel.width = UIK.flex(1);
    normal_map_desc.panel.height = UIK.pixels(52);
    normal_map_btn := UIK.button("admin/map_normal", "Return to Normal Map", normal_map_desc);
    UIK.panel_end();

    admin_target := find_online_player_by_username(player.admin_target_username);
    if admin_target == null {
