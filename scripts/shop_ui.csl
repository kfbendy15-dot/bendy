    if UIK.clicked(exit_handle) || UIK.clicked(close_btn) {
        player.show_admin_panel = false;
    }

    if target_usernames.count > 0 {
        for i: 0..target_usernames.count - 1 {
            if UIK.clicked(target_handles[i]) {
                player.admin_target_username = target_usernames[i];
            }
        }
    }

    if UIK.clicked(amt10_btn) {
        player.admin_grant_amount = 10;
    }
    if UIK.clicked(amt25_btn) {
        player.admin_grant_amount = 25;
    }
    if UIK.clicked(amt50_btn) {
        player.admin_grant_amount = 50;
    }
    if UIK.clicked(amt100_btn) {
        player.admin_grant_amount = 100;
    }
    if UIK.clicked(amt250_btn) {
        player.admin_grant_amount = 250;
    }

    if UIK.clicked(grant_admin_btn) {
        grant_admin_permission(player.admin_target_username);
        player.play_reward_feedback(format_string("Admin +%", {player.admin_target_username}));
    }

    if UIK.clicked(revoke_admin_btn) {
        revoke_admin_permission(player.admin_target_username);
        player.play_reward_feedback(format_string("Admin -%", {player.admin_target_username}));
    }

    if UIK.clicked(grant_coins_btn) {
        if grant_coins_to_username(admin_target.get_username(), player.admin_grant_amount) {
            player.play_reward_feedback(format_string("+% to %", {player.admin_grant_amount, admin_target.get_username()}));
        } else {
            player.play_reward_feedback("Target not found");
        }
    }

    if UIK.clicked(kick_btn) {
        if admin_target == null || admin_target == player {
            player.play_reward_feedback("Choose another player");
        } else {
            moderation_kick(player, admin_target, "Admin panel action");
            player.play_reward_feedback(format_string("Kicked %", {admin_target.get_username()}));
        }
    }

    if UIK.clicked(ban_btn) {
        if admin_target == null || admin_target == player {
            player.play_reward_feedback("Choose another player");
        } else if player.admin_grant_amount <= 0 {
            player.play_reward_feedback("Choose a ban duration");
        } else {
            moderation_ban(player, admin_target, player.admin_grant_amount, "Admin panel action");
            player.play_reward_feedback(format_string("Banned %", {admin_target.get_username()}));
        }
    }

    if UIK.clicked(summon_btn) {
        spawn_paperclips_boss();
        player.play_reward_feedback("Paperclips approaches!");
    }

    if UIK.clicked(meteor_btn) {
        spawn_meteor_boss();
        player.play_reward_feedback("Meteor incoming!");
    }

    if UIK.clicked(fun_btn) {
        toggle_fun_mode();
    }

    if UIK.clicked(mimicer_btn) {
        grant_mimicer_mode(player);
        player.show_admin_panel = false;
    }
    if UIK.clicked(heal_btn) {
        fully_heal_player(admin_target);
    }

    if UIK.clicked(inv_btn) {
        set_player_invincible(admin_target, true);
        admin_target.play_reward_feedback("Invincible");
    }

    if UIK.clicked(stealth_btn) {
        set_player_invisible(admin_target, !admin_target.admin_invisible_active);
        if admin_target.admin_invisible_active {
            admin_target.play_reward_feedback("Invisible on");
        } else {
            admin_target.play_reward_feedback("Invisible off");
        }
    }

    if UIK.clicked(noclip_btn) {
        set_player_noclip(admin_target, !admin_target.is_admin_noclip);
        if admin_target.is_admin_noclip {
            admin_target.play_reward_feedback("Noclip on");
        } else {
            admin_target.play_reward_feedback("Noclip off");
        }
    }

    if UIK.clicked(grass_btn) {
        set_admin_map_destination(admin_target, "grass", {-24, -14}, "Grass Map");
    }
    if UIK.clicked(sand_btn) {
        set_admin_map_destination(admin_target, "sand", {0, -14}, "Sand Map");
    }
    if UIK.clicked(lava_btn) {
        set_admin_map_destination(admin_target, "lava", {24, -14}, "Lava Map");
    }
    if UIK.clicked(ice_btn) {
        set_admin_map_destination(admin_target, "ice", {0, 14}, "Ice Map");
    }
    if UIK.clicked(island_btn) {
        set_admin_map_destination(admin_target, "island", {24, 14}, "Island Map");
    }
    if UIK.clicked(backrooms_btn) {
        send_player_to_backrooms(admin_target);
    }
    if UIK.clicked(normal_map_btn) {
        return_player_from_backrooms(admin_target);
    }

    if UIK.clicked(ar_btn) {
        grant_weapon_with_ammo(admin_target, .ASSAULT_RIFLE, get_weapon_config(.ASSAULT_RIFLE).ammo_first_pickup);
    }
    if UIK.clicked(smg_btn) {
        grant_weapon_with_ammo(admin_target, .SUBMACHINE_GUN, get_weapon_config(.SUBMACHINE_GUN).ammo_first_pickup);
    }
    if UIK.clicked(gatling_btn) {
        grant_weapon_with_ammo(admin_target, .GATLING_GUN, get_weapon_config(.GATLING_GUN).ammo_first_pickup);
    }
    if UIK.clicked(shotgun_btn) {
        grant_weapon_with_ammo(admin_target, .EXPLOSIVE_SHOTGUN, get_weapon_config(.EXPLOSIVE_SHOTGUN).ammo_first_pickup);
    }
    if UIK.clicked(ray_btn) {
        grant_weapon_with_ammo(admin_target, .RAY_GUN, get_weapon_config(.RAY_GUN).ammo_first_pickup);
    }
    if UIK.clicked(hydro_btn) {
        grant_weapon_with_ammo(admin_target, .HYDRO_CANNON, get_weapon_config(.HYDRO_CANNON).ammo_first_pickup);
    }
    if UIK.clicked(beam_btn) {
        grant_weapon_with_ammo(admin_target, .BEAM_MACHINE, get_weapon_config(.BEAM_MACHINE).ammo_first_pickup);
    }
    if UIK.clicked(water_btn) {
        grant_weapon_with_ammo(admin_target, .WATER_GUN, get_weapon_config(.WATER_GUN).ammo_first_pickup);
    }
    if UIK.clicked(missile_btn) {
        grant_weapon_with_ammo(admin_target, .MISSILE_BARRAGE, get_weapon_config(.MISSILE_BARRAGE).ammo_first_pickup);
    }
    if UIK.clicked(blunder_btn) {
        grant_weapon_with_ammo(admin_target, .BLUNDERBUSS, get_weapon_config(.BLUNDERBUSS).ammo_first_pickup);
    }
    if UIK.clicked(plasma_btn) {
        grant_weapon_with_ammo(admin_target, .PLASMA_BURST, get_weapon_config(.PLASMA_BURST).ammo_first_pickup);
    }
    if UIK.clicked(boom_btn) {
        grant_weapon_with_ammo(admin_target, .BOOMWHEEL, get_weapon_config(.BOOMWHEEL).ammo_first_pickup);
    }

    if UIK.clicked(test_tripmine_spawn_btn) {
        admin_spawn_tripmine_test_only(admin_target);
    }
    if UIK.clicked(test_tripmine_trigger_btn) {
        admin_spawn_tripmine_test_trigger(admin_target);
    }
    if UIK.clicked(test_invisible_btn) {
        admin_apply_invisible_test(admin_target);
    }

}
