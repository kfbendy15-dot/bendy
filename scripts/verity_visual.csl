// Synced sprite children, ownership resolved by stable user id.
Verity_Visual :: class : Component {
    owner_user_id: string;
    morph_kind: s64;
    ao_start :: method() {
        if morph_kind == 4 {
            a := entity.add_component(Spine_Animator);
            a.set_skeleton(get_asset(Spine_Asset, "$AO/streamed_character"));
            a.disable_all_skins(); a.enable_skin("base/crewchsia");
            a.enable_skin("body/dino_suit"); a.enable_skin("hat/cooking_pan"); a.enable_skin("face/cute_eyes");
            a.refresh_skins(); a.color = {1.2, 1, 0.2, 1};
            a.set_animation("Idle", true, 0);
            entity.set_local_scale({0.9, 0.9});
            return;
        }
        texture := get_asset(Texture_Asset, reference_morph_path(morph_kind));
        sprite := entity.add_component(Sprite_Renderer);
        sprite.set_texture(texture); sprite.layer = 0;
        height := morph_kind == 3 ? 2.1 : 1.7;
        sprite.depth_offset = -height * 0.43;
        scale := height / max(texture.get_world_size().y, 0.01);
        entity.set_local_scale({scale, scale});
        entity.set_local_position({0, height * 0.43});
    }
    ao_update :: method(dt: float) {
        p := find_online_player_by_user_id(owner_user_id);
        if !#alive(p) || p.troll_reference_morph != morph_kind { entity.destroy(); return; }
    }
}
reference_morph_path :: proc(kind: s64) -> string {
    if kind == 7 { return "pileo.png"; }
    if kind == 5 { return "kingofbilly/falsity.png"; }
    if kind == 6 { return "kingofbilly/kingofbilly.png"; }
    if kind == 2 { return "mrlovebraids/lovity.png"; }
    if kind == 3 { return "mrlovebraids/mrlovebraids_marcat.png"; }
    return "mrlovebraids/verity.png";
}
reference_morph_name :: proc(kind: s64) -> string {
    if kind == 7 { return "Pileo"; }
    if kind == 5 { return "Falsity"; }
    if kind == 6 { return "Kingofbilly"; }
    if kind == 4 { return "Paperclips"; }
    if kind == 2 { return "Lovity"; }
    if kind == 3 { return "Mrlovebraids & Lily"; }
    return "Verity";
}
update_verity_visual :: proc(p: Player) {
    if p.troll_reference_morph == 0 { return; }
    if #alive(p.animator) { p.animator.set_tint({1, 1, 1, 0}); }
    for visual: component_iterator(Verity_Visual) {
        if visual.owner_user_id == p.get_user_id() && visual.morph_kind == p.troll_reference_morph { return; }
    }
    e := Scene.create_entity(); e.set_name(reference_morph_name(p.troll_reference_morph) + " Morph");
    e.set_parent(p.entity, false);
    e.add_component(Verity_Visual, on_before_start=proc(visual: Verity_Visual) {
        visual.owner_user_id = p.get_user_id(); visual.morph_kind = p.troll_reference_morph;
    });
}
troll_do_reference_morph :: proc(admin: Player, target: Player, kind: s64) -> bool {
    if !can_access_troll_panel(admin) || !#alive(target) || kind < 1 || kind > 7 { return false; }
    if target.troll_morph_active { admin.play_reward_feedback("Already transformed"); return false; }
    troll_save_morph_original(target);
    target.troll_morph_active = true; target.troll_reference_morph = kind;
    target.troll_verity_active = kind == 1;
    target.add_invisibility_reason("troll_morph_hide_player");
    target.set_name_override(reference_morph_name(kind)); target.do_name_color_override = true;
    target.name_color_override = kind == 1 ? v4{1, 0.88, 0.1, 1} : v4{1, 0.25, 0.8, 1};
    target.user_tag = ""; target.show_vip_crown = false;
    update_verity_visual(target); adventure_sound(target.entity);
    target.play_reward_feedback(reference_morph_name(kind));
    Save.set_string(admin, "ui_test_troll_morph_name", reference_morph_name(kind));
    return true;
}
troll_do_verity :: proc(admin: Player, target: Player) -> bool { return troll_do_reference_morph(admin, target, 1); }
