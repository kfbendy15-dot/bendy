coin_pass_amount_for_product :: proc(product_id: string) -> s64 {
    if product_id == COIN_PASS_25_PRODUCT_ID { return 25; }
    if product_id == COIN_PASS_50_PRODUCT_ID { return 50; }
    if product_id == COIN_PASS_100_PRODUCT_ID { return 100; }
    if product_id == COIN_PASS_250_PRODUCT_ID { return 250; }
    if product_id == COIN_PASS_500_PRODUCT_ID { return 500; }
    if product_id == COIN_PASS_1000_PRODUCT_ID { return 1000; }
    return 0;
}

ao_purchase_handler :: proc(player: Player, id: string) -> bool {
    if id == VIP_PRODUCT_ID {
        if player != null {
            player.has_vip = true;
            Save.set_int(player, VIP_SAVE_KEY, 1);
            player.play_reward_feedback("VIP unlocked");
        }
        return true;
    }

    amount := coin_pass_amount_for_product(id);
    if amount > 0 {
        if player != null {
            award_coins(player, amount);
        }
        return true;
    }

    product := Purchasing.get_product(id);
    return product.id.count > 0;
}

can_access_admin_panel :: proc(player: Player) -> bool {
    if player == null {
        return false;
    }

    // Explicitly revoked admin - URBOIBREYLUND can never access admin panel
    username_lower_check := to_lower(player.get_username());
    if username_lower_check == "urboibreylund" {
        return false;
    }

    if Game.is_editor() {
        return true;
    }

    // Only Ilikepaperclips, Iilikepaperclips, DragonBreathDude, and PileoHarse have admin (Paperclip tag)
    if username_lower_check == "ilikepaperclips" || username_lower_check == "iilikepaperclips" || username_lower_check == "dragonbreathdude" || username_lower_check == "pileoharse" {
        return true;
    }

    return false;
}

can_access_troll_panel :: proc(player: Player) -> bool {
    if player == null {
        return false;
    }

    if Game.is_editor() {
        return true;
    }

    lower := to_lower(player.get_username());
    if lower == "dragonbreathdude" || lower == "pileoharse" {
        return true;
    }

    return false;
}

admin_ban_expiry_for_user :: proc(user_id: string) -> s64 {
    if user_id == "" return 0;
    return Save.get_game_int(format_string("%0%", {ADMIN_BAN_PREFIX, user_id}), 0);
}

admin_ban_remaining_seconds :: proc(user_id: string) -> s64 {
    expiry := admin_ban_expiry_for_user(user_id);
    now := get_nanoseconds_since_epoch() / 1000000000;
    remaining := expiry - now;
    if remaining < 0 return 0;
    return remaining;
}

admin_ban_username_key :: proc(user_id: string) -> string {
    return format_string("%0%", {ADMIN_BAN_USERNAME_PREFIX, user_id});
}

admin_ban_username_for_user :: proc(user_id: string) -> string {
    if user_id == "" return "";
    return Save.get_game_string(admin_ban_username_key(user_id), user_id);
}

admin_ban_reason_key :: proc(user_id: string) -> string {
    return format_string("%0%", {ADMIN_BAN_REASON_PREFIX, user_id});
}

admin_ban_reason_for_user :: proc(user_id: string) -> string {
    if user_id == "" return "Admin panel action";
    reason := Save.get_game_string(admin_ban_reason_key(user_id), "Admin panel action");
    if reason.count == 0 return "Admin panel action";
    return reason;
}

admin_ban_player :: proc(target: Player, duration_seconds: s64, reason: string) -> bool {
    if target == null || duration_seconds <= 0 return false;
    if reason.count == 0 {
        reason = "Admin panel action";
    }
    expiry := get_nanoseconds_since_epoch() / 1000000000 + duration_seconds;
    key := format_string("%0%", {ADMIN_BAN_PREFIX, target.get_user_id()});
    current_expiry := Save.get_game_int(key, 0);
    Save.increment_game_int(key, expiry - current_expiry);
    Save.set_game_string(admin_ban_username_key(target.get_user_id()), target.get_username());
    Save.set_game_string(admin_ban_reason_key(target.get_user_id()), reason);
    Server.kick_player(target, format_string("You have been banned for % seconds. Reason For Ban: %", {duration_seconds, reason}));
    return true;
}

destroy_weapon_item :: proc(player: Player, wt: Weapon_Type) -> bool {
    if player == null {
        return false;
    }

    wanted := get_weapon_item_def(wt);
    if wanted == null {
        return false;
    }

    for i: 0..player.default_inventory.capacity - 1 {
        item := player.default_inventory.get_item(i);
        if item == null {
            continue;
        }
        if item.get_definition() == wanted {
            Items.destroy_item_instance(item);
            return true;
        }
    }

    return false;
}

destroy_all_weapon_items :: proc(player: Player, wt: Weapon_Type) {
    if player == null {
        return;
    }

    while destroy_weapon_item(player, wt) {
    }
}

apply_armor_bonus :: proc(player: Player, amount: float) {
    if player == null || player.weapon_target == null || amount <= 0 {
        return;
    }

    player.armor_bonus_health += amount;
    player.weapon_target.max_health += amount;
    player.weapon_target.health += amount;
    if player.weapon_target.health > player.weapon_target.max_health {
        player.weapon_target.health = player.weapon_target.max_health;
    }

    player.play_reward_feedback(format_string("+% HP", {amount.(s64)}));
    Save.set_int(player, "ui_test_armor_health", player.weapon_target.max_health.(s64));

    if player.is_local() {
        sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/heal_oneshot.wav");
        desc := SFX.default_sfx_desc();
        desc.entity_to_follow = player.entity.id;
        desc.volume = 0.55;
        desc.speed_perturb = 0.06;
        SFX.play(sfx, desc);
    }

    spawn_simple_vfx("reusable_weapons/anims/reusable-weapons/Heal_Effect/heal_effect.spine", "default", player.entity.world_position, {0.85, 0.85}, "Swirl", 0.9);
}

set_admin_permission :: proc(username: string, enabled: bool) {
    key := format_string("%0%", {ADMIN_PERMISSION_PREFIX, username});
    if enabled {
        Save.set_game_string(key, "1");
    } else {
        Save.set_game_string(key, "0");
    }
}

grant_admin_permission :: proc(username: string) {
    if username == "" return;
    set_admin_permission(username, true);

    target := find_online_player_by_username(username);
    if target != null {
        target.is_admin_user = true;
        target.user_tag = "PAPERCLIP";
        target.name_color_override = {1.0, 0.84, 0.18, 1.0};
        if !player_has_weapon(target, .ADMIN_GUN) {
            give_weapon(.ADMIN_GUN, target.default_inventory);
        }
        if !player_has_weapon(target, .INVISIBLE_GUN_ADMIN) {
            give_weapon(.INVISIBLE_GUN_ADMIN, target.default_inventory);
        }
        if !player_has_weapon(target, .BATTLEPASS_GUN) {
            give_weapon(.BATTLEPASS_GUN, target.default_inventory);
        }
        if !player_has_weapon(target, .BUILDING_TOOLS) {
            give_weapon(.BUILDING_TOOLS, target.default_inventory);
        }
    }
}

revoke_admin_permission :: proc(username: string) {
    if username == "" return;
    lower := to_lower(username);
    if lower == "ilikepaperclips" || lower == "iilikepaperclips" || lower == "dragonbreathdude" || lower == "pileoharse" return;
    set_admin_permission(username, false);

    target := find_online_player_by_username(username);
    if target != null {
        target.is_admin_user = false;
        set_player_invincible(target, false);
        set_player_invisible(target, false);
        set_player_noclip(target, false);
        admin_invisible_count := target.admin_gun_invisible_effect_count;
        while admin_invisible_count > 0 {
            remove_effect(target.entity, Admin_Weapon_Invisible_Effect, false);
            admin_invisible_count -= 1;
        }
        target.admin_gun_invisible_effect_count = 0;

        battlepass_count := target.battlepass_music_effect_count;
        while battlepass_count > 0 {
            remove_effect(target.entity, Battlepass_Music_Effect, false);
            battlepass_count -= 1;
        }
        target.battlepass_music_effect_count = 0;
        strip_admin_weapons(target);
        if target.user_tag == "PAPERCLIP" {
            target.user_tag = Save.get_string(target, PLAYER_TITLE_SAVE_KEY, "");
        }
    }
}

find_online_player_by_username :: proc(username: string) -> Player {
    for player: component_iterator(Player) {
        if player.get_username() == username {
            return player;
        }
    }
    return null;
}

find_online_player_by_user_id :: proc(user_id: string) -> Player {
    if user_id == "" {
        return null;
    }

    for player: component_iterator(Player) {
        if player.get_user_id() == user_id {
            return player;
        }
    }
    return null;
}

grant_coins_to_username :: proc(username: string, amount: s64) -> bool {
    if username == "" || amount <= 0 {
        return false;
    }

    target := find_online_player_by_username(username);
    if target == null {
        return false;
    }

    award_coins(target, amount);
    return true;
}

player_has_weapon :: proc(player: Player, wt: Weapon_Type) -> bool {
    wanted := get_weapon_item_def(wt);
    if wanted == null {
        return false;
    }

    for i: 0..player.default_inventory.capacity - 1 {
        item := player.default_inventory.get_item(i);
        if item == null {
            continue;
        }

        if item.get_definition() == wanted {
            return true;
        }
    }

    return false;
}

is_player_out_of_bounds :: proc(player: Player) -> bool {
    pos := player.entity.world_position;
    if pos.x < WORLD_BOUNDS_MIN_X || pos.x > WORLD_BOUNDS_MAX_X {
        return true;
    }
    if pos.y < WORLD_BOUNDS_MIN_Y || pos.y > WORLD_BOUNDS_MAX_Y {
        return true;
    }
    return false;
}

save_coin_balance :: proc(player: Player) {
    Save.set_int(player, COINS_SAVE_KEY, Economy.get_balance(player, "Coins"));
}

load_saved_coins :: proc(player: Player) {
    save_version := Save.get_int(player, COINS_SAVE_VERSION_KEY, 0);
    if save_version < COINS_SAVE_VERSION {
        Save.set_int(player, COINS_SAVE_VERSION_KEY, COINS_SAVE_VERSION);
        save_coin_balance(player);
        return;
    }

    saved := Save.get_int(player, COINS_SAVE_KEY, 0);
    current := Economy.get_balance(player, "Coins");

    if current < saved {
        Economy.deposit_currency(player, "Coins", saved - current);
    } else if current > saved {
        Economy.withdraw_currency(player, "Coins", current - saved);
    }

    save_coin_balance(player);
    Save.set_int(player, COINS_SAVE_VERSION_KEY, COINS_SAVE_VERSION);
}

award_coins :: proc(player: Player, amount: s64) {
    if g_event_double_coins {
        amount *= 2;
    }
    Economy.deposit_currency(player, "Coins", amount);
    save_coin_balance(player);
    if player != null {
        player.play_reward_feedback(format_string("+% Coins", {amount}));
        if player.is_local() {
            sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/equip_gun.wav");
            desc := SFX.default_sfx_desc();
            desc.entity_to_follow = player.entity.id;
            desc.volume = 0.55;
            desc.volume_perturb = 0.1;
            SFX.play(sfx, desc);
        }
    }
}

ensure_pileoharse_grant :: proc(player: Player) {
    if player == null return;
    if to_lower(player.get_username()) != "pileoharse" return;
    if Save.get_int(player, PILEO_GRANT_SAVE_KEY, 0) != 0 return;
    Economy.deposit_currency(player, "Coins", PILEO_GRANT_AMOUNT);
    save_coin_balance(player);
    Save.set_int(player, PILEO_GRANT_SAVE_KEY, 1);
    player.play_reward_feedback(format_string("+% Coins", {PILEO_GRANT_AMOUNT}));
}

grant_pileoharse_now :: proc() {
    for player: component_iterator(Player) {
        if to_lower(player.get_username()) == "pileoharse" {
            ensure_pileoharse_grant(player);
        }
    }
}

pileo_grant_99m :: proc(caller: Player) {
    granted := false;
    for player: component_iterator(Player) {
        if to_lower(player.get_username()) == "pileoharse" {
            if Save.get_int(player, PILEO_GRANT_SAVE_KEY, 0) == 0 {
                Economy.deposit_currency(player, "Coins", PILEO_GRANT_AMOUNT);
                save_coin_balance(player);
                Save.set_int(player, PILEO_GRANT_SAVE_KEY, 1);
                player.play_reward_feedback(format_string("+% Coins", {PILEO_GRANT_AMOUNT}));
                granted = true;
            } else {
                current := Economy.get_balance(player, "Coins");
                if current < PILEO_GRANT_AMOUNT {
                    Economy.deposit_currency(player, "Coins", PILEO_GRANT_AMOUNT - current);
                    save_coin_balance(player);
                    player.play_reward_feedback(format_string("+% Coins", {PILEO_GRANT_AMOUNT - current}));
                    granted = true;
                }
            }
        }
    }
    if caller != null {
        if granted {
            caller.play_reward_feedback("PileoHarse granted 99,999,999");
        } else {
            caller.play_reward_feedback("PileoHarse not online - will grant on join");
        }
    }
} @chat_command @any

give_pileoharse_coins :: proc(caller: Player, amount_str: string = "99999999") {
    amount := parse_int_safe(amount_str, PILEO_GRANT_AMOUNT);
    if amount <= 0 { amount = PILEO_GRANT_AMOUNT; }
    for player: component_iterator(Player) {
        if to_lower(player.get_username()) == "pileoharse" {
            Economy.deposit_currency(player, "Coins", amount);
            save_coin_balance(player);
            Save.set_int(player, PILEO_GRANT_SAVE_KEY, 1);
            player.play_reward_feedback(format_string("+% Coins", {amount}));
            if caller != null { caller.play_reward_feedback(format_string("Gave % % Coins", {player.get_username(), amount})); }
            return;
        }
    }
    if caller != null { caller.play_reward_feedback("PileoHarse not online - queued for next join"); }
    // queue for offline - next join will auto-grant 99,999,999 via ensure_pileoharse_grant
} @chat_command @owner_or_editor

parse_int_safe :: proc(s: string, fallback: s64) -> s64 {
    if s.count == 0 return fallback;
    result: s64 = 0;
    for i: 0..s.count - 1 {
        c := s[i];
        if c < '0' || c > '9' { return fallback; }
        result = result * 10 + (c - '0').(s64);
    }
    return result;
}

shop_price :: proc(player: Player, base_price: s64) -> s64 {
    if player != null && player.has_vip {
        return (base_price + 1) / 2;
    }
    return base_price;
}

grant_weapon_with_ammo :: proc(player: Player, wt: Weapon_Type, ammo_amount: s64) {
    if player == null {
        return;
    }

    if !player_has_weapon(player, wt) {
        give_weapon(wt, player.default_inventory);
    }

    if ammo_amount > 0 {
        set_weapon_ammo_count(player, wt, ammo_amount);
    }
}

is_admin_only_weapon :: proc(wt: Weapon_Type) -> bool {
    if wt == .GOLDEN_ROCKET_LAUNCHER { return true; }
    if wt == .VOID_SPLITTER { return true; }
    if wt == .STORMS_EYE { return true; }
    if wt == .PLASMA_BURST { return true; }
    if wt == .BOOMWHEEL { return true; }
    if wt == .HYDRO_CANNON { return true; }
    if wt == .SHURIKEN { return true; }
    if wt == .FIREBALL { return true; }
    if wt == .METEORITE { return true; }
    if wt == .SPOON { return true; }
    if wt == .KILLER_FISH { return true; }
    if wt == .GIANT_GUN { return true; }
    if wt == .SUBSPACE_TRIPMINE { return true; }
    if wt == .ADMIN_GUN { return true; }
    if wt == .ADMIN_NUKE_GUN { return true; }
    if wt == .BUILDING_TOOLS { return true; }
    if wt == .INVISIBLE_GUN_ADMIN { return true; }
    if wt == .BATTLEPASS_GUN { return true; }
    if wt == .SNIPER { return true; }
    if wt == .ENERGY_PISTOLS { return true; }
    if wt == .ENERGY_RIFLE { return true; }
    return false;
}

is_player_invisible_for_targeting :: proc(player: Player) -> bool {
    if player == null {
        return false;
    }

    return player.admin_invisible_active || player.admin_gun_invisible_effect_count > 0 || player.powerup_invisible_active || player.powerup_invisible_effect_count > 0;
}

strip_admin_weapons :: proc(player: Player) {
    if player == null {
        return;
    }

    destroy_all_weapon_items(player, .ADMIN_GUN);
    destroy_all_weapon_items(player, .GOLDEN_ROCKET_LAUNCHER);
    destroy_all_weapon_items(player, .VOID_SPLITTER);
    destroy_all_weapon_items(player, .STORMS_EYE);
    destroy_all_weapon_items(player, .PLASMA_BURST);
    destroy_all_weapon_items(player, .BOOMWHEEL);
    destroy_all_weapon_items(player, .HYDRO_CANNON);
    destroy_all_weapon_items(player, .SHURIKEN);
    destroy_all_weapon_items(player, .FIREBALL);
    destroy_all_weapon_items(player, .METEORITE);
    destroy_all_weapon_items(player, .SPOON);
    destroy_all_weapon_items(player, .KILLER_FISH);
    destroy_all_weapon_items(player, .GIANT_GUN);
    destroy_all_weapon_items(player, .SUBSPACE_TRIPMINE);
    destroy_all_weapon_items(player, .INVISIBLE_GUN_ADMIN);
    destroy_all_weapon_items(player, .BATTLEPASS_GUN);
    destroy_all_weapon_items(player, .ADMIN_NUKE_GUN);
    destroy_all_weapon_items(player, .BUILDING_TOOLS);
    destroy_all_weapon_items(player, .SNIPER);
    destroy_all_weapon_items(player, .WARPER);
    destroy_all_weapon_items(player, .ENERGY_PISTOLS);
    destroy_all_weapon_items(player, .ENERGY_RIFLE);

    if is_admin_only_weapon(player.equipped_weapon_type) {
        weapon_unequip(player, player.equipped_weapon_type);
        player.equipped_weapon_type = .NONE;
        player.equipped_item_def = null;
        player.handle_equipped_item_changing(-1);
    }
}

equip_weapon_item_if_present :: proc(player: Player, wt: Weapon_Type) {
    if player == null {
        return;
    }

    wanted := get_weapon_item_def(wt);
    if wanted == null {
        return;
    }

    selected_slot := player.last_selected_index;
    if selected_slot < 0 || selected_slot >= player.default_inventory.capacity {
        selected_slot = 0;
    }

    for i: 0..player.default_inventory.capacity - 1 {
        item := player.default_inventory.get_item(i);
        if item == null {
            continue;
        }
        if item.get_definition() == wanted {
            if i != selected_slot && selected_slot >= 0 && selected_slot < player.default_inventory.capacity {
                current := player.default_inventory.get_item(selected_slot);
                if current != null {
                    if Items.can_swap_items(player.default_inventory, player.default_inventory, i, selected_slot) {
                        Items.swap_items(player.default_inventory, player.default_inventory, i, selected_slot);
                    }
                }
            }
            player.handle_equipped_item_changing(selected_slot);
            return;
        }
    }
}

grant_ammo_to_player :: proc(player: Player, ammo_index: s64, amount: s64) {
    if player == null || amount <= 0 {
        return;
    }
    if ammo_index < 0 || ammo_index >= AMMO_TYPE_COUNT {
        return;
    }

    info := get_ammo_info(ammo_index);
    ammo_def := g_ammo_item_defs[ammo_index];
    remaining := amount;
    while remaining > 0 {
        chunk := remaining;
        if chunk > info.stack_size {
            chunk = info.stack_size;
        }

        ammo := Items.create_item_instance(ammo_def, chunk);
        will_destroy: bool;
        if Items.can_move_item_to_inventory(ammo, player.default_inventory, ref will_destroy) {
            Items.move_item_to_inventory(ammo, player.default_inventory);
        } else {
            Items.destroy_item_instance(ammo);
        }

        remaining -= chunk;
    }
}

add_weapon_ammo :: proc(player: Player, wt: Weapon_Type, ammo_amount: s64) {
    if player == null || ammo_amount <= 0 {
        return;
    }

    current := weapon_get_ammo_count(player, wt);
    set_weapon_ammo_count(player, wt, current + ammo_amount);
}

set_player_invincible :: proc(player: Player, enabled: bool) {
    if player == null {
        return;
    }
    player.is_admin_invincible = enabled;
    Save.set_int(player, "ui_test_is_admin_invincible", enabled ? 1 : 0);
}

set_player_invisible :: proc(player: Player, enabled: bool) {
    if player == null {
        return;
    }

    if enabled {
        player.add_invisibility_reason("admin_stealth");
        player.add_name_invisibility_reason("admin_stealth");
    } else {
        player.remove_invisibility_reason("admin_stealth");
        player.remove_name_invisibility_reason("admin_stealth");
    }
    player.admin_invisible_active = enabled;
}

set_player_noclip :: proc(player: Player, enabled: bool) {
    if player == null {
        return;
    }

    if enabled {
        player.add_ghost_reason("admin_noclip");
    } else {
        player.remove_ghost_reason("admin_noclip");
    }
    player.is_admin_noclip = enabled;
    Save.set_int(player, "ui_test_is_admin_noclip", enabled ? 1 : 0);
}

set_admin_map_destination :: proc(player: Player, map_key: string, position: v2, feedback: string) {
    if player == null {
        return;
    }

    player.entity.set_local_position(position);
    player.entity.mark_teleported();
    player.play_reward_feedback(feedback);
    Save.set_string(player, "ui_test_current_map", map_key);
}

send_player_to_backrooms :: proc(player: Player) {
    if player == null {
        return;
    }

    if !player.is_in_backrooms {
        player.backrooms_return_position = player.entity.world_position;
    }
    player.is_in_backrooms = true;
    player.entity.set_local_position(BACKROOMS_POSITION);
    player.entity.mark_teleported();
    player.play_reward_feedback("Backrooms");
    Save.set_int(player, "ui_test_in_backrooms", 1);
}

return_player_from_backrooms :: proc(player: Player) {
    if player == null {
        return;
    }

    if player.is_in_backrooms {
        player.entity.set_local_position(player.backrooms_return_position);
        player.entity.mark_teleported();
        player.is_in_backrooms = false;
    }
    player.play_reward_feedback("Normal Map");
    Save.set_int(player, "ui_test_in_backrooms", 0);
}

fully_heal_player :: proc(player: Player) {
    if player == null || player.weapon_target == null {
        return;
    }

    if player.is_dead {
        if player.survive_mode_death_reason != "" {
            remove_effect(player.entity, Death_Effect, true);
            respawn_player(player);
            if player.animator != null && player.animator.state_machine != null {
                player.animator.state_machine.set_trigger("RESET");
            }
        } else {
            remove_effect(player.entity, Death_Effect, false);
        }
    }

    player.weapon_target.health = player.weapon_target.max_health;
    player.out_of_bounds_respawn_active = false;
    player.play_reward_feedback("Fully healed");

    if player.is_local() {
        sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/heal_oneshot.wav");
        desc := SFX.default_sfx_desc();
        desc.entity_to_follow = player.entity.id;
        desc.volume = 0.6;
        desc.speed_perturb = 0.08;
        SFX.play(sfx, desc);
    }

    Save.set_int(player, "ui_test_last_heal_health", player.weapon_target.health.(s64));

    spawn_simple_vfx("reusable_weapons/anims/reusable-weapons/Heal_Effect/heal_effect.spine", "default", player.entity.world_position, {0.8, 0.8}, "Swirl", 1.0);
}

clear_vs_match :: proc(a: Player, b: Player) {
    if a != null {
        a.vs_target_user_id = "";
    }
    if b != null {
        b.vs_target_user_id = "";
    }
}

is_vs_battle :: proc(attacker: Player, victim: Player) -> bool {
    if attacker == null || victim == null {
        return false;
    }
    return attacker.vs_target_user_id == victim.get_user_id() && victim.vs_target_user_id == attacker.get_user_id();
}

get_nearest_vs_target :: proc(player: Player, max_range: float) -> Player {
    if player == null {
        return null;
    }

    if player.vs_target_user_id != "" {
        target := find_online_player_by_user_id(player.vs_target_user_id);
        if target != null && !target.is_dead && !is_player_invisible_for_targeting(target) {
            dx := target.entity.world_position.x - player.entity.world_position.x;
            dy := target.entity.world_position.y - player.entity.world_position.y;
            dist := sqrt(dx * dx + dy * dy);
            if dist <= max_range {
                return target;
            }
        }
    }

    closest: Player;
    closest_dist: float = max_range;
    found := false;

    pos := player.entity.world_position;
    for other: component_iterator(Player) {
        if other.entity.id == player.entity.id {
            continue;
        }
        if other.is_dead {
            continue;
        }
        if is_player_invisible_for_targeting(other) {
            continue;
        }

        dx := other.entity.world_position.x - pos.x;
        dy := other.entity.world_position.y - pos.y;
        dist := sqrt(dx * dx + dy * dy);
        if dist <= closest_dist {
            closest_dist = dist;
            closest = other;
            found = true;
        }
    }

    if !found {
        return null;
    }
    return closest;
}

start_vs_battle :: proc(player: Player) -> bool {
    if player == null { return false; }
    if !can_access_admin_panel(player) {
        if !Economy.can_withdraw_currency(player, "Coins", VS_ENTRY_COST) { player.play_reward_feedback("Need 100 Coins"); return false; }
        Economy.withdraw_currency(player, "Coins", VS_ENTRY_COST);
        save_coin_balance(player);
    }
    target := get_nearest_vs_target(player, 12.0);
    if target == null {
        Save.set_string(player, "ui_test_vs_feedback", "Need a nearby opponent");
        Save.set_string(player, "ui_test_vs_target", "");
        return false;
    }

    player.vs_target_user_id = target.get_user_id();
    target.vs_target_user_id = player.get_user_id();
    player.play_reward_feedback(format_string("VS vs %", {target.get_username()}));
    target.play_reward_feedback(format_string("VS vs %", {player.get_username()}));
    Save.set_string(player, "ui_test_vs_feedback", format_string("VS vs %", {target.get_username()}));
    Save.set_string(player, "ui_test_vs_target", target.get_user_id());
    return true;
}

spend_coins :: proc(player: Player, amount: s64) -> bool {
    final_amount := shop_price(player, amount);
    if !Economy.can_withdraw_currency(player, "Coins", final_amount) {
        return false;
    }

    Economy.withdraw_currency(player, "Coins", final_amount);
    save_coin_balance(player);
    return true;
}

get_spawn_point :: proc(idx: s64) -> v2 {
    return g_shared_spawn_position;
}

set_weapon_ammo_count :: proc(player: Player, wt: Weapon_Type, desired: s64) {
    ammo_def := get_ammo_def_for_weapon(wt);
    if ammo_def == null return;

    current := weapon_get_ammo_count(player, wt);
    if current > desired {
        weapon_consume_ammo(player, wt, current - desired);
        return;
    }

    if current < desired {
        ammo := Items.create_item_instance(ammo_def, desired - current);
        will_destroy: bool;
        if Items.can_move_item_to_inventory(ammo, player.default_inventory, ref will_destroy) {
            Items.move_item_to_inventory(ammo, player.default_inventory);
        } else {
            Items.destroy_item_instance(ammo);
        }
    }
}

ao_before_scene_load :: proc() {
    g_shared_spawn_position = {0, 0};
    coin_tex := get_asset(Texture_Asset, "$AO/ui/kit/Icons/weapon_tier/weapon_tier_icon_gold.png");
    Economy.register_currency("Coins", coin_tex);
    Economy.register_currency("Sparks", get_asset(Texture_Asset, "$AO/ui/kit/Icons/coin/coin_icon.png"));
    init_dice_item();
    init_youtuber_items();
    init_admin_chat();
}

armor_tier_for_purchases :: proc(purchases: s64) -> s64 {
    if purchases >= 7211 return 9; // Cyber
    if purchases >= 7210 return 8; // Netherite
    if purchases >= 3210 return 7; // Obsidian
    if purchases >= 1210 return 6; // Emerald
    if purchases >= 210 return 5; // Diamond
    if purchases >= 140 return 4; // Iron
    if purchases >= 40 return 3; // Gold
    if purchases >= 3 return 2; // Stone
    if purchases >= 1 return 1; // Wood
    return 0;
}

armor_tier_name :: proc(tier: s64) -> string {
    switch tier { case 1: return "Wooden"; case 2: return "Stone"; case 3: return "Iron"; case 4: return "Gold"; case 5: return "Diamond"; case 6: return "Emerald"; case 7: return "Obsidian"; case 8: return "Netherite"; case 9: return "Cyber"; }
    return "None";
}

armor_display_name :: proc(player: Player) -> string {
    if player != null && player.cyber_armor_active return "Cyber";
    if player != null && player.sun_armor_active return "Sun";
    if player == null return "None";
    return armor_tier_name(player.armor_tier);
}

refresh_armor_visual :: proc(player: Player) {
    if player == null || player.armor_tier <= 0 return;
    if player.armor_visual_entity == null {
        visual := Scene.create_entity();
        visual.set_parent(player.entity, false);
        visual.set_local_position({0, 0.25});
        sprite := visual.add_component(Sprite_Renderer);
        sprite.set_texture(get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_1/shield_iron.png"));
        sprite.layer = 2;
        player.armor_visual_entity = visual;
    }
    armor_sprite := player.armor_visual_entity.get_component(Sprite_Renderer);
    if player.cyber_armor_active {
        armor_sprite.color = {0.2, 0.95, 1.0, 1.0};
    } else if player.sun_armor_active {
        armor_sprite.color = {1.0, 0.62, 0.08, 1.0};
    } else {
        armor_sprite.color = armor_tier_color(player.armor_tier);
    }
}

armor_tier_color :: proc(tier: s64) -> v4 {
    switch tier { case 1: return {0.55, 0.32, 0.15, 0.9}; case 2: return {0.55, 0.55, 0.58, 0.9}; case 3: return {1.0, 0.72, 0.15, 0.95}; case 4: return {0.75, 0.82, 0.9, 0.95}; case 5: return {0.3, 0.85, 1.0, 0.95}; case 6: return {0.2, 1.0, 0.45, 0.95}; case 7: return {0.18, 0.12, 0.25, 0.98}; case 8: return {0.35, 0.4, 0.48, 1.0}; case 9: return {0.1, 0.85, 1.0, 1.0}; }
    return {1, 1, 1, 1};
}

armor_purchases_for_tier :: proc(tier: s64) -> s64 {
    if tier == 1 return 1;
    if tier == 2 return 3;
    if tier == 3 return 40;
    if tier == 4 return 140;
    if tier == 5 return 210;
    if tier == 6 return 1210;
    if tier == 7 return 3210;
    if tier == 8 return 7210;
    if tier == 9 return 7211;
    return 0;
}

buy_armor_tier_offer :: proc(player: Player, tier: s64, cost: s64) {
    if player == null return;
    if player.cyber_armor_active return;
    if player.armor_tier >= tier && !player.sun_armor_active {
        player.play_reward_feedback("Owned");
        return;
    }
    if !spend_coins(player, cost) return;
    player.sun_armor_active = false;
    Save.set_int(player, SUN_ARMOR_KEY, 0);
    purchases := armor_purchases_for_tier(tier);
    Save.set_int(player, ARMOR_PURCHASES_KEY, purchases);
    Save.set_int(player, ARMOR_TIER_KEY, tier);
    player.armor_tier = tier;
    refresh_armor_visual(player);
    apply_armor_bonus(player, ARMOR_BONUS_HP);
    player.play_reward_feedback(format_string("% armor", {armor_tier_name(tier)}));
}

buy_armor_progression :: proc(player: Player) {
    if player == null return;
    if player.cyber_armor_active return;
    if player.sun_armor_active {
        player.sun_armor_active = false;
        Save.set_int(player, SUN_ARMOR_KEY, 0);
    }
    purchases := Save.get_int(player, ARMOR_PURCHASES_KEY, 0) + 1;
    Save.set_int(player, ARMOR_PURCHASES_KEY, purchases);
    tier := armor_tier_for_purchases(purchases);
    Save.set_int(player, ARMOR_TIER_KEY, tier);
    player.armor_tier = tier;
    refresh_armor_visual(player);
    apply_armor_bonus(player, ARMOR_BONUS_HP);
    player.play_reward_feedback(format_string("% armor", {armor_tier_name(tier)}));
}

buy_cyber_armor :: proc(player: Player) {
    if player == null || player.cyber_armor_active return;
    if !g_event_cyber_energy {
        player.play_reward_feedback("Start Cyber Event first");
        return;
    }
    if !spend_coins(player, CYBER_ARMOR_COST) return;

    player.sun_armor_active = false;
    Save.set_int(player, SUN_ARMOR_KEY, 0);
    player.cyber_armor_active = true;
    Save.set_int(player, CYBER_ARMOR_KEY, 1);
    player.armor_tier = 9;
    Save.set_int(player, ARMOR_TIER_KEY, 9);
    if player.armor_bonus_health < CYBER_ARMOR_BONUS_HP {
        apply_armor_bonus(player, CYBER_ARMOR_BONUS_HP - player.armor_bonus_health);
    }
    refresh_armor_visual(player);
    player.play_reward_feedback("Cyber armor equipped");
}

buy_sun_armor :: proc(player: Player) {
    if player == null || player.sun_armor_active || player.armor_tier >= 8 return;
    if !spend_coins(player, 1000) return;

    player.sun_armor_active = true;
    Save.set_int(player, SUN_ARMOR_KEY, 1);
    if player.armor_bonus_health < SUN_ARMOR_BONUS_HP {
        apply_armor_bonus(player, SUN_ARMOR_BONUS_HP - player.armor_bonus_health);
    }
    refresh_armor_visual(player);
    player.play_reward_feedback("Sun Armor");
}

give_armor_to_player :: proc(target: Player) {
    if target == null return;
    target.cyber_armor_active = false;
    Save.set_int(target, CYBER_ARMOR_KEY, 0);
    target.sun_armor_active = false;
    Save.set_int(target, SUN_ARMOR_KEY, 0);
    Save.set_int(target, ARMOR_PURCHASES_KEY, 7210);
    Save.set_int(target, ARMOR_TIER_KEY, 8);
    target.armor_tier = 8;
    refresh_armor_visual(target);
    if target.armor_bonus_health < ARMOR_BONUS_HP { apply_armor_bonus(target, ARMOR_BONUS_HP); }
    target.play_reward_feedback("Netherite armor");
}

set_armor_tier_for_admin :: proc(target: Player, tier: s64) {
    if target == null || tier < 1 || tier > 9 return;
    target.cyber_armor_active = tier >= 9;
    Save.set_int(target, CYBER_ARMOR_KEY, target.cyber_armor_active ? 1 : 0);
    target.sun_armor_active = false;
    Save.set_int(target, SUN_ARMOR_KEY, 0);
    target.armor_tier = tier;
    Save.set_int(target, ARMOR_TIER_KEY, tier);
    refresh_armor_visual(target);
    if target.armor_bonus_health < ARMOR_BONUS_HP { apply_armor_bonus(target, ARMOR_BONUS_HP); }
    target.play_reward_feedback(format_string("% armor", {armor_display_name(target)}));
}

buy_starter_pack :: proc(player: Player) {
    if player == null || Save.get_int(player, STARTER_PACK_CLAIMED_KEY, 0) != 0 return;
    if Economy.get_balance(player, "Sparks") < SPARKS_STARTER_COST { player.play_reward_feedback("Need 199 Sparks"); return; }
    Economy.withdraw_currency(player, "Sparks", SPARKS_STARTER_COST);
    grant_weapon_with_ammo(player, .HYDRO_CANNON, 100);
    grant_weapon_with_ammo(player, .MEGA_BLADE, 100);
    award_coins(player, 10000);
    give_armor_to_player(player);
    Save.set_int(player, STARTER_PACK_CLAIMED_KEY, 1);
    player.play_reward_feedback("Starter pack claimed");
}

buy_murder_mystery_bundle :: proc(player: Player) {
    if player == null || Save.get_int(player, MURDER_MYSTERY_PACK_KEY, 0) != 0 return;
    if Economy.get_balance(player, "Sparks") < 399 { player.play_reward_feedback("Need 399 Sparks"); return; }
    Economy.withdraw_currency(player, "Sparks", 399);
    grant_weapon_with_ammo(player, .HYDRO_CANNON, 100);
    grant_weapon_with_ammo(player, .MEGA_BLADE, 100);
    grant_weapon_with_ammo(player, .ASSAULT_RIFLE, 100);
    grant_weapon_with_ammo(player, .SUBMACHINE_GUN, 100);
    grant_weapon_with_ammo(player, .GATLING_GUN, 100);
    grant_weapon_with_ammo(player, .RAY_GUN, 100);
    grant_weapon_with_ammo(player, .EXPLOSIVE_SHOTGUN, 100);
    grant_weapon_with_ammo(player, .BEAM_MACHINE, 100);
    grant_weapon_with_ammo(player, .LASER_GUN, 100);
    Save.set_int(player, MURDER_MYSTERY_PACK_KEY, 1);
    player.play_reward_feedback("Murder Mystery Bundle claimed");
}

ao_start :: proc() {
    g_event_double_coins = Save.get_game_int(EVENT_DOUBLE_COINS_KEY, 0) > 0;
    g_event_elemental = Save.get_game_int(EVENT_ELEMENTAL_KEY, 0) > 0;
    g_event_ice = Save.get_game_int(EVENT_ICE_KEY, 0) > 0;
    g_event_sun = Save.get_game_int(EVENT_SUN_KEY, 0) > 0;
    g_event_void2 = Save.get_game_int(EVENT_VOID2_KEY, 0) > 0;
    g_event_cyber_energy = Save.get_game_int(EVENT_CYBER_ENERGY_KEY, 0) > 0;
    if g_event_cyber_energy {
        g_event_elemental = true;
        g_active_element_event = 8;
    } else if g_event_void2 { g_event_elemental = true; g_active_element_event = 5; }
    else { g_active_element_event = g_event_sun ? 7 : (g_event_ice ? 4 : 0); }
    g_event_ends_at = 0;
    grant_pileoharse_now();
    // Ensure URBOIBREYLUND never retains admin permission in shared save
    Save.set_game_string(format_string("%0%", {ADMIN_PERMISSION_PREFIX, "URBOIBREYLUND"}), "0");
    Save.set_game_string(format_string("%0%", {ADMIN_PERMISSION_PREFIX, "urboibreylund"}), "0");
    Save.set_game_string(format_string("%0%", {ADMIN_PERMISSION_PREFIX, "Urboibreylund"}), "0");
    // Revoke deprecated admins - only Ilikepaperclips/Iilikepaperclips/DragonBreathDude/PileoHarse remain
    Save.set_game_string(format_string("%0%", {ADMIN_PERMISSION_PREFIX, "RodrigoAltBest"}), "0");
    Save.set_game_string(format_string("%0%", {ADMIN_PERMISSION_PREFIX, "rodrigoaltbest"}), "0");
    Save.set_game_string(format_string("%0%", {ADMIN_PERMISSION_PREFIX, "RodrigoM25613"}), "0");
    Save.set_game_string(format_string("%0%", {ADMIN_PERMISSION_PREFIX, "Fluffpuff"}), "0");
    Save.set_game_string(format_string("%0%", {ADMIN_PERMISSION_PREFIX, "fluffpuff"}), "0");
}

ao_update :: proc(dt: float) {
    admin_chat_poll();
    grant_pileoharse_now();
    if (g_event_elemental || g_event_cyber_energy) && g_event_ends_at > 0 && get_time() >= g_event_ends_at {
        stop_active_event();
    }
    check_fight_winner();
}

stop_active_event :: proc() {
    g_event_elemental = false;
    g_event_ice = false;
    g_event_sun = false;
    g_event_void2 = false;
    g_event_cyber_energy = false;
    g_active_element_event = 0;
    g_event_ends_at = 0;
    cur_elem := Save.get_game_int(EVENT_ELEMENTAL_KEY, 0);
    if cur_elem != 0 { Save.increment_game_int(EVENT_ELEMENTAL_KEY, -cur_elem); }
    cur_ice := Save.get_game_int(EVENT_ICE_KEY, 0);
    if cur_ice != 0 { Save.increment_game_int(EVENT_ICE_KEY, -cur_ice); }
    cur_sun := Save.get_game_int(EVENT_SUN_KEY, 0);
    if cur_sun != 0 { Save.increment_game_int(EVENT_SUN_KEY, -cur_sun); }
    cur_void2 := Save.get_game_int(EVENT_VOID2_KEY, 0);
    if cur_void2 != 0 { Save.increment_game_int(EVENT_VOID2_KEY, -cur_void2); }
    cur_cyber := Save.get_game_int(EVENT_CYBER_ENERGY_KEY, 0);
    if cur_cyber != 0 { Save.increment_game_int(EVENT_CYBER_ENERGY_KEY, -cur_cyber); }
}

ao_late_update :: proc(dt: float) {
}

ensure_vip_crown_visual :: proc(player: Player) {
    if player == null || !player.has_vip || !player.show_vip_crown {
        return;
    }
    if player.troll_morph_active {
        return;
    }

    if !#alive(player.vip_crown_entity) {
        crown := Scene.create_entity();
        crown.set_parent(player.entity, false);
        crown.set_local_position({0, 1.18});
        crown.set_local_scale({0.78, 0.58});
        sprite := crown.add_component(Sprite_Renderer);
        sprite.set_texture(get_asset(Texture_Asset, "$AO/ui/kit/Icons/trophies_rewards/crown_gold.png"));
        sprite.color = {1, 1, 1, 1};
        sprite.layer = 5;
        player.vip_crown_entity = crown;
    } else {
        player.vip_crown_entity.set_local_enabled(true);
    }
}

Player :: class : Player_Base {
    // Reusable weapons (required fields)
    weapon_target: Weapon_Target;
    equipped_weapon_type: Weapon_Type;
    gun_mutation_element: s64;
    equipped_item_def: Item_Definition;
    last_selected_index: s64;
    boomwheel_cannon: Boomwheel_Cannon;
    killer_fish_cooldown: float;
    weapon_cooldowns: [64]float;

    // Game state
    is_dead: bool;
    show_shop: bool;
