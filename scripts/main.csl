    ao_start :: method() {
        banned_seconds := admin_ban_remaining_seconds(get_user_id());
        if banned_seconds > 0 {
            Server.kick_player(this, format_string("You have been banned for % seconds. Reason For Ban: %", {banned_seconds, admin_ban_reason_for_user(get_user_id())}));
            return;
        }

        // Weapon target (health component)
        wt := entity.add_component(Weapon_Target);
        wt.health = PLAYER_MAX_HEALTH;
        wt.max_health = PLAYER_MAX_HEALTH;
        wt.owner_entity_id = entity.id;
        wt.on_damaged_userdata = this;
        wt.on_damaged = proc(target: Weapon_Target, damage: float, attacker_id: u64, userdata: Object) {
            victim := userdata.(Player);
            if victim.backrooms_monster_active {
                target.health = target.max_health;
                return;
            }
            if target.health <= 0 && !victim.is_dead {
                if is_murder_mystery_active() {
                    attacker: Player;
                    for candidate: component_iterator(Player) { if candidate.entity.id == attacker_id { attacker = candidate; break; } }
                    victim.murder_permadead = attacker != null && attacker.murder_role == .KILLER;
                }
                victim.survive_mode_killed_by_creature = false;
                for creature: component_iterator(Survive_Mode_Creature_Marker) {
                    if creature.entity.id == attacker_id {
                        victim.survive_mode_killed_by_creature = true;
                        break;
                    }
                }
                effect := new(Death_Effect);
                victim.entity.set_active_effect(effect);

                // Award kill coins to attacker
                for attacker: component_iterator(Player) {
                    if attacker.entity.id == attacker_id {
                        reward := KILL_COINS;
                        // Events are retired; every kill has the same base reward.
                        if is_vs_battle(attacker, victim) {
                            reward = VS_KILL_COINS;
                            clear_vs_match(attacker, victim);
                        }
                        if attacker.has_vip {
                            reward *= 2;
                        }
                        award_coins(attacker, reward);
                        // Track for Most Kills leaderboard (pushed every 30s by manager)
                        attacker.leaderboard_total_kills += 1;
                        Save.set_int(attacker, "total_kills", attacker.leaderboard_total_kills);
                        if attacker.is_local() {
                            sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/equip_gun.wav");
                            desc := SFX.default_sfx_desc();
                            desc.volume = 0.5;
                            SFX.play(sfx, desc);
                        }
                        break;
                    }
                }
            }

        };
        weapon_target = wt;

        last_selected_index = -1;
        init_weapon_items();
        setup_reusable_weapons_player_state_machine(this);

        Items.set_capacity(default_inventory, 20);
        give_weapon(.ASSAULT_RIFLE, default_inventory);
        give_weapon(.SWORD, default_inventory);
        load_saved_coins(this);
        ensure_pileoharse_grant(this);
        has_claimed_parkour_reward = Save.get_int(this, PARKOUR_REWARD_KEY, 0) != 0;
        has_paperclip = Save.get_int(this, PAPERCLIP_UNLOCKED_KEY, 0) != 0;
        paperclip_active = false;
        has_vip = Save.get_int(this, VIP_SAVE_KEY, 0) != 0;
        show_vip_crown = Save.get_int(this, VIP_CROWN_VISIBLE_SAVE_KEY, 1) != 0;
        show_admin_tag = Save.get_int(this, ADMIN_TAG_VISIBLE_SAVE_KEY, 1) != 0;
        show_reward_popups = Save.get_int(this, "show_reward_popups", 1) != 0;
        show_tutorial_button = Save.get_int(this, "show_tutorial_button", 1) != 0;
        foltyn_frenzy_active = false;
        steak_health_active = false;
        foltyn_frenzy_speed = 480.0;
        Save.set_int(this, "ui_test_sword_base_damage", get_weapon_config(.SWORD).base_damage.(s64));

        // Spawn with ammo for the starting gun. Use the same inventory-backed
        // grant path as every other gun so its fire button is immediately usable.
        grant_weapon_with_ammo(this, .ASSAULT_RIFLE, STARTING_BULLETS);
        if is_pileo_harse(this) {
            Items.set_capacity(default_inventory, 40);
            grant_weapon_with_ammo(this, .MISSILE_BARRAGE, 999);
            grant_weapon_with_ammo(this, .BATTLE_AXE, 999);
            grant_weapon_with_ammo(this, .FLAMETHROWER, 999);
            grant_weapon_with_ammo(this, .WATER_BALLOON_RPG, 999);
            grant_weapon_with_ammo(this, .GATLING_GUN, 999);
            grant_weapon_with_ammo(this, .ENERGY_PISTOLS, 999);
            grant_weapon_with_ammo(this, .SUN_SHOOTER_TSUNAMI, 999);
        }

        // Remove retired Warper items from inventories created before the retirement.
        destroy_all_weapon_items(this, .WARPER);

        if can_access_admin_panel(this) {
            if !player_has_weapon(this, .ADMIN_GUN) {
                give_weapon(.ADMIN_GUN, default_inventory);
            }
            if !player_has_weapon(this, .INVISIBLE_GUN_ADMIN) {
                give_weapon(.INVISIBLE_GUN_ADMIN, default_inventory);
            }
            if !player_has_weapon(this, .BATTLEPASS_GUN) {
                give_weapon(.BATTLEPASS_GUN, default_inventory);
            }
            if !player_has_weapon(this, .BUILDING_TOOLS) {
                give_weapon(.BUILDING_TOOLS, default_inventory);
            }
        }

        // Remove Grenade Gun from all players - weapon has been removed from the game
        destroy_all_weapon_items(this, .GRENADE_GUN);
        if equipped_weapon_type == .GRENADE_GUN {
            weapon_unequip(this, .GRENADE_GUN);
            equipped_weapon_type = .NONE;
            equipped_item_def = null;
            handle_equipped_item_changing(-1);
        }

        // Assign random spawn point
        rng := rng_root_seed();
        idx := rng_range_int(ref rng, 0, 3);
        entity.set_local_position(get_spawn_point(idx));

        username := get_username();
        is_admin_user = can_access_admin_panel(this);
        // Hard revoke for URBOIBREYLUND - never admin regardless of saved permissions
        if to_lower(username) == "urboibreylund" {
            is_admin_user = false;
            if user_tag == "PAPERCLIP" { user_tag = ""; }
            set_admin_permission(username, false);
            set_admin_permission("URBOIBREYLUND", false);
            set_admin_permission("urboibreylund", false);
            set_admin_permission("Urboibreylund", false);
        }
        // Power-ups are not granted on join - must be purchased in shop
        has_dash = false;
        has_invisible = false;
        has_speed_boost = false;
        has_zoom_out = false;
        user_tag = Save.get_string(this, PLAYER_TITLE_SAVE_KEY, "");
        if user_tag == "PAPERCLIP" && !is_admin_user {
            user_tag = "";
        }
        is_mimicer = false;
        shop_tab_index = 0;
        show_mimicer_selector = false;
        show_minigames = false;
        armor_bonus_health = 0;
        armor_tier = Save.get_int(this, ARMOR_TIER_KEY, 0);
        sun_armor_active = Save.get_int(this, SUN_ARMOR_KEY, 0) != 0;
        cyber_armor_active = Save.get_int(this, CYBER_ARMOR_KEY, 0) != 0 || armor_tier >= 9;
        if cyber_armor_active { armor_tier = 9; }
        refresh_armor_visual(this);
        // Leaderboard persistence: restore kills and time played
        leaderboard_total_kills = Save.get_int(this, "total_kills", 0);
        leaderboard_time_played = Save.get_int(this, "total_time_played", 0).(float);
        if sun_armor_active && armor_bonus_health < SUN_ARMOR_BONUS_HP {
            apply_armor_bonus(this, SUN_ARMOR_BONUS_HP - armor_bonus_health);
        }
        if cyber_armor_active && armor_bonus_health < CYBER_ARMOR_BONUS_HP {
            apply_armor_bonus(this, CYBER_ARMOR_BONUS_HP - armor_bonus_health);
        }
        admin_target_username = "";
        admin_grant_amount = 25;
        admin_ban_reason = "Admin panel action";
        admin_armor_tier = 1;
        show_admin_unban = false;
        admin_unban_next_refresh_at = 0;
        admin_unban_action_count = 0;
        admin_unban_announcement_count = 0;
        admin_unban_visible_ban_count = 0;
        admin_unban_last_expiry_after = 0;
        admin_unban_last_user_id = "";
        admin_unban_last_announcement = "";
        admin_unban_test_prepare_at = 0;
        admin_unban_test_fixture_count = 0;
        is_admin_invincible = false;
        admin_invisible_active = false;
        admin_gun_invisible_effect_count = 0;
        powerup_invisible_active = false;
        powerup_invisible_effect_count = 0;
        battlepass_music_effect_count = 0;
        is_admin_noclip = false;
        show_admin_shop = false;
        show_pileo_shop = false;
        show_codes_panel = false;
        code_input = "";
        code_status = "Enter a code";
        show_caylus_map = false;
        caylus_map_dismissed = false;
        player_element = 0;
        gun_mutation_element = 0;
        mimicer_form_target_user_id = "";
        mimicer_form_expires_at = 0;
        mimicer_saved_look_valid = false;
        mimicer_saved_name_override = "";
        mimicer_saved_do_name_color_override = false;
        mimicer_saved_name_color_override = {1, 1, 1, 1};
        mimicer_saved_anim_tint = {1, 1, 1, 1};
        vs_target_user_id = "";
        is_in_backrooms = false;
        backrooms_return_position = entity.world_position;
        admin_chat_last_send_at = 0;
        admin_chat_last_activity_at = 0;
        admin_chat_enabled = false;
        capture_the_flag_team = -1;
        capture_the_flag_carrying = false;
        role_mode_role = .NONE;
        role_mode_buff = .NONE;
        role_mode_buff_until = 0;
        role_mode_vote_target = "";
        murder_permadead = false;
        show_troll_panel = false;
        troll_target_username = "";
        troll_freeze_next_allowed = 0;
        troll_mind_next_allowed = 0;
        troll_frozen_until = 0;
        troll_control_until = 0;
        troll_control_mode = 0;
        troll_control_owner_id = "";
        troll_control_emote_idx = 0;
        troll_scare_until = 0;
        troll_scare_type = 0;
        troll_selected_mc_mode = 0;
        troll_selected_emote_idx = 0;
        troll_inventory_mess_next = 0;
        troll_emote_next = 0;
        troll_force_shoot_next = 0;
        troll_morph_active = false;
        troll_morph_saved_valid = false;
        troll_morph_saved_name_override = "";
        troll_morph_saved_do_name_color_override = false;
        troll_morph_saved_name_color_override = {1, 1, 1, 1};
        troll_morph_saved_anim_tint = {1, 1, 1, 1};
        troll_morph_saved_user_tag = "";
        troll_morph_saved_show_vip_crown = true;
        backrooms_monster_active = false;
        backrooms_monster_entity = null;
        troll_buzz_active = false;
        for i: 0..3 { troll_jumpscare_next_allowed[i] = 0; }
        killer_fish_cooldown = 0;
        if is_local() {
            // Voice range is measured in world units. Zero means unlimited/global,
            // so keep voice explicitly local to nearby players.
            Voice.set_range(12.0);
        }
        if Game.is_editor() {
            entity.set_name("Player");
            set_name_override("Player");
        }
        if get_user_id() == "59zttiotnra" {
            user_tag = "Mr Fancy";
            name_color_override = {1.0, 0.86, 0.18, 1.0};
        } else if is_admin_user {
            user_tag = "PAPERCLIP";
            name_color_override = {1.0, 0.84, 0.18, 1.0};
        } else if user_tag.count == 0 && get_user_id() == "ilikehotpockets" {
            user_tag = "Hot Pockets";
            name_color_override = {1.0, 0.86, 0.18, 1.0};
        }
    }

    ao_update :: method(dt: float) {
        // Continuously enforce URBOIBREYLUND has no admin
        if to_lower(get_username()) == "urboibreylund" && is_admin_user {
            is_admin_user = false;
            if user_tag == "PAPERCLIP" { user_tag = Save.get_string(this, PLAYER_TITLE_SAVE_KEY, ""); }
            set_admin_permission(get_username(), false);
            set_admin_permission("urboibreylund", false);
            strip_admin_weapons(this);
            show_admin_panel = false;
            show_admin_shop = false;
            show_admin_unban = false;
        }
        if admin_unban_test_prepare_at > 0 && get_time() >= admin_unban_test_prepare_at {
            admin_unban_test_prepare_at = 0;
            prepare_admin_unban_test_state(this);
        }

        update_health_bar_visibility_test_state(this);

        if ui_test_restore_weapon_target_at > 0 && get_time() >= ui_test_restore_weapon_target_at {
            weapon_target = entity.get_component(Weapon_Target);
            ui_test_restore_weapon_target_at = 0;
            Save.set_int(this, "ui_test_health_bar_target_restored", #alive(weapon_target) ? 1 : 0);
        }

        // Keep morph cosmetics applied before crown logic.
        if troll_morph_active {
            if user_tag != "" {
                user_tag = "";
            }
            if show_vip_crown {
                show_vip_crown = false;
            }
            if #alive(vip_crown_entity) {
                vip_crown_entity.set_local_enabled(false);
            }
            if backrooms_monster_active && #alive(animator) {
                tint := animator.get_tint();
                if tint.w != 0 {
                    animator.set_tint({1.0, 0.92, 0.35, 0.0});
                }
            }
            if backrooms_monster_active {
                ensure_backrooms_monster_visual(this);
            }
        } else {
            if #alive(backrooms_monster_entity) {
                backrooms_monster_entity.destroy();
                backrooms_monster_entity = null;
            }
        }

        ensure_vip_crown_visual(this);

        if has_vip && show_vip_crown && !#alive(vip_crown_entity) {
            ensure_vip_crown_visual(this);
        } else if (!show_vip_crown || !has_vip) && #alive(vip_crown_entity) {
            vip_crown_entity.set_local_enabled(false);
        }

        if admin_freeze_until > 0 && get_time() >= admin_freeze_until {
            agent.movement_speed = admin_freeze_previous_speed;
            admin_freeze_until = 0;
        }

        if foltyn_frenzy_active && admin_freeze_until <= get_time() && agent.movement_speed < foltyn_frenzy_speed {
            agent.movement_speed = foltyn_frenzy_speed;
        }

        if !is_dead && !out_of_bounds_respawn_active && is_player_out_of_bounds(this) {
            out_of_bounds_respawn_active = true;
            out_of_bounds_respawn_start = get_time();
            agent.velocity = {0, 0};
            agent.input_this_frame = {0, 0};
            if animator != null && animator.instance != null && animator.instance.state_machine != null {
                animator.instance.state_machine.set_trigger("Fall_To_Ground_Hurt");
            }
        }

        if out_of_bounds_respawn_active {
            elapsed := get_time() - out_of_bounds_respawn_start;
            pos := entity.local_position;
            entity.set_local_position({pos.x, pos.y - OOB_FALL_SPEED * dt});
            agent.velocity = {0, 0};
            agent.input_this_frame = {0, 0};

            if elapsed >= OOB_FALL_DURATION {
                out_of_bounds_respawn_active = false;
                respawn_player(this);
                if animator != null && animator.instance != null && animator.instance.state_machine != null {
                    animator.instance.state_machine.set_trigger("Teleport_Appear");
                }
            }
        }

        if #alive(weapon_target) {
            current_health := weapon_target.health.(s64);
            if !ui_test_health_initialized || current_health != ui_test_health_last {
                Save.set_int(this, "ui_test_current_health", current_health);
                ui_test_health_last = current_health;
                ui_test_health_initialized = true;
            }
            if is_admin_invincible && (!ui_test_invincible_health_initialized || current_health != ui_test_invincible_health_last) {
                Save.set_int(this, "ui_test_invincible_health", current_health);
                ui_test_invincible_health_last = current_health;
                ui_test_invincible_health_initialized = true;
            }
        }

        if ui_test_bonus_bullets_pending {
            Save.set_int(this, "ui_test_ar_ammo_after_bonus", weapon_get_ammo_count(this, .ASSAULT_RIFLE));
        }

        // Independent per-weapon cooldowns - nothing shares cooldown
        for i: 0..63 {
            if weapon_cooldowns[i] > 0 {
                weapon_cooldowns[i] -= dt;
                if weapon_cooldowns[i] < 0 { weapon_cooldowns[i] = 0; }
            }
        }
        // Legacy compat (kept for any external reads)
        if killer_fish_cooldown > 0 {
            killer_fish_cooldown -= dt;
            if killer_fish_cooldown < 0 { killer_fish_cooldown = 0; }
        }

        if is_local() {
            if Voice.get_range() != 12.0 {
                Voice.set_range(12.0);
            }
        }

        if is_mimicer && mimicer_form_target_user_id != "" && mimicer_form_expires_at > 0 && get_time() >= mimicer_form_expires_at {
            restore_mimicer_form(this);
        }

        update_role_mode_player(this, dt);
        update_murder_mystery_player(this, dt);
        troll_tick(this, dt);
        backrooms_monster_tick(this, dt);

        // Reset zoom if dead — keep camera sane
        if is_dead && entity.has_effect(Zoom_Out_Effect) {
            remove_effect(entity, Zoom_Out_Effect, true);
            camera.size = 7.0;
        }
    }

    play_reward_feedback :: method(text: string) {
        reward_feedback_text = text;
        reward_feedback_start = get_time();
        reward_feedback_duration = 1.0;
    }

    ao_late_update :: method(dt: float) {
        if show_admin_panel && !can_access_admin_panel(this) {
            show_admin_panel = false;
        }
        if show_event_panel && !can_access_admin_panel(this) {
            show_event_panel = false;
        }
        if show_admin_shop && !can_access_admin_panel(this) {
            show_admin_shop = false;
        }
        if show_pileo_shop && !is_pileo_harse(this) {
        show_pileo_shop = false;
        show_armor_shop = false;
        }
        if show_caylus_map && !has_caylus_sensor(this) {
            show_caylus_map = false;
            caylus_map_dismissed = false;
        }
        if show_admin_unban && !can_access_admin_panel(this) {
            show_admin_unban = false;
        }
        if show_troll_panel && !can_access_troll_panel(this) {
            show_troll_panel = false;
        }

        if is_local_or_server() {
            if is_murder_mystery_active() && murder_role == .INNOCENT { show_shop = false; }
            if is_murder_mystery_active() && (murder_role == .KILLER || murder_role == .DETECTIVE) {
                draw_ability_button(this, Murder_Fingerprint_Ability, 0);
            }
            if is_murder_mystery_active() && murder_role == .KILLER {
            }
            draw_hud(this);
            if show_codes_panel {
                draw_codes_panel(this);
            }
            if show_caylus_map && has_caylus_sensor(this) {
                draw_caylus_map(this);
            }
            draw_player_statuses();
            if show_shop {
                draw_shop(this);
            }
            if show_armor_shop {
                draw_armor_shop(this);
            }
            if show_tutorial {
                draw_tutorial(this);
            }
            if show_admin_panel && can_access_admin_panel(this) {
                draw_admin_panel(this);
            }
            if show_event_panel && can_access_admin_panel(this) {
                draw_event_panel(this);
            }
            if show_admin_shop && can_access_admin_panel(this) {
                draw_admin_shop(this);
            }
            if show_pileo_shop && is_pileo_harse(this) {
                draw_pileo_shop(this);
            }
            if show_admin_unban && can_access_admin_panel(this) {
                draw_admin_unban(this);
            }
            if show_troll_panel && can_access_troll_panel(this) {
                draw_troll_panel(this);
            }
            // Jumpscare and status overlays are visible to victims themselves (not admin gated)
            if is_local_or_server() {
                draw_troll_jumpscare(this);
                draw_troll_status_overlays(this);
                draw_sniper_overlays(this);
            }
            if show_mimicer_selector {
                draw_mimicer_selector(this);
            }
            if show_minigames {
                draw_minigames(this);
            }
            draw_role_mode_hud(this);
        }

        if is_local_or_server() && !is_dead {
            if is_mimicer {
                draw_ability_button(this, Mimicer_Attack_Ability, 0);
                draw_ability_button(this, Mimicer_Dash_Ability, 1);
                draw_ability_button(this, Mimicer_Shapeshift_Ability, 2);
            } else {
                if role_mode_role == .MEDIC { draw_ability_button(this, Medic_Revive_Ability, 1); }
                if role_mode_role == .FLAGGER { draw_ability_button(this, Flagger_Buff_Ability, 1); }
                // Draw fire ability based on equipped weapon
                if equipped_weapon_type != .NONE && (role_mode_role == .NONE || role_mode_role == .SHERIFF || role_mode_role == .TRAITOR) {
                    config := get_weapon_config(equipped_weapon_type);
                    switch config.fire_mode {
                        case .CONTINUOUS:  { draw_ability_button(this, Continuous_Fire_Ability, 0); }
                        case .SINGLE_SHOT: { draw_ability_button(this, Single_Shot_Ability, 0); }
                        case .SPREAD:      { draw_ability_button(this, Spread_Shot_Ability, 0); }
                        case .LOBBED:      { draw_ability_button(this, Lobbed_Shot_Ability, 0); }
                        case .BEAM:        { draw_ability_button(this, Beam_Ability, 0); }
                        case .SPECIAL:     { draw_ability_button(this, Special_Ability, 0); }
                    }
                }

                // Dynamic ability slots: weapon is always 0, power-ups stack in slots 1..5 on the right side.
                // Distortion's black hole is a weapon secondary, so it gets its own
                // button whenever Distortion is equipped.
                ability_slot := 1;
                if equipped_weapon_type == .DISTORTION {
                    if ability_slot <= 5 { draw_ability_button(this, Distortion_Ability, ability_slot); ability_slot += 1; }
                }
                if has_paperclip {
                    if ability_slot <= 5 { draw_ability_button(this, Paperclip_Ability, ability_slot); ability_slot += 1; }
                }
                if has_dash {
                    if ability_slot <= 5 { draw_ability_button(this, Dash_Ability, ability_slot); ability_slot += 1; }
                }
                if has_invisible {
                    if ability_slot <= 5 { draw_ability_button(this, Invisible_Ability, ability_slot); ability_slot += 1; }
                }
                if has_speed_boost {
                    if ability_slot <= 5 { draw_ability_button(this, Speed_Boost_Ability, ability_slot); ability_slot += 1; }
                }
                if has_zoom_out {
                    if ability_slot <= 5 { draw_ability_button(this, Zoom_Out_Ability, ability_slot); ability_slot += 1; }
                }
                if has_medkit {
                    if ability_slot <= 5 { draw_ability_button(this, Medkit_Ability, ability_slot); ability_slot += 1; }
                }
                if troll_buzz_active {
                    if ability_slot <= 5 { draw_ability_button(this, Buzz_Laser_Ability, ability_slot); ability_slot += 1; }
                    if ability_slot <= 5 { draw_ability_button(this, Buzz_Shield_Ability, ability_slot); ability_slot += 1; }
                }
            }

            // Hotbar
            options := Inventory_Draw_Options.default();
            options.hotbar_item_count = 6;
            options.enable_selection = true;
            options.scroll_item_selection = true;
            options.keyboard_item_selection = true;
            options.enable_use_from_hotbar = true;
            hotbar := Items.draw_hotbar(this, default_inventory, options);
            if #alive(hotbar.selected_item) {
                defn := hotbar.selected_item.get_definition();
                if defn != null && defn.#type == Dice_Item_Definition {
                    use_rng_dice_item(this, hotbar.selected_item);
                } else {
                    use_youtuber_item(this, hotbar.selected_item);
                }
            }
            if #alive(hotbar.dropped_item) {
                defn := hotbar.dropped_item.get_definition();
                if defn != null && defn.#type == Dice_Item_Definition {
                    use_rng_dice_item(this, hotbar.dropped_item);
                } else {
                    dropped: Dropped_Item;
                    if Dropped_Item.handle_dropped_item(hotbar, entity.world_position, ref dropped) {
                        rng := rng_root_seed();
                        dropped.do_spawn_animation(ref rng);
                    }
                }
            }
            handle_equipped_item_changing(hotbar.selected_item_index);
        }
    }

    ao_can_use_ability :: method(ability: Ability_Base) -> bool {
        if is_dead return false;
        if out_of_bounds_respawn_active return false;
        if capture_the_flag_carrying {
            return false;
        }
        // Troll freeze blocks all abilities
        if get_time() < troll_frozen_until {
            return false;
        }
        // Mind control stand still blocks abilities
        if get_time() < troll_control_until && troll_control_mode == 1 {
            return false;
        }
        return true;
    }

    ao_end :: method() {
        save_coin_balance(this);
        Save.set_int(this, PARKOUR_REWARD_KEY, has_claimed_parkour_reward ? 1 : 0);
    }

    handle_equipped_item_changing :: method(selected_index: s64) {
        selected_item: Item_Instance;
        if selected_index >= 0 && selected_index < default_inventory.capacity {
            selected_item = default_inventory.get_item(selected_index);
        }

        new_def: Item_Definition;
        if selected_item != null {
            new_def = selected_item.get_definition();
        }

        if selected_index == last_selected_index && new_def == equipped_item_def return;
        last_selected_index = selected_index;
        if new_def == equipped_item_def return;

        if new_def != g_caylus_sensor_item_def {
            show_caylus_map = false;
            caylus_map_dismissed = false;
        }

        if equipped_weapon_type != .NONE {
            weapon_unequip(this, equipped_weapon_type);
            equipped_weapon_type = .NONE;
        }
        equipped_item_def = null;

        if new_def != null {
            wt := get_weapon_type_for_item(new_def);
            if wt != .NONE {
                weapon_equip(this, wt);
                equipped_weapon_type = wt;
                equipped_item_def = new_def;
            }
        }
    }
}




g_event_ice: bool;
g_event_sun: bool;
g_event_double_coins: bool;
g_event_elemental: bool;
g_active_element_event: s64;
g_event_ends_at: float;
g_event_cyber_energy: bool;
