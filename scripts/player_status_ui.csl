draw_player_statuses :: proc() {
    for player: component_iterator(Player) {
        draw_health_bar(player);
        draw_admin_assigned_element(player);
    }
}

draw_admin_assigned_element :: proc(player: Player) {
    if player == null || player.player_element == 0 return;
    icon := element_icon_for_value(player.player_element);
    name := element_name_for_value(player.player_element);
    if icon == "" || name == "" return;
    UI.begin_world_space_ui(player.entity);
    defer UI.end_world_space_ui();
    rect := UI.get_screen_rect().top_center_rect().offset(0, -6).grow(0, 10, 0, 10);
    ts := UI.default_text_settings();
    ts.size = 14;
    ts.color = {1, 1, 1, 1};
    ts.do_outline = true;
    ts.outline_thickness = 2;
    ts.outline_color = {0, 0, 0, 1};
    UI.text(rect, ts, format_string("% %", {icon, name}));
}

element_icon_for_value :: proc(element: s64) -> string {
    if element == 1 return "[FIRE]";
    if element == 2 return "[WATER]";
    if element == 3 return "[LEAF]";
    if element == 4 return "[ICE]";
    if element == 5 return "[VOID]";
    if element == 6 return "[LIGHTNING]";
    if element == 7 return "[SUN]";
    if element == 8 return "[CYBER]";
    return "";
}

element_name_for_value :: proc(element: s64) -> string {
    if element == 1 return "Fire";
    if element == 2 return "Water";
    if element == 3 return "Leaf";
    if element == 4 return "Ice";
    if element == 5 return "Void";
    if element == 6 return "Lightning";
    if element == 7 return "Sun";
    if element == 8 return "Cyber";
    return "";
}
