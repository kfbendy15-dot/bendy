Player_Leaderboard_Row :: struct {
    player: Player;
    coins: s64;
    display_name: string;
}

build_player_display_name :: proc(player: Player) -> string {
    username := player.get_username();
    if player.user_tag.count > 0 {
        return format_string("% [%]", {username, player.user_tag});
    }
    return username;
}

insert_leaderboard_row :: proc(rows: ref [4]Player_Leaderboard_Row, row_count: ref s64, row: Player_Leaderboard_Row) {
    if row_count < 4 {
        i := row_count;
        while i > 0 {
            prev := i - 1;
            if rows[prev].coins >= row.coins {
                break;
            }
            rows[i] = rows[prev];
            i -= 1;
        }
        rows[i] = row;
        row_count += 1;
        return;
    }

    if row.coins <= rows[3].coins {
        return;
    }

    i := 3;
    while i > 0 {
        prev := i - 1;
        if rows[prev].coins >= row.coins {
            break;
        }
        rows[i] = rows[prev];
        i -= 1;
    }
    rows[i] = row;
}

draw_player_statuses :: proc() {
    for player: component_iterator(Player) {
        draw_health_bar(player);
        draw_admin_assigned_element(player);
    }
}

draw_admin_assigned_element :: proc(player: Player) {
    if player == null || player.player_element == 0 return;
    icon := element_icon_for_value(player.player_element);
    name := element_name_for_value(player.player_element);
    if icon == "" || name == "" return;
    UI.begin_world_space_ui(player.entity);
    defer UI.end_world_space_ui();
    // Wider rect and larger size for clearer readable text
    rect := UI.get_screen_rect().top_center_rect().offset(0, -10).grow(0, 24, 0, 24);
    ts := UI.default_text_settings();
    ts.size = 22;
    ts.color = {1, 1, 1, 1};
    UI.text(rect, ts, format_string("% %", {icon, name}));
}

element_icon_for_value :: proc(element: s64) -> string {
    if element == 1 return "🔥";
    if element == 2 return "🌊";
    if element == 3 return "🍃";
    if element == 4 return "❄";
    if element == 5 return "◈";
    return "";
}

element_name_for_value :: proc(element: s64) -> string {
    if element == 1 return "Fire";
    if element == 2 return "Water";
    if element == 3 return "Leaf";
    if element == 4 return "Ice";
    if element == 5 return "Void";
    return "";
}

draw_leaderboard :: proc(viewer: Player) {
    rows: [4]Player_Leaderboard_Row;
    row_count: s64 = 0;

    for player: component_iterator(Player) {
        row := Player_Leaderboard_Row{};
        row.player = player;
        row.coins = Economy.get_balance(player, "Coins");
        row.display_name = build_player_display_name(player);
        insert_leaderboard_row(ref rows, ref row_count, row);
    }

    UIK.begin(UIK.window(UIK.rect_sidebar_right()));

    shell := UIK.panel_modal(.BLACK);
    shell.padding = v4{12, 12, 12, 12};
    shell.gap = 6;
    UIK.panel_begin(shell);

    UIK.text("Leaderboard", UIK.text_title());
    UIK.divider(1.0, {1, 1, 1, 0.18});

    i := 0;
    while i < row_count {
        row := rows[i];

        entry := UIK.layout_row(UIK.flex(1), UIK.fit(), 8);
        entry.cross_align = .CENTER;
        UIK.panel_begin(entry);

        rank_desc := UIK.text_body();
        rank_desc.size_multiplier = 1.02;
        if row.player == viewer {
            rank_desc.color = {1.0, 0.88, 0.28, 1.0};
        }
        UIK.text(format_string("%.", {i + 1}), rank_desc);

        name_desc := UIK.text_body();
        name_desc.size_multiplier = 1.02;
        if row.player == viewer {
            name_desc.color = {1.0, 0.88, 0.28, 1.0};
        }
        UIK.text(row.display_name, name_desc);

        UIK.spacer(UIK.flex(1), UIK.pixels(1));
    coin_tex := get_asset(Texture_Asset, "$AO/ui/kit/Icons/weapon_tier/weapon_tier_icon_gold.png");
        UIK.currency(coin_tex, row.coins, UIK.text_body());

        UIK.panel_end();
        i += 1;
    }

    UIK.panel_end();
    UIK.end();
}
