// Agent-driven displacement respects movement collision and cleans up on interruption.
Fling_Motion_Effect :: class : Effect_Base {
    direction: v2;
    destination: v2;
    pulling: bool;
    event_delivery: bool;
    speed: float;
    original_friction: float;
    launch_position: v2;
    effect_start :: method() {
        player_specific.disable_movement_inputs = pulling && !event_delivery;
        player_specific.freeze_player = !pulling || event_delivery;
        original_friction = player.agent.friction; player.agent.friction = 0;
        player.active_ability = null;
        if pulling { set_duration(5.0); } else {
            // A bat launches over obstacles rather than stopping at the first fence.
            launch_position = player.entity.world_position;
            destination = launch_position + direction * speed * 0.8;
            destination.x = clamp(destination.x, -20.0, 20.0);
            destination.y = clamp(destination.y, -17.0, 27.0);
            for attempt: 0..<20 {
                blocked := false;
                for box: component_iterator(Box_Collider) {
                    if box.entity.get_world_enabled() && !box.is_trigger && box.overlaps_point(destination) { blocked = true; }
                }
                if !blocked { break; }
                destination -= direction * 0.6;
            }
            set_duration(0.8);
        }
    }
    effect_update :: method(dt: float) {
        p := player.(Player);
        if p.is_dead { remove_effect(true); return; }
        if pulling {
            offset := destination - player.entity.world_position;
            if length(offset) < 0.65 { remove_effect(false); return; }
            if event_delivery {
                // Lift the hooked player over fences on the way to the spawn event.
                player.entity.set_world_position(player.entity.world_position + normalize(offset) * min(speed * dt, length(offset) - 0.4));
                return;
            }
            result := player.agent.set_path_target(destination, 1200);
            dir := normalize(offset);
            if result.success && length(result.move_direction) > 0.1 { dir = result.move_direction; }
            player.agent.velocity = dir * min(speed, length(offset) / max(dt, 0.001));
        } else {
            player.entity.set_world_position(lerp(launch_position, destination, clamp(get_elapsed_time() / 0.8, 0.0, 1.0)));
        }
    }
    effect_end :: method(interrupt: bool) {
        if #alive(player) {
            if !pulling && !interrupt { player.entity.set_world_position(destination); }
            player.agent.friction = original_friction; player.agent.velocity = {0, 0};
        }
    }
}
