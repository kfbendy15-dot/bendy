// Melee ability - universal, always available at slot 1
Melee_Ability :: class : Ability_Base {
    on_init :: proc(ability: Ability_Base) {
        ability.name = "Melee";
        ability.icon = get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/katana.png");
        ability.disable_keybind = true;
        ability.is_aimed_ability = false;
    }

    can_use :: proc(ability: Ability_Base) -> bool {
        return true;
    }

    on_update :: proc(ability: Ability_Base, params: ref Ability_Update_Params) {
        p := ability.player.(Player);

        if params.pressed && params.can_use && ability.current_cooldown <= 0 {
            damage := 25.0;
            swing_radius := 1.5;
            stun_duration := 0.0;

            if p.equipped_weapon_type == .SWORD {
                sword_config := get_weapon_config(.SWORD);
                damage = sword_config.base_damage;
                swing_radius = 2.05;
                stun_duration = 0.35;
            }

            // Trigger melee animation
            p.animator.state_machine.set_trigger("melee_AL");

            // Enable katana skin briefly
            p.animator.enable_skin("weapons/katana");
            p.animator.refresh_skins();

            // Play katana sound
            sfx_desc := SFX.default_sfx_desc();
            sfx_desc.set_position(p.entity.world_position);
            sfx_desc.range_multiplier = 2.0;
            SFX.play(get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/katana_slash.wav"), sfx_desc);

            // Damage nearby targets
            nearby: [..]Weapon_Target;
            pos := p.entity.world_position;
            Scene.get_all_components_in_range(pos, swing_radius, ref nearby);
            for hit: nearby {
                if hit != null {
                    if hit.entity.id != p.entity.id {
                        weapon_target_apply_damage(hit, damage, p.entity.id);
                        if stun_duration > 0 {
                            target_player := hit.entity.get_component(Player);
                            if target_player != null && !target_player.is_dead {
                                apply_weapon_stun(target_player, stun_duration, format_string("sword/%", {p.get_user_id()}));
                            }
                        }
                    }
                }
            }

            ability.current_cooldown = stun_duration > 0 ? 0.55 : 1.0;
        }
    }
}

// Special weapon abilities dispatcher
Special_Ability :: class : Ability_Base {
    was_shooting: bool;
    akimbo_pending_shot: bool;
    akimbo_shot_time: float;
    akimbo_shot_direction: v2;

    on_init :: proc(ability: Ability_Base) {
        ability.name = "Special";
        ability.icon = get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/weapon_icons/weapon_icons_250x250/akimbo_pistols.png");
        ability.disable_keybind = true;
        ability.is_aimed_ability = true;
    }

    can_use :: proc(ability: Ability_Base) -> bool {
        p := ability.player.(Player);
        if p.equipped_weapon_type == .NONE return false;
        config := get_weapon_config(p.equipped_weapon_type);
        if config.fire_mode != .SPECIAL return false;
        if is_admin_only_weapon(p.equipped_weapon_type) && !can_access_admin_panel(p) {
            return false;
        }
        if p.equipped_weapon_type == .SWORD {
            return true;
        }
        return weapon_has_ammo(p, p.equipped_weapon_type);
    }

    on_update :: proc(ability: Ability_Base, params: ref Ability_Update_Params) {
        p := ability.player.(Player);
        self := ability.(Special_Ability);
        wt := p.equipped_weapon_type;
        config := get_weapon_config(wt);

        if is_admin_only_weapon(wt) && !can_access_admin_panel(p) {
            if self.was_shooting {
                weapon_stop_shoot_anim(p, wt);
                self.was_shooting = false;
            }
            return;
        }

        ability.icon = get_asset(Texture_Asset, config.weapon_icon_path);

        aiming := Ability_Utilities.update_aiming_ability(p, ref params);

        if aiming.aim {
            p.last_aim_direction = aiming.aim_direction;
            p.set_aim_target(p.entity.world_position + aiming.aim_direction * 5.0);
            draw_thin_aiming_line(p.entity.world_position, aiming.aim_direction, 1.0);
        }

        if p.device_kind == .PC {
            p.set_mouse_ik_enabled(aiming.aim);
        } else {
            p.set_mouse_ik_enabled(false);
        }

        should_fire := false;
        if p.device_kind == .PC {
            should_fire = aiming.activate;
        } else {
            should_fire = aiming.aim;
        }

        // Akimbo Pistols: fire staggered second shot
        if self.akimbo_pending_shot && get_time() >= self.akimbo_shot_time {
            weapon_spawn_standard_projectile(p, self.akimbo_shot_direction, .AKIMBO_PISTOLS);
            weapon_play_fire_sound(p, .AKIMBO_PISTOLS);
            self.akimbo_pending_shot = false;
        }

        if should_fire && params.can_use && ability.current_cooldown <= 0 {
            switch wt {
                case .SWORD: {
                    weapon_shoot(p, wt);
                    dir := aiming.aim_direction;
                    if length(dir) < 0.1 {
                        dir = v2{1, 0};
                    }
                    if dir.x != 0 {
                        p.set_facing_right(dir.x > 0);
                    }

                    strike_center := v2{
                        p.entity.world_position.x + dir.x * 1.7,
                        p.entity.world_position.y + dir.y * 1.7,
                    };
                    melee_swing_players_in_radius(p, strike_center, 2.0, config.base_damage, 0.35);
                }
                case .AKIMBO_PISTOLS: {
                    weapon_shoot(p, wt);
                    weapon_spawn_standard_projectile(p, aiming.aim_direction, wt);
                    self.akimbo_pending_shot = true;
                    self.akimbo_shot_time = get_time() + 0.15;
                    self.akimbo_shot_direction = aiming.aim_direction;
                }
                case .WIND_BLASTER: {
                    weapon_shoot(p, wt);
                    spawn_tornado_entity(p, aiming.aim_direction, wt);
                }
                case .STORMS_EYE: {
                    weapon_shoot(p, wt);
                    spawn_storms_eye_tornado(p);
                }
                case .ADMIN_GUN: {
                    weapon_shoot(p, wt);
                    closest := get_nearest_vs_target(p, 6.0);
                    if closest != null {
                        if closest.admin_freeze_until <= get_time() {
                            closest.admin_freeze_previous_speed = closest.agent.movement_speed;
                            closest.agent.movement_speed = 0;
                        }
                        closest.admin_freeze_until = get_time() + 2.5;
                    }
                }
                case .BUBBLE_GUN: {
                    weapon_shoot(p, wt);
                    closest := get_nearest_vs_target(p, 8.0);
                    if closest != null && !closest.is_dead {
                        apply_bubble_prison(closest, 3.0);
                    }
                }
                case .INVISIBLE_GUN_ADMIN: {
                    weapon_shoot(p, wt);
                    closest := get_nearest_vs_target(p, 8.0);
                    if closest != null && !closest.is_dead {
                        apply_admin_weapon_invisibility(closest, 4.0);
                    }
                }
                case .BATTLEPASS_GUN: {
                    weapon_shoot(p, wt);
                    start_battlepass_music(p, 3600.0);
                    p.play_reward_feedback("Battlepass");
                }
                case .ADMIN_NUKE_GUN: {
                    secret_admin_nuke_attack(p);
                }
                case .BUILDING_TOOLS: {
                    weapon_shoot(p, wt);
                    target, found := Scene.get_closest_component_in_range(p.entity.world_position, 6.0, Manipulable_Target);
                    if found && target != null {
                        if target.holder == p {
                            target.end_hold();
                        } else if target.holder == null {
                            target.begin_hold(p, aiming.aim_direction);
                        }
                    }
                }
                case .SPOON: {
                    spoon_attack(p);
                }
                case .KILLER_FISH: {
                    killer_fish_attack(p);
                }
                case .LANDMINE: {
                    weapon_shoot(p, wt);
                    dir := aiming.aim_direction;
                    if length(dir) < 0.1 {
                        dir = v2{1, 0};
                        if p.entity.world_position.x < 0 {
                            dir = v2{-1, 0};
                        }
                    }
                    if dir.x != 0 {
                        p.set_facing_right(dir.x > 0);
                    }

                    mine_pos := v2{
                        p.entity.world_position.x + dir.x * 1.0,
                        p.entity.world_position.y - 0.15,
                    };
                    spawn_landmine(mine_pos, p.entity.id, config.aoe_damage, 1.15);
                }
                case .SUBSPACE_TRIPMINE: {
                    weapon_shoot(p, wt);
                    dir := aiming.aim_direction;
                    if length(dir) < 0.1 {
                        dir = v2{1, 0};
                        if p.entity.world_position.x < 0 {
                            dir = v2{-1, 0};
                        }
                    }
                    if dir.x != 0 {
                        p.set_facing_right(dir.x > 0);
                    }

                    mine_pos := v2{
                        p.entity.world_position.x + dir.x * 1.0,
                        p.entity.world_position.y - 0.15,
                    };
                    spawn_subspace_tripmine(mine_pos, p.entity.id, config.aoe_damage);
                }
            }
            ability.current_cooldown = config.fire_rate;
            self.was_shooting = true;
        }

        if !should_fire && self.was_shooting {
            weapon_stop_shoot_anim(p, wt);
            self.was_shooting = false;
        }

        if should_fire && !weapon_has_ammo(p, wt) {
            if p.is_local() {
                Notifier.notify("Out of ammo!");
            }
        }
    }
}
