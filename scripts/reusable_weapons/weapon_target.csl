Weapon_Target :: class : Component {
    health: float;
    max_health: float;
    owner_entity_id: u64; // entity that "owns" this target (for friendly-fire exclusion in user code)

    on_damaged_userdata: Object;
    on_damaged: proc(target: Weapon_Target, damage: float, attacker_id: u64, userdata: Object);
}

weapon_element :: proc(wt: Weapon_Type) -> s64 {
    if wt == .FIRE_RAY || wt == .FIREBALL || wt == .METEORITE || wt == .SOLAR_SIPHONER return 1; // fire
    if wt == .WATER_GUN || wt == .WATER_BALLOON_RPG || wt == .HYDRO_CANNON || wt == .BUBBLE_GUN return 2; // water
    if wt == .POISON_GRENADE || wt == .KILLER_FISH || wt == .SHURIKEN return 3; // leaf
    if wt == .ICE_LAUNCHER || wt == .GLACIATOR return 4; // ice
    return 0; // normal
}

elemental_damage_multiplier :: proc(attacker: s64, defender: s64) -> float {
    if attacker == 0 || defender == 0 return 1.0;
    if attacker == defender return 1.0;
    if (attacker == 2 && defender == 1) || (attacker == 1 && defender == 3) || (attacker == 3 && defender == 2) return 2.0;
    if g_event_ice && ((attacker == 1 && defender == 4) || (attacker == 4 && defender == 3)) return 2.0;
    return 0.5;
}

weapon_target_apply_damage :: proc(target: Weapon_Target, damage: float, attacker_id: u64) {
    if target == null {
        return;
    }

    player := target.entity.get_component(Player);
    if player != null && player.is_admin_invincible {
        return;
    }
    if player != null && player.shield_active {
        player.shield_active = false;
        player.play_reward_feedback("Shield blocked attack");
        return;
    }
    if player != null && player.paperclip_active {
        player.paperclip_active = false;
        for shooter: component_iterator(Player) {
            if shooter.entity.id == attacker_id && shooter.weapon_target != null {
                weapon_target_apply_damage(shooter.weapon_target, damage, player.entity.id);
                player.play_reward_feedback("Paperclip reflected attack");
                return;
            }
        }
    }
    if player != null && is_player_invisible_for_targeting(player) {
        return;
    }

    attacker_element: s64 = 0;
    defender_element: s64 = 0;
    for attacker: component_iterator(Player) {
        if attacker.entity.id == attacker_id {
            attacker_element = weapon_element(attacker.equipped_weapon_type);
            if attacker_element == 0 { attacker_element = attacker.gun_mutation_element; }
            break;
        }
    }
    if player != null { defender_element = weapon_element(player.equipped_weapon_type); }
    target.health -= damage * elemental_damage_multiplier(attacker_element, defender_element);
    if target.health < 0 {
        target.health = 0;
    }
    if target.on_damaged != null {
        target.on_damaged(target, damage, attacker_id, target.on_damaged_userdata);
    }
}


