Weapon_Target :: class : Component {
    health: float;
    max_health: float;
    owner_entity_id: u64; // entity that "owns" this target (for friendly-fire exclusion in user code)

    on_damaged_userdata: Object;
    on_damaged: proc(target: Weapon_Target, damage: float, attacker_id: u64, userdata: Object);
}

weapon_element :: proc(wt: Weapon_Type) -> s64 {
    if wt == .FIRE_RAY || wt == .FIREBALL || wt == .METEORITE || wt == .SOLAR_SIPHONER || wt == .SUN_SHOOTER_SAND return 1; // fire
    if wt == .WATER_GUN || wt == .WATER_BALLOON_RPG || wt == .HYDRO_CANNON || wt == .BUBBLE_GUN || wt == .SUN_SHOOTER_TSUNAMI return 2; // water
    if wt == .POISON_GRENADE || wt == .KILLER_FISH || wt == .SHURIKEN return 3; // leaf
    if wt == .ICE_LAUNCHER || wt == .GLACIATOR return 4; // ice
    if wt == .WARPER return 5; // void - black hole
    if wt == .RAY_GUN || wt == .STORMS_EYE return 6; // lightning
    return 0; // normal
}

elemental_damage_multiplier :: proc(attacker: s64, defender: s64) -> float {
    if attacker == 0 || defender == 0 return 1.0;
    if attacker == defender return 1.0;
    if (attacker == 2 && defender == 1) || (attacker == 1 && defender == 3) || (attacker == 3 && defender == 2) return 2.0;
    if (attacker == 5 && (defender == 1 || defender == 2 || defender == 3)) return 2.0;
    if attacker == 1 && defender == 5 return 2.0;
    if attacker == 6 && (defender == 1 || defender == 2 || defender == 3) return 2.0;
    if (attacker == 5 || attacker == 4) && defender == 6 return 2.0;
    if g_event_ice && ((attacker == 1 && defender == 4) || (attacker == 4 && defender == 3)) return 2.0;
    return 0.5;
}

// Returns the final elemental damage so callbacks and hit feedback agree with health loss.
elemental_damage_amount :: proc(damage: float, attacker: s64, defender: s64, target_pos: v2) -> float {
    return damage * elemental_damage_multiplier(attacker, defender) * elemental_zone_multiplier(attacker, target_pos);
}

elemental_zone_multiplier :: proc(attacker: s64, pos: v2) -> float {
    // Public elemental lands: lava (east), lake (south), jungle (north-west), snow (north).
    in_lava := pos.x > 16 && pos.y < -6;
    in_lake := abs(pos.x) < 8 && pos.y < -6;
    in_jungle := pos.x < -16 && pos.y > 6;
    in_snow := abs(pos.x) < 8 && pos.y > 6;
    if in_lava && attacker == 2 return 2.0; // water beats lava
    if in_lake && (attacker == 3 || attacker == 4) return 2.0; // leaf and ice beat lake
    if in_jungle && attacker == 4 return 2.0; // ice beats jungle
    if in_snow && attacker == 1 return 2.0; // fire beats snow
    return 1.0;
}

weapon_target_apply_damage :: proc(target: Weapon_Target, damage: float, attacker_id: u64) {
    if target == null {
        return;
    }

    player := target.entity.get_component(Player);
    if player != null && player.is_admin_invincible {
        return;
    }
    if player != null && is_player_invisible_for_targeting(player) {
        return;
    }

    attacker_element: s64 = 0;
    attacker_weapon := Weapon_Type.NONE;
    defender_element: s64 = 0;
    for attacker: component_iterator(Player) {
        if attacker.entity.id == attacker_id {
            attacker_weapon = attacker.equipped_weapon_type;
            attacker_element = weapon_element(attacker.equipped_weapon_type);
            if attacker_element == 0 { attacker_element = attacker.gun_mutation_element; }
            break;
        }
    }
    if player != null {
        defender_element = player.player_element;
        if defender_element == 0 { defender_element = weapon_element(player.equipped_weapon_type); }
    }
    if player != null && attacker_weapon == .ICE_LAUNCHER {
        if player.admin_freeze_until <= get_time() {
            player.admin_freeze_previous_speed = player.agent.movement_speed;
        }
        player.agent.movement_speed = 150.0;
        player.admin_freeze_until = get_time() + 2.5;
    }
    target_pos := target.entity.world_position;
    final_damage := elemental_damage_amount(damage, attacker_element, defender_element, target_pos);
    target.health -= final_damage;
    if target.health < 0 {
        target.health = 0;
    }
    if target.on_damaged != null {
        target.on_damaged(target, final_damage, attacker_id, target.on_damaged_userdata);
    }
}


