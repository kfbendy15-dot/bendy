Reload_Effect :: class : Effect_Base {
    weapon: Weapon_Type;
    effect_start :: method() { set_duration(1.2); }
    effect_end :: method(interrupt: bool) {
        if interrupt { return; }
        p := player.(Player);
        p.gun_magazine[weapon.(int)] = min(p.gun_magazine_size[weapon.(int)], weapon_get_ammo_count(p, weapon));
        adventure_sound(p.entity);
    }
}
