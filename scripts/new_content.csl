// New content for requested features: Medkit, Battle Axe, Distortion, Void2, Fight modes
MEDKIT_COST :: 50000;
DISTORTION_COST :: 1000;
FLAMETHROWER_COST :: 45;
MOLOTOV_COST :: 50;
BATTLE_AXE_COST :: 75;
LASER_GUN_COST :: 60;

g_event_void2: bool;
g_fight_active: bool;
g_fight_rng_active: bool;
g_rng_rolls_remaining: s64;
g_rng_max_rolls: s64;

Dice_Item_Definition :: class : Item_Definition {
}

g_dice_item_def: Dice_Item_Definition;
g_dice_initialized: bool;

// Medkit
Medkit_Effect :: class : Effect_Base {
    heal_reason: string;

    effect_start :: method() {
        if heal_reason == "" {
            heal_reason = format_string("medkit_bandage/%/%", {player.get_user_id(), get_frame_number()});
        }
        player.add_freeze_reason(heal_reason);
        player.add_disable_movement_input_reason(heal_reason);
        set_duration(7.0);
        spawn_simple_vfx("reusable_weapons/anims/reusable-weapons/Heal_Effect/heal_effect.spine", "default", player.entity.world_position, {0.9, 0.9}, "Swirl", 7.0);
        if player.is_local() {
            sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/heal_oneshot.wav");
            desc := SFX.default_sfx_desc();
            desc.entity_to_follow = player.entity.id;
            desc.volume = 0.5;
            SFX.play(sfx, desc);
        }
    }
    effect_update :: method(dt: float) {
        if #alive(player) {
            player.agent.velocity = {0, 0};
            player.agent.input_this_frame = {0, 0};
        }
    }
    effect_end :: method(interrupt: bool) {
        player.remove_freeze_reason(heal_reason);
        player.remove_disable_movement_input_reason(heal_reason);
        if !interrupt && #alive(player) {
            p := player.(Player);
            if p.weapon_target != null {
                p.weapon_target.health += 40;
                if p.weapon_target.health > p.weapon_target.max_health { p.weapon_target.health = p.weapon_target.max_health; }
                p.play_reward_feedback("+40 HP");
                Save.set_int(p, "ui_test_medkit_healed", 1);
            }
        }
    }
}

Medkit_Ability :: class : Ability_Base {
    on_init :: method() {
        name = "Medkit";
        icon = get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_1/shield_iron.png");
    }
    can_use :: method() -> bool {
        p := player.(Player);
        if !p.has_medkit return false;
        if p.entity.has_effect(Medkit_Effect) return false;
        return true;
    }
    on_update :: method(params: ref Ability_Update_Params) {
        if params.clicked && params.can_use {
            current_cooldown = 67.0; // 7 + 60
            player.entity.add_passive_effect(new(Medkit_Effect));
            if player.is_local() {
                p := player.(Player);
                p.play_reward_feedback("Bandaging 7s");
            }
        }
    }
}

// Battle Axe leap
Battle_Axe_Leap_Effect :: class : Effect_Base {
    leap_direction: v2;
    elapsed: float;
    leap_speed: float;

    effect_start :: method() {
        leap_speed = 18.0;
        elapsed = 0;
        set_duration(0.35);
        if leap_direction.x != 0 {
            player.set_facing_right(leap_direction.x > 0);
        }
        player.animator.state_machine.set_trigger("dodge_roll");
    }
    effect_update :: method(dt: float) {
        elapsed += dt;
        player.agent.velocity = v2{leap_direction.x * leap_speed, leap_direction.y * leap_speed * 0.6};
        // dampen over time
        leap_speed = lerp(leap_speed, 0, dt * 3.0);
    }
    effect_end :: method(interrupt: bool) {
        if interrupt return;
        p := player.(Player);
        // damage on landing area
        pos := p.entity.world_position;
        melee_swing_players_in_radius(p, pos, 2.5, 30.0, 0.4);
        spawn_simple_vfx("reusable_weapons/anims/reusable-weapons/electric_burst/014ANT_Electric_Shockwave.spine", "default", pos, {1.2, 1.2}, "Shockwave_Burst", 0.6);
        sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/katana_slash.wav");
        desc := SFX.default_sfx_desc();
        desc.set_position(pos);
        SFX.play(sfx, desc);
    }
}

// Distortion vortex (big black hole that makes people circle)
Distortion_Vortex :: class : Component {
    owner_id: u64;
    radius: float;
    lifetime: float;
    max_lifetime: float;
    pull_strength: float;
    orbit_speed: float;

    ao_start :: method() {
        entity.set_local_scale({2.8, 2.8});
        s := entity.get_component(Sprite_Renderer);
        if s == null {
            s = entity.add_component(Sprite_Renderer);
            s.set_texture(get_asset(Texture_Asset, "$AO/circle.png"));
        }
        s.color = {0.02, 0.02, 0.08, 0.95};
        s.layer = -6;
        inner := Scene.create_entity();
        inner.set_parent(entity, false);
        inner.set_local_scale({0.6, 0.6});
        isp := inner.add_component(Sprite_Renderer);
        isp.set_texture(get_asset(Texture_Asset, "$AO/circle.png"));
        isp.color = {0.2, 0.05, 0.35, 0.9};
    }
    ao_update :: method(dt: float) {
        lifetime += dt;
        if lifetime >= max_lifetime {
            entity.destroy();
            return;
        }
        // pull and orbit
        nearby: [..]Player;
        Scene.get_all_components_in_range(entity.world_position, radius, ref nearby);
        for victim: nearby {
            if victim == null || victim.entity.id == owner_id || victim.is_dead { continue; }
            if is_player_invisible_for_targeting(victim) { continue; }
            to_center := entity.world_position - victim.entity.world_position;
            dist := length(to_center);
            if dist < 0.2 { continue; }
            dir_to_center := normalize(to_center);
            // perpendicular for orbit
            orbit_dir := v2{-dir_to_center.y, dir_to_center.x};
            // combine pull + orbit
            pull := v2{dir_to_center.x * pull_strength, dir_to_center.y * pull_strength};
            orbit := v2{orbit_dir.x * orbit_speed, orbit_dir.y * orbit_speed};
            total := v2{pull.x * 0.4 + orbit.x, pull.y * 0.4 + orbit.y};
            victim.agent.velocity = total;
            victim.agent.input_this_frame = {0,0};
            apply_weapon_stun(victim, 0.5, format_string("distortion/%/%", {owner_id, get_frame_number()}));
        }
        // pulse
        pulse := 1.0 + sin(lifetime * 3.0) * 0.06;
        entity.set_local_scale({2.8 * pulse, 2.8 * pulse});
    }
}

spawn_distortion_vortex :: proc(pos: v2, owner_id: u64) {
    e := Scene.create_entity();
    e.set_local_position(pos);
    e.set_local_scale({2.8, 2.8});
    spr := e.add_component(Sprite_Renderer);
    spr.set_texture(get_asset(Texture_Asset, "$AO/circle.png"));
    spr.color = {0.02, 0.02, 0.08, 0.95};
    v := e.add_component(Distortion_Vortex);
    v.owner_id = owner_id;
    v.radius = 5.2;
    v.max_lifetime = 20.0;
    v.pull_strength = 6.0;
    v.orbit_speed = 7.5;
    // sound
    sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/void_splitter_shoot_start.wav");
    desc := SFX.default_sfx_desc();
    desc.entity_to_follow = e.id;
    desc.loop = true;
    desc.volume = 0.4;
    SFX.play(sfx, desc);
}

Distortion_Ability :: class : Ability_Base {
    on_init :: method() {
        name = "Distortion Hole";
        icon = get_asset(Texture_Asset, "$AO/circle.png");
    }
    can_use :: method() -> bool {
        p := player.(Player);
        if p.equipped_weapon_type != .DISTORTION return false;
        return true;
    }
    on_update :: method(params: ref Ability_Update_Params) {
        activation := Ability_Utilities.full_update_targeted_aimed_ability(player, this, ref params);
        // Use secondary activation: we treat any click as vortex if cooldown ready, but primary fire is handled by Single_Shot
        // Here we check for hold activation separate from primary
        if activation.activate && current_cooldown <= 0 {
            p := player.(Player);
            dir := activation.direction;
            if length(dir) < 0.1 { dir = v2{1,0}; }
            dir = normalize(dir);
            pos := v2{p.entity.world_position.x + dir.x * 2.5, p.entity.world_position.y + dir.y * 0.5};
            spawn_distortion_vortex(pos, p.entity.id);
            current_cooldown = 25.0;
            p.play_reward_feedback("Distortion Vortex 20s");
            if p.is_local() {
                sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/void_splitter_shoot_start.wav");
                desc := SFX.default_sfx_desc();
                desc.entity_to_follow = p.entity.id;
                SFX.play(sfx, desc);
            }
        }
    }
}

// Void2 event helpers
void2_price :: proc(base: s64) -> s64 {
    if g_event_void2 { return base / 2; }
    return base;
}

start_void2_event :: proc(admin: Player) {
    g_event_void2 = true;
    cur_v2 := Save.get_game_int(EVENT_VOID2_KEY, 0);
    if cur_v2 == 0 { Save.increment_game_int(EVENT_VOID2_KEY, 1); }
    g_event_elemental = true;
    g_active_element_event = 5;
    g_event_ends_at = get_time() + 600.0;
    cur_elem := Save.get_game_int(EVENT_ELEMENTAL_KEY, 0);
    if cur_elem == 0 { Save.increment_game_int(EVENT_ELEMENTAL_KEY, 1); }
    if admin != null { admin.play_reward_feedback("Void #2 Event started"); }
    Chat.server_send_message("Void #2 Event started");
}

stop_void2_event :: proc() {
    g_event_void2 = false;
    cur_v2 := Save.get_game_int(EVENT_VOID2_KEY, 0);
    if cur_v2 != 0 { Save.increment_game_int(EVENT_VOID2_KEY, -cur_v2); }
}

// Fight modes
start_fight_event :: proc(admin: Player) {
    g_fight_active = true;
    // give everyone basic guns if needed and reset health
    for p: component_iterator(Player) {
        if p.is_dead { respawn_player(p); }
        if p.weapon_target != null { p.weapon_target.health = p.weapon_target.max_health; }
        p.play_reward_feedback("FIGHT STARTED!");
    }
    Chat.server_send_message("FIGHT started! Last alive wins 60200 Coins");
    Save.set_int(admin, "ui_test_fight_started", 1);
}

check_fight_winner :: proc() {
    if !g_fight_active return;
    alive: [..]Player;
    for p: component_iterator(Player) {
        if !p.is_dead { alive.append(p); }
    }
    if alive.count == 1 {
        winner := alive[0];
        award_coins(winner, 60200);
        winner.play_reward_feedback("Fight Winner +60200");
        Chat.server_send_message(format_string("% won the Fight! +60200 Coins", {winner.get_username()}));
        g_fight_active = false;
        Save.set_int(winner, "ui_test_fight_winner", 1);
    } else if alive.count == 0 {
        g_fight_active = false;
    }
}

// RNG Fight - dice rolls - now inventory based
g_rng_active: bool;
g_rng_owner_id: string;
g_rng_rolls_left: s64;
g_rng_total_rolls: s64;

init_dice_item :: proc() {
    if g_dice_initialized {
        return;
    }
    g_dice_initialized = true;
    icon := get_asset(Texture_Asset, "$AO/ui/kit/Icons/dice/dice_icon.png");
    desc: Item_Definition_Desc;
    desc.id = "rng_dice";
    desc.name = "RNG Dice";
    desc.icon = icon;
    desc.stack_size = 10;
    g_dice_item_def = Items.register_item_definition(desc, Dice_Item_Definition);
}

grant_rng_dice :: proc(player: Player, count: s64) -> bool {
    if player == null || g_dice_item_def == null {
        return false;
    }
    if count <= 0 {
        return false;
    }
    remaining := count;
    granted: s64 = 0;
    while remaining > 0 {
        chunk := remaining;
        if chunk > 10 {
            chunk = 10;
        }
        item := Items.create_item_instance(g_dice_item_def, chunk);
        will_destroy: bool;
        if Items.can_move_item_to_inventory(item, player.default_inventory, ref will_destroy) {
            Items.move_item_to_inventory(item, player.default_inventory);
            granted += chunk;
            remaining -= chunk;
        } else {
            Items.destroy_item_instance(item);
            break;
        }
    }
    return granted > 0;
}

rng_reward_pool :: proc(idx: s64) -> string {
    pool: [9]string = {"Assault Rifle", "SMG", "Blunderbuss", "Flamethrower", "Molotov", "Battle Axe", "Distortion", "Medkit", "Glass Cannon"};
    if idx < 0 || idx >= 9 {
        return pool[0];
    }
    return pool[idx];
}

grant_rng_reward :: proc(player: Player, reward: string) {
    if reward == "Assault Rifle" { give_weapon(.ASSAULT_RIFLE, player.default_inventory); }
    else if reward == "SMG" { give_weapon(.SUBMACHINE_GUN, player.default_inventory); }
    else if reward == "Blunderbuss" { give_weapon(.BLUNDERBUSS, player.default_inventory); }
    else if reward == "Flamethrower" { give_weapon(.FLAMETHROWER, player.default_inventory); }
    else if reward == "Molotov" { give_weapon(.MOLOTOV, player.default_inventory); }
    else if reward == "Battle Axe" { give_weapon(.BATTLE_AXE, player.default_inventory); }
    else if reward == "Distortion" { give_weapon(.DISTORTION, player.default_inventory); }
    else if reward == "Medkit" { player.has_medkit = true; }
    else if reward == "Glass Cannon" { give_weapon(.GLASS_CANNON, player.default_inventory); }
}

use_rng_dice_item :: proc(player: Player, item: Item_Instance) -> bool {
    if player == null || item == null {
        return false;
    }
    defn := item.get_definition();
    if defn == null || defn != g_dice_item_def {
        return false;
    }
    rng: u64 = rng_root_seed() ^ cast(u64)(get_frame_number() * 9973) ^ cast(u64)(player.entity.id * 131);
    idx := rng_range_int(ref rng, 0, 8);
    reward := rng_reward_pool(idx);
    grant_rng_reward(player, reward);
    player.play_reward_feedback(format_string("RNG: %", {reward}));
    Save.set_string(player, "ui_test_rng_last", reward);
    Items.destroy_item_instance(item, 1);
    if player.is_local() {
        sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/equip_gun.wav");
        desc := SFX.default_sfx_desc();
        desc.entity_to_follow = player.entity.id;
        desc.volume = 0.6;
        SFX.play(sfx, desc);
    }
    return true;
}

start_fight_rng :: proc(admin: Player) {
    if admin == null {
        return;
    }
    if g_dice_item_def == null {
        init_dice_item();
    }
    rng: u64 = rng_root_seed();
    rolls := rng_range_int(ref rng, 1, 10);
    if grant_rng_dice(admin, rolls) {
        admin.play_reward_feedback(format_string("RNG: % dice in inventory", {rolls}));
        Save.set_int(admin, "ui_test_rng_rolls", rolls);
        // keep legacy globals for UI compat but not used for rolling
        g_rng_active = true;
        g_rng_owner_id = admin.get_user_id();
        g_rng_total_rolls = rolls;
        g_rng_rolls_left = rolls;
    } else {
        admin.play_reward_feedback("No room for dice");
    }
}

do_rng_roll :: proc(player: Player) -> string {
    if player == null {
        return "";
    }
    // Prefer inventory dice if available
    if g_dice_item_def != null {
        for i: 0..player.default_inventory.capacity - 1 {
            it := player.default_inventory.get_item(i);
            if it == null {
                continue;
            }
            if it.get_definition() == g_dice_item_def {
                rng: u64 = rng_root_seed() ^ cast(u64)(get_frame_number() * 9973) ^ cast(u64)(player.entity.id * 131);
                 idx := rng_range_int(ref rng, 0, 8);
                reward := rng_reward_pool(idx);
                grant_rng_reward(player, reward);
                player.play_reward_feedback(format_string("RNG: %", {reward}));
                Save.set_string(player, "ui_test_rng_last", reward);
                Items.destroy_item_instance(it, 1);
                if player.is_local() {
                    sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/equip_gun.wav");
                    desc := SFX.default_sfx_desc();
                    desc.entity_to_follow = player.entity.id;
                    desc.volume = 0.6;
                    SFX.play(sfx, desc);
                }
                return reward;
            }
        }
    }
    // fallback to legacy global rolls if no dice item
    if !g_rng_active {
        return "";
    }
    if player.get_user_id() != g_rng_owner_id {
        return "";
    }
    if g_rng_rolls_left <= 0 {
        return "";
    }
    g_rng_rolls_left -= 1;
    rng: u64 = rng_root_seed() ^ cast(u64)(get_frame_number() * 9973);
    pool: [9]string = {"Assault Rifle", "SMG", "Blunderbuss", "Flamethrower", "Molotov", "Battle Axe", "Distortion", "Medkit", "Glass Cannon"};
    idx := rng_range_int(ref rng, 0, 8);
    reward := pool[idx];
    grant_rng_reward(player, reward);
    player.play_reward_feedback(format_string("RNG: % (% left)", {reward, g_rng_rolls_left}));
    Save.set_string(player, "ui_test_rng_last", reward);
    if g_rng_rolls_left <= 0 {
        g_rng_active = false;
        g_rng_owner_id = "";
    }
    return reward;
}

