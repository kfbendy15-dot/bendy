MURDER_MYSTERY_ROUND_TIME :: 420.0;
Murder_Role :: enum { NONE; KILLER; DETECTIVE; INNOCENT; SUSPECT; }

message_contains :: proc(message: string, needle: string) -> bool {
    if needle.count == 0 return true;
    if message.count < needle.count return false;

    limit := message.count - needle.count;
    i: s64 = 0;
    while i <= limit {
        matched := true;
        j: s64 = 0;
        while j < needle.count {
            if message[i + j] != needle[j] {
                matched = false;
                break;
            }
            j += 1;
        }
        if matched return true;
        i += 1;
    }
    return false;
}

Murder_Mystery_Manager :: class : Component {
    ends_at: float;
    active: bool;
    ao_start :: method() { active = true; ends_at = get_time() + MURDER_MYSTERY_ROUND_TIME; assign_murder_roles(); Chat.server_send_message("Murder Mystery started. The Detective has a fingerprint kit."); }
    ao_update :: method(dt: float) {
        if get_time() >= ends_at { end_murder_mystery("Time is up. Innocents win!"); return; }
        living: s64 = 0; killers: s64 = 0;
        for p: component_iterator(Player) { if !p.is_dead { living += 1; } if p.murder_role == .KILLER && !p.is_dead { killers += 1; } }
        if living == 0 || killers == 0 { end_murder_mystery("The Innocents win!"); }
    }
    ao_end :: method() { for p: component_iterator(Player) { reset_murder_player(p); } }
}

assign_murder_roles :: proc() {
    players: [..]Player;
    for p: component_iterator(Player) { players.append(p); p.murder_role = .INNOCENT; p.murder_kills = 0; p.murderer_chance_percent = 0; p.detective_chance_percent = 0; p.murder_round_active = true; }
    if players.count < 3 return;
    killers: s64 = players.count >= 15 ? 3 : players.count >= 9 ? 2 : 1;
    // These are the odds for this round, not the final assigned role. Keep
    // them on every player so the HUD remains useful when an admin overrides
    // a role from the panel.
    murderer_chance := killers.(float) / players.count.(float) * 100.0;
    detective_chance := 1.0 / players.count.(float) * 100.0;
    for p: players { p.murderer_chance_percent = murderer_chance; p.detective_chance_percent = detective_chance; }
    for i: 0..<killers { players[i].murder_role = .KILLER; }
    players[killers].murder_role = .DETECTIVE;
    for p: players { murder_give_loadout(p); p.play_reward_feedback(format_string("Role: %", {murder_role_name(p.murder_role)})); }
}

murder_role_name :: proc(role: Murder_Role) -> string { switch role { case .KILLER: return "Murderer"; case .DETECTIVE: return "Detective"; case .SUSPECT: return "Suspect"; default: return "Innocent"; } }
reset_murder_player :: proc(p: Player) { if p == null return; p.murder_role = .NONE; p.murder_kills = 0; p.murder_round_active = false; p.murder_permadead = false; }
is_murder_mystery_active :: proc() -> bool { for m: component_iterator(Murder_Mystery_Manager) { return m.active; } return false; }
start_murder_mystery :: proc(player: Player) { if player == null || !can_access_admin_panel(player) || is_murder_mystery_active() return; e := Scene.create_entity(); e.set_name("Murder_Mystery"); e.add_component(Murder_Mystery_Manager); }
end_murder_mystery :: proc(message: string) {
    for m: component_iterator(Murder_Mystery_Manager) {
        Chat.server_send_message(message);
        killer_alive := false;
        for p: component_iterator(Player) {
            won := false;
            if p.murder_role == .KILLER { won = !p.is_dead && message_contains(message, "Killer"); killer_alive = !p.is_dead; }
            else if p.murder_role == .DETECTIVE { won = !p.is_dead && !killer_alive && message_contains(message, "Innocent"); }
            else if p.murder_role == .INNOCENT { won = !p.is_dead && message_contains(message, "Innocent"); }
        }
        m.entity.destroy(); return;
    }
}

murder_give_loadout :: proc(p: Player) {
    i: s64 = 0;
    while i < p.default_inventory.capacity {
        item := p.default_inventory.get_item(i);
        if item != null && get_weapon_type_for_item(item.get_definition()) != .NONE { Items.destroy_item_instance(item); }
        i += 1;
    }
    // The round uses only its own pistol loadout; normal weapons are not granted.
    murder_give_item(p, .RAY_GUN, 1);
    murder_give_ammo(p, .RAY_GUN, 1);
    p.agent.movement_speed = 360.0;
    if p.murder_role == .KILLER { murder_give_item(p, .SHURIKEN, 1); }
}
murder_give_item :: proc(p: Player, wt: Weapon_Type, count: s64) { def := get_weapon_item_def(wt); if def == null return; item := Items.create_item_instance(def, count); destroyed: bool; if Items.can_move_item_to_inventory(item, p.default_inventory, ref destroyed) { Items.move_item_to_inventory(item, p.default_inventory); } else { Items.destroy_item_instance(item); } }
murder_give_ammo :: proc(p: Player, wt: Weapon_Type, count: s64) { def := get_ammo_def_for_weapon(wt); if def == null return; item := Items.create_item_instance(def, count); destroyed: bool; if Items.can_move_item_to_inventory(item, p.default_inventory, ref destroyed) { Items.move_item_to_inventory(item, p.default_inventory); } else { Items.destroy_item_instance(item); } }

Murder_Fingerprint_Ability :: class : Ability_Base {
    on_init :: method() { name = "Fingerprint"; icon = get_asset(Texture_Asset, "$AO/ui/kit/Icons/trophies_rewards/crown_gold.png"); }
    can_use :: method() -> bool { p := player.(Player); return is_murder_mystery_active() && !p.is_dead && p.murder_role == .DETECTIVE; }
    on_update :: method(params: ref Ability_Update_Params) { if !params.clicked || !params.can_use return; p := player.(Player); closest: Player = null; best := 4.0; for other: component_iterator(Player) { if other == p || other.is_dead continue; d := length_squared(other.entity.world_position - p.entity.world_position); if d < best { best = d; closest = other; } } if closest == null { p.play_reward_feedback("Get closer to a player"); return; } if closest.murder_role == .INNOCENT { p.play_reward_feedback(format_string("{0}: Innocent", {closest.get_username()})); } else { closest.murder_role = .SUSPECT; p.play_reward_feedback(format_string("{0}: Suspect", {closest.get_username()})); } current_cooldown = 2.0; }
}

update_murder_mystery_player :: proc(p: Player, dt: float) { }
murder_kill_reward :: proc(killer: Player) { if killer != null { killer.murder_kills += 1; } }
set_murder_role :: proc(target: Player, role: Murder_Role) { if target == null || !is_murder_mystery_active() return; target.murder_role = role; target.play_reward_feedback(format_string("Role: %", {murder_role_name(role)})); }
