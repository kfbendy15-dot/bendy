reset_test_shop_state :: proc(player: Player) {
    if player == null {
        return;
    }

    items_to_destroy: [..]Item_Instance;
    inv := player.default_inventory;
    for i: 0..inv.capacity - 1 {
        item := inv.get_item(i);
        if item != null {
            items_to_destroy.append(item);
        }
    }

    for item: items_to_destroy {
        Items.destroy_item_instance(item);
    }

    current := Economy.get_balance(player, "Coins");
    if current < 100 {
        Economy.deposit_currency(player, "Coins", 100 - current);
    } else if current > 100 {
        Economy.withdraw_currency(player, "Coins", current - 100);
    }
    Save.set_int(player, "ui_test_monetization_passes_granted", 0);
    Save.set_int(player, "ui_test_monetization_mode", 0);
    save_coin_balance(player);
} @chat_command @owner_or_editor

hb_test_drop_target :: proc(player: Player) {
    if !#alive(player) {
        return;
    }

    player.weapon_target = null;
    player.ui_test_restore_weapon_target_at = get_time() + 2.0;
    Save.set_int(player, "ui_test_health_bar_target_restored", 0);
} @chat_command @owner_or_editor

vip_test_grant :: proc(player: Player) {
    player.has_vip = true;
    Save.set_int(player, VIP_SAVE_KEY, 1);
    current := Economy.get_balance(player, "Coins");
    if current < 100 {
        Economy.deposit_currency(player, "Coins", 100 - current);
    } else if current > 100 {
        Economy.withdraw_currency(player, "Coins", current - 100);
    }
} @chat_command @owner_or_editor

open_test_shop :: proc(player: Player) {
    if player == null {
        return;
    }

    player.shop_tab_index = 0;
    player.show_shop = true;
    Save.set_int(player, "ui_test_show_shop", 1);
} @chat_command @owner_or_editor

open_test_monetization_tab :: proc(player: Player) {
    if player == null {
        return;
    }

    player.shop_tab_index = 1;
    player.show_shop = true;
    Save.set_int(player, "ui_test_monetization_mode", 1);
    Save.set_int(player, "ui_test_show_shop", 1);
} @chat_command @owner_or_editor

monetization_test_grant_coin_passes :: proc(player: Player) {
    if player == null {
        return;
    }

    Economy.deposit_currency(player, "Coins", 1925);
    save_coin_balance(player);
    Save.set_int(player, "ui_test_monetization_passes_granted", 1);
} @chat_command @owner_or_editor

prepare_admin_shop_test :: proc(player: Player) {
    if player == null {
        return;
    }

    set_admin_permission(player.get_username(), true);
    Economy.deposit_currency(player, "Coins", 5000);
    save_coin_balance(player);
    player.show_shop = false;
    player.show_admin_panel = false;
    player.show_admin_shop = false;
    Save.set_string(player, "ui_test_current_map", "");
    Save.set_int(player, "ui_test_spoon_hit", 0);
    Save.set_int(player, "ui_test_killer_fish_used", 0);
    Save.set_int(player, "ui_test_giant_gun_used", 0);
    Save.set_int(player, "ui_test_meteor_boss_spawned", 0);
    Save.set_string(player, "ui_test_verity_answer", "");
} @chat_command @owner_or_editor

admin_backrooms_test_send :: proc(player: Player) {
