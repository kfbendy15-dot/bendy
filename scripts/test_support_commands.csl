admin_shop_test_grant_verity :: proc(player: Player) {
    if player == null {
        return;
    }

    grant_verity_item(player);
} @chat_command @owner_or_editor

admin_shop_test_place_verity :: proc(player: Player) {
    if player == null {
        return;
    }

    grant_verity_item(player);
    for i: 0..player.default_inventory.capacity - 1 {
        item := player.default_inventory.get_item(i);
        if item == null {
            continue;
        }
        if item.get_definition() == g_verity_item_def {
            place_verity_item(player, item);
            break;
        }
    }
} @chat_command @owner_or_editor

admin_shop_test_verity_chat :: proc(player: Player) {
    if player == null {
        return;
    }

    grant_verity_item(player);
    for i: 0..player.default_inventory.capacity - 1 {
        item := player.default_inventory.get_item(i);
        if item == null {
            continue;
        }
        if item.get_definition() == g_verity_item_def {
            place_verity_item(player, item);
            break;
        }
    }
    handle_verity_chat_message(player, "verity, what are you?");
} @chat_command @owner_or_editor

