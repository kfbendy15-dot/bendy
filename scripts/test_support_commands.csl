reset_test_shop_state :: proc(player: Player) {
    if player == null {
        return;
    }

    items_to_destroy: [..]Item_Instance;
    inv := player.default_inventory;
    for i: 0..inv.capacity - 1 {
        item := inv.get_item(i);
        if item != null {
            items_to_destroy.append(item);
        }
    }

    for item: items_to_destroy {
        Items.destroy_item_instance(item);
    }

    current := Economy.get_balance(player, "Coins");
    if current < 100 {
        Economy.deposit_currency(player, "Coins", 100 - current);
    } else if current > 100 {
        Economy.withdraw_currency(player, "Coins", current - 100);
    }
    Save.set_int(player, "ui_test_monetization_passes_granted", 0);
    Save.set_int(player, "ui_test_monetization_mode", 0);
    save_coin_balance(player);
} @chat_command @owner_or_editor

hb_test_drop_target :: proc(player: Player) {
    if !#alive(player) {
        return;
    }

    player.weapon_target = null;
    player.ui_test_restore_weapon_target_at = get_time() + 2.0;
    Save.set_int(player, "ui_test_health_bar_target_restored", 0);
} @chat_command @owner_or_editor

vip_test_grant :: proc(player: Player) {
    player.has_vip = true;
    Save.set_int(player, VIP_SAVE_KEY, 1);
    current := Economy.get_balance(player, "Coins");
    if current < 100 {
        Economy.deposit_currency(player, "Coins", 100 - current);
    } else if current > 100 {
        Economy.withdraw_currency(player, "Coins", current - 100);
    }
} @chat_command @owner_or_editor

