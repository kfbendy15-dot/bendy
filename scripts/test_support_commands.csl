backrooms_monster_test_touch :: proc(player: Player) {
    if player == null {
        return;
    }

    target: Player;
    for other: component_iterator(Player) {
        if other != null && other != player {
            target = other;
            break;
        }
    }
    if target == null {
        Save.set_int(player, "ui_test_backrooms_monster_invulnerable", 0);
        Save.set_int(player, "ui_test_backrooms_monster_touch_kill", 0);
        return;
    }

    troll_do_backrooms_monster(player);
    weapon_target_apply_damage(player.weapon_target, player.weapon_target.max_health + 1000.0, 0);
    invulnerable := player.weapon_target.health == player.weapon_target.max_health;

    target.entity.set_local_position(player.entity.local_position);
    target.entity.mark_teleported();
    backrooms_monster_tick(player, 0.1);
    killed := target.weapon_target != null && target.weapon_target.health <= 0;

    Save.set_int(player, "ui_test_backrooms_monster_invulnerable", invulnerable ? 1 : 0);
    Save.set_int(player, "ui_test_backrooms_monster_touch_kill", killed ? 1 : 0);
    troll_do_unmorph(player);
} @chat_command @owner_or_editor

