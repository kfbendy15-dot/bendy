admin_shop_test_buy_new_items :: proc(player: Player) {
    if player == null {
        return;
    }

    buy_weapon_offer(player, .BUBBLE_GUN, 95, "+Bubble Gun");
    buy_weapon_offer(player, .FLASHBANG, 85, "+Flashbang");
    buy_weapon_offer(player, .GRENADE_GUN, 110, "+Grenade Gun");
    buy_weapon_offer(player, .SHURIKEN, 250, "+Shuriken");
    buy_weapon_offer(player, .FIREBALL, 350, "+Fireball");
    buy_weapon_offer(player, .METEORITE, 500, "+Meteorite");
    buy_weapon_offer(player, .SPOON, 1000, "+Spoon");
    buy_weapon_offer(player, .KILLER_FISH, 2000, "+Killer Fish");
    buy_weapon_offer(player, .GIANT_GUN, giant_gun_admin_cost(player), "+Giant Gun");
} @chat_command @owner_or_editor

normal_shop_test_buy_support_items :: proc(player: Player) {
    if player == null {
        return;
    }

    current := Economy.get_balance(player, "Coins");
    if current < 1000 {
        Economy.deposit_currency(player, "Coins", 1000 - current);
    }
    save_coin_balance(player);

    buy_armor_offer(player);
    buy_heal_offer(player);
} @chat_command @owner_or_editor

prepare_normal_shop_test :: proc(player: Player) {
    if player == null {
        return;
    }

    current := Economy.get_balance(player, "Coins");
    if current < 1000 {
        Economy.deposit_currency(player, "Coins", 1000 - current);
    } else if current > 1000 {
        Economy.withdraw_currency(player, "Coins", current - 1000);
    }

    if player.weapon_target != null {
        player.weapon_target.max_health = PLAYER_MAX_HEALTH;
        player.weapon_target.health = 60.0;
    }
    player.armor_bonus_health = 0;
    player.show_shop = true;
    save_coin_balance(player);
    Save.set_int(player, "ui_test_show_shop", 1);
    Save.set_int(player, "ui_test_current_health", 60);
    Save.set_int(player, "ui_test_armor_health", PLAYER_MAX_HEALTH.(s64));
} @chat_command @owner_or_editor

admin_shop_test_grant_new_items :: proc(player: Player) {
    if player == null {
        return;
    }

    grant_weapon_with_ammo(player, .FLASHBANG, 0);
    grant_weapon_with_ammo(player, .GRENADE_GUN, 0);
    grant_weapon_with_ammo(player, .INVISIBLE_GUN_ADMIN, 0);
    grant_weapon_with_ammo(player, .BATTLEPASS_GUN, 0);
    grant_weapon_with_ammo(player, .SHURIKEN, get_weapon_config(.SHURIKEN).ammo_first_pickup);
    grant_weapon_with_ammo(player, .FIREBALL, get_weapon_config(.FIREBALL).ammo_first_pickup);
    grant_weapon_with_ammo(player, .METEORITE, get_weapon_config(.METEORITE).ammo_first_pickup);
    grant_weapon_with_ammo(player, .SPOON, 0);
    grant_weapon_with_ammo(player, .KILLER_FISH, 0);
    grant_weapon_with_ammo(player, .GIANT_GUN, 1);
    apply_armor_bonus(player, ARMOR_BONUS_HP);
    fully_heal_player(player);
} @chat_command @owner_or_editor

