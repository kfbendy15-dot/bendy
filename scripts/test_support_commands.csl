    Save.set_int(player, "ui_test_map_grass", 1);
    set_admin_map_destination(player, "sand", {0, -14}, "Sand Map");
    Save.set_int(player, "ui_test_map_sand", 1);
    set_admin_map_destination(player, "lava", {24, -14}, "Lava Map");
    Save.set_int(player, "ui_test_map_lava", 1);
    set_admin_map_destination(player, "ice", {0, 14}, "Ice Map");
