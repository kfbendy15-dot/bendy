Bear_Trap_Ability :: class : Ability_Base {
    on_init :: method() { name = "Bear Trap"; }
    can_use :: method() -> bool { return player.(Player).equipped_weapon_type == .BEAR_TRAP; }
    on_update :: method(params: ref Ability_Update_Params) {
        if !params.clicked || !params.can_use { return; }
        current_cooldown = 5;
        p := player.(Player); e := Scene.create_entity(); e.set_world_position(p.entity.world_position);
        e.add_component(Bear_Trap, on_before_start=proc(t: Bear_Trap) { t.owner_user_id = p.get_user_id(); });
        adventure_sound(e); Tutorial.report_ability_used(this);
    }
}
