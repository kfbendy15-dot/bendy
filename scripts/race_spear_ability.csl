Race_Spear_Ability :: class : Ability_Base {
    on_init :: method() { name = "Spear"; is_aimed_ability = true; }
    can_use :: method() -> bool { return g_event_peace_race && get_time() >= g_race_starts_at; }
    on_update :: method(params: ref Ability_Update_Params) {
        a := control_targeted_aiming(player, this, ref params);
        if !a.activate { return; }
        current_cooldown = 5;
        p := player.(Player); e := Scene.create_entity(); e.set_world_position(p.entity.world_position + a.direction);
        e.set_local_rotation(to_degrees(atan2(a.direction.y, a.direction.x)));
        e.add_component(Race_Spear, on_before_start=proc(s: Race_Spear) { s.owner_user_id = p.get_user_id(); s.direction = a.direction; });
        adventure_sound(player.entity); Tutorial.report_ability_used(this);
    }
}
